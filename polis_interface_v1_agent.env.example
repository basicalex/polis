# Polis Interface v1 - root .env.agent.example
# Purpose: give an autonomous implementation agent one complete configuration contract.
# Rule: commit this as .env.example only. Never commit a filled production .env.
# Rule: for local v1, MOCK_EXTERNALS=true is acceptable. For production, replace all CHANGE_ME values.

################################################################################
# 00. Runtime identity
################################################################################
APP_ENV=local
NODE_ENV=development
PYTHON_ENV=development
DEPLOYMENT_TIER=local
MOCK_EXTERNALS=true
PROJECT_NAME=Polis Interface
PROJECT_SLUG=polis-interface
PROJECT_NAMESPACE=intrface
RELEASE_VERSION=0.1.0-v1
GIT_SHA=dev
BUILD_ID=dev-local
TIMEZONE=Europe/Zagreb
DEFAULT_LOCALE=en
SUPPORTED_LOCALES=en,hr
PRIMARY_REGION=eu-central
DATA_RESIDENCY=EU
SOVEREIGN_MODE=true
ALLOW_NON_EU_PROCESSING=false

################################################################################
# 01. Public client-exposed variables for Astro/UI
# Only PUBLIC_* may be exposed to browser-side code.
################################################################################
PUBLIC_APP_NAME=Polis Interface
PUBLIC_SITE_URL=http://localhost:4321
PUBLIC_API_BASE_URL=http://localhost:8080
PUBLIC_VERIFIER_URL=http://localhost:4322
PUBLIC_VAULT_URL=http://localhost:4323
PUBLIC_POLIS_BASE_URL=http://localhost:5000
PUBLIC_SOURCE_REPO_URL=https://github.com/intrface/polis-interface
PUBLIC_DOCS_URL=http://localhost:4321/docs
PUBLIC_STATUS_URL=http://localhost:4321/status
PUBLIC_CONTACT_EMAIL=team@intrface.eu
PUBLIC_SECURITY_EMAIL=security@intrface.eu
PUBLIC_LICENSE_CODE=AGPL-3.0-or-later
PUBLIC_LICENSE_DATA=CC-BY-4.0
PUBLIC_DEFAULT_JURISDICTION=EU
PUBLIC_DEFAULT_COUNTRY=HR
PUBLIC_DEFAULT_MUNICIPALITY=local-demo
PUBLIC_ENABLE_GOVERNANCE_GRAPH=true
PUBLIC_ENABLE_POLIS=true
PUBLIC_ENABLE_AI_ASSISTANT=true
PUBLIC_ENABLE_DOCUMENT_VAULT=true
PUBLIC_ENABLE_PROOF_VERIFIER=true
PUBLIC_ENABLE_REWARDS=true
PUBLIC_ENABLE_EXPOSURE_ENGINE=true
PUBLIC_ENABLE_PUBLIC_AUDIT=true
PUBLIC_ENABLE_GITHUB_CONTRIBUTIONS=true
PUBLIC_ANALYTICS_ENABLED=false
PUBLIC_ANALYTICS_PROVIDER=none
PUBLIC_GA_TRACKING_ID=

################################################################################
# 02. Service ports and internal URLs
################################################################################
WEB_PORT=4321
VERIFIER_WEB_PORT=4322
VAULT_WEB_PORT=4323
ADMIN_WEB_PORT=4324
DOCS_WEB_PORT=4325
PLATFORM_API_PORT=8080
GOVERNANCE_GRAPH_API_PORT=8100
POLIS_ADAPTER_PORT=8110
AI_ORCHESTRATOR_PORT=8200
ASSESSMENT_ENGINE_PORT=8300
EXPOSURE_ENGINE_PORT=8310
DOCUMENT_INGESTION_PORT=8400
PAPERLESS_ADAPTER_PORT=8401
DOCUMENT_PROOF_PORT=8410
VERIFIER_API_PORT=8420
VC_ISSUER_PORT=8430
ANCHOR_SERVICE_PORT=8440
REWARD_SERVICE_PORT=8500
AUDIT_SERVICE_PORT=8600
NOTIFICATION_SERVICE_PORT=8700
SEARCH_SERVICE_PORT=8800
OPA_PORT=8181

WEB_INTERNAL_URL=http://web:4321
PLATFORM_API_URL=http://platform-api:8080
GOVERNANCE_GRAPH_API_URL=http://governance-graph-api:8100
POLIS_ADAPTER_URL=http://polis-adapter:8110
AI_ORCHESTRATOR_URL=http://ai-orchestrator:8200
ASSESSMENT_ENGINE_URL=http://assessment-engine:8300
EXPOSURE_ENGINE_URL=http://exposure-engine:8310
DOCUMENT_INGESTION_URL=http://document-ingestion-gateway:8400
PAPERLESS_ADAPTER_URL=http://paperless-adapter:8401
DOCUMENT_PROOF_URL=http://document-proof-service:8410
VERIFIER_API_URL=http://verifier-api:8420
VC_ISSUER_URL=http://vc-issuer-service:8430
ANCHOR_SERVICE_URL=http://anchor-service:8440
REWARD_SERVICE_URL=http://reward-service:8500
AUDIT_SERVICE_URL=http://audit-service:8600
NOTIFICATION_SERVICE_URL=http://notification-service:8700
SEARCH_SERVICE_URL=http://search-service:8800
OPA_URL=http://opa:8181

################################################################################
# 03. HTTP, proxy, cookies, CORS, and rate limiting
################################################################################
TRUST_PROXY=false
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
SESSION_COOKIE_NAME=pi_session
SESSION_TTL_SECONDS=604800
CORS_ORIGINS=http://localhost:4321,http://localhost:4322,http://localhost:4323,http://localhost:5000,http://localhost:8000
CORS_ALLOW_CREDENTIALS=true
CSRF_ENABLED=true
CSRF_SECRET=CHANGE_ME_64_BYTES_BASE64
INTERNAL_API_TOKEN=CHANGE_ME_INTERNAL_SERVICE_TOKEN
HEALTHCHECK_TOKEN=CHANGE_ME_HEALTHCHECK_TOKEN
RATE_LIMIT_ENABLED=true
RATE_LIMIT_GLOBAL_PER_MINUTE=600
RATE_LIMIT_AUTH_PER_MINUTE=60
RATE_LIMIT_AI_PER_MINUTE=60
RATE_LIMIT_UPLOADS_PER_HOUR=100
MAX_REQUEST_BODY_MB=100
MAX_UPLOAD_MB=100

################################################################################
# 04. Core PostgreSQL and pgvector
################################################################################
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_SUPERUSER_PASSWORD
POSTGRES_SSL=false

CORE_DB_NAME=polis_core
CORE_DB_USER=polis_core
CORE_DB_PASSWORD=CHANGE_ME_CORE_DB_PASSWORD
DATABASE_URL=postgresql://polis_core:CHANGE_ME_CORE_DB_PASSWORD@postgres:5432/polis_core
CORE_DATABASE_URL=postgresql://polis_core:CHANGE_ME_CORE_DB_PASSWORD@postgres:5432/polis_core
CORE_DATABASE_POOL_SIZE=20
CORE_DATABASE_STATEMENT_TIMEOUT_MS=30000
CORE_DATABASE_MIGRATIONS_AUTO_RUN=true
CORE_DATABASE_LOG_QUERIES=false
READ_ONLY_DATABASE_URL=
TEST_DATABASE_URL=postgresql://polis_core:CHANGE_ME_CORE_DB_PASSWORD@postgres:5432/polis_core_test

PGVECTOR_ENABLED=true
VECTOR_DATABASE_URL=postgresql://polis_core:CHANGE_ME_CORE_DB_PASSWORD@postgres:5432/polis_core
VECTOR_SCHEMA=public
VECTOR_TABLE_PREFIX=pi_
VECTOR_INDEX_TYPE=hnsw
VECTOR_EMBEDDING_DIMENSIONS=1536

################################################################################
# 05. Redis, queues, and event bus
################################################################################
REDIS_URL=redis://redis:6379/0
CACHE_REDIS_URL=redis://redis:6379/1
QUEUE_REDIS_URL=redis://redis:6379/2
RATE_LIMIT_REDIS_URL=redis://redis:6379/3
REDIS_TLS=false
CACHE_DEFAULT_TTL_SECONDS=3600
QUEUE_PROVIDER=redis
EVENT_BUS_PROVIDER=nats
NATS_URL=nats://nats:4222
NATS_USER=
NATS_PASSWORD=
NATS_JETSTREAM_ENABLED=true
NATS_STREAM_PREFIX=pi
JOB_WORKER_CONCURRENCY=4
JOB_RETRY_MAX_ATTEMPTS=5
JOB_RETRY_BACKOFF_MS=5000

################################################################################
# 06. Object storage / evidence vault / document storage
################################################################################
OBJECT_STORAGE_PROVIDER=s3
S3_ENDPOINT=http://minio:9000
S3_REGION=eu-central-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=CHANGE_ME_MINIO_PASSWORD
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BUCKET=polis-public
S3_PRIVATE_BUCKET=polis-private
S3_EVIDENCE_BUCKET=polis-evidence
S3_DOCUMENTS_BUCKET=polis-documents
S3_PROOFS_BUCKET=polis-proofs
S3_EXPORTS_BUCKET=polis-exports
S3_BACKUPS_BUCKET=polis-backups
S3_TEMP_BUCKET=polis-temp
S3_SIGNED_URL_TTL_SECONDS=900
OBJECT_STORAGE_ENCRYPTION=sse-s3
OBJECT_STORAGE_KMS_KEY_ID=
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_PASSWORD
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=CHANGE_ME_MINIO_PASSWORD
AWS_S3_ENDPOINT=http://minio:9000

################################################################################
# 07. Secrets, encryption, KMS, Vault
################################################################################
SECRETS_PROVIDER=env
KMS_PROVIDER=local
MASTER_ENCRYPTION_KEY_BASE64=CHANGE_ME_32_BYTES_BASE64
FIELD_ENCRYPTION_KEY_BASE64=CHANGE_ME_32_BYTES_BASE64
DOCUMENT_ENCRYPTION_MODE=app_envelope
