{
  "name": "polis-interface",
  "version": "0.1.0-v1",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=4 build",
    "test": "pnpm -r --workspace-concurrency=4 test",
    "typecheck": "pnpm -r --workspace-concurrency=4 typecheck",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "verify": "pnpm build && pnpm typecheck && pnpm test && pnpm v1:smoke",
    "dev:web": "pnpm --filter @polis/apps-web dev -- --host 0.0.0.0",
    "dev:verifier": "pnpm --filter @polis/apps-verifier dev -- --host 0.0.0.0",
    "dev:services": "node scripts/dev-services.mjs",
    "v1:smoke": "node scripts/v1-smoke.mjs",
    "db:generate": "pnpm --filter @polis/db db:generate",
    "db:seed": "pnpm --filter @polis/db seed"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@eslint/js": "^9.18.0",
    "@types/node": "^24.10.1",
    "astro": "^5.15.0",
    "eslint": "^9.18.0",
    "globals": "^15.14.1",
    "prettier": "^3.4.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.20.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}
