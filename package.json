{
  "name": "polis-interface",
  "description": "Local v1 civic infrastructure for source-linked governance maps, public audit trails, and proof-oriented transition pilots.",
  "version": "0.1.0-v1",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "build": "bun run --filter @polis/domain build && bun run --filter @polis/db build && bun run --filter @polis/service-runtime build && bun run --filter @polis/policy-rules build && bun run --filter './services/*' --sequential --if-present build && bun run --filter './apps/*' --sequential --if-present build",
    "test": "bun run --workspaces --sequential --if-present test",
    "typecheck": "bun run --workspaces --sequential --if-present typecheck",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "verify": "bun run build && bun run typecheck && bun run test && bun run v1:smoke",
    "dev:web": "bun run --filter @polis/apps-web dev -- --host 0.0.0.0",
    "dev:verifier": "bun run --filter @polis/apps-verifier dev -- --host 0.0.0.0",
    "dev:services": "bun scripts/dev-services.mjs",
    "v1:smoke": "bun scripts/v1-smoke.mjs",
    "db:generate": "bun run --filter @polis/db db:generate",
    "db:seed": "bun run --filter @polis/db seed",
    "ops:backup": "bash scripts/ops/backup.sh",
    "ops:restore-verify": "bash scripts/ops/restore-verify.sh",
    "ops:verify-audit": "node scripts/ops/verify-audit-chain.mjs",
    "ops:test": "bash scripts/ops/test-backup-restore.sh"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@eslint/js": "^9.18.0",
    "@types/node": "^24.10.1",
    "astro": "^5.15.0",
    "eslint": "^9.18.0",
    "globals": "^15.14.1",
    "prettier": "^3.4.2",
    "ts7": "npm:typescript@7.0.1-rc",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.20.0"
  },
  "trustedDependencies": [
    "esbuild",
    "sharp"
  ],
  "dependencies": {
    "zod": "^4.4.3"
  }
}
