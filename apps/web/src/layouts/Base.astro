---
import '../styles.css';

const { title = 'Polis Interface', description = 'Local v1 civic infrastructure for source-linked governance maps, public audit trails, and proof-oriented transition pilots.' } = Astro.props;
const apiUrl = import.meta.env.PUBLIC_API_URL ?? 'http://localhost:8080';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <div class="site-shell">
      <div class="demo-banner" role="note">Demonstration environment — seeded data; no live integrations.</div>
      <header class="site-header">
        <a class="site-brand" href="/">Polis Interface</a>
        <nav class="site-nav" aria-label="Primary">
          <a href="/governance/jur-croatia-local">Governance</a>
          <a href="/issues">Issues</a>
          <a href="/deliberate">Deliberate</a>
          <a href="/audit">Audit</a>
          <a href="/verify">Verify</a>
          <a href="/assistant">Assistant</a>
          <a href="/docs">Docs</a>
          <a href="/source">Source</a>
          <a href="/methodology">Methodology</a>
          <a href="/transparency">Transparency</a>
          <a href="/privacy">Privacy</a>
          <span id="auth-nav"></span>
        </nav>
      </header>
      <main class="site-main"><slot /></main>
      <footer class="site-footer" id="site-footer">
        Source: https://github.com/basicalex/polis · AGPL-3.0-or-later · <span id="version-meta">version unavailable</span>
        <script is:inline define:vars={{ apiUrl }}>
          const target = document.getElementById('version-meta');
          fetch(apiUrl + '/version')
            .then((r) => (r.ok ? r.json() : null))
            .then((v) => {
              if (!v) return;
              const meta = [
                v.version ? 'v' + v.version : '',
                v.gitSha ? 'git ' + v.gitSha : '',
                v.buildTime ? 'built ' + v.buildTime : '',
                v.environment ? v.environment : '',
              ]
                .filter(Boolean)
                .join(' · ');
              if (target && meta) target.textContent = meta;
            })
            .catch(() => {
              /* offline/API down: keep static label */
            });
        </script>
      </footer>
    </div>
    <script is:inline define:vars={{ apiUrl }}>
      window.__API_URL = apiUrl;
      const s = sessionStorage.getItem('web_session');
      const n = document.getElementById('auth-nav');
      if (n) n.innerHTML = s ? '<a href="/mandate-holders">Mandate-holders</a> · <a href="#" onclick="sessionStorage.removeItem(\'web_session\');location.reload()">Logout</a>' : '<a href="/login">Login</a>';
    </script>
  </body>
</html>
