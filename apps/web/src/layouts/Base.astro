---
import '../styles.css';
import '../styles/chrome.css';
import DemoBadge from '@polis/ui/astro/DemoBadge.astro';
import {
  directionContract,
  releaseBanner,
  releaseBannerDetails,
  statusLabels,
  type Lang,
} from '../content/public-release';

interface Props {
  title?: string;
  description?: string;
  lang?: Lang;
  /**
   * Which chrome the page wants around its content.
   *
   * `'site'` (default) is every ordinary page: boundary banner or demo badge, site header with the
   * primary navigation, main, footer.
   *
   * `'demo'` is for `/demo/*` pages, which render their own app bar and their own single boundary
   * line through `DemoShell`. It suppresses the release boundary banner, the `DemoBadge`, and the
   * site header so the boundary and the navigation are each stated exactly once. The skip link,
   * head, main, and footer are unchanged. `DemoShell` does not set this — the page passes it.
   */
  chrome?: 'site' | 'demo';
}

const {
  title = 'Polis Interface',
  description = 'Follow one synthetic public response from community voice to an independently reviewed receipt.',
  lang = 'en',
  chrome = 'site',
} = Astro.props as Props;
const demoChrome = chrome === 'demo';
const publicRelease = import.meta.env.PUBLIC_RELEASE === '1';
const presenter = Astro.url.searchParams.get('present') === '1';
const apiUrl = import.meta.env.PUBLIC_API_URL ?? 'http://localhost:8080';
const homeHref = lang === 'hr' ? '/hr/' : '/';
const presentationHref = lang === 'hr' ? '/hr/presentation' : '/presentation';
const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const onPresentation = currentPath === '/presentation' || currentPath === '/hr/presentation';
const otherLanguageHref = onPresentation
  ? lang === 'hr'
    ? '/presentation'
    : '/hr/presentation'
  : lang === 'hr'
    ? '/'
    : '/hr/';
const presentHref = `${presentationHref}?present=1`;
const releaseNavigation = {
  en: {
    primary: 'Public release',
    boundary: 'Release boundary',
    presentation: 'Presentation',
    transparency: 'Transparency',
    source: 'Source',
    language: 'Hrvatski',
    present: 'Present',
    skip: 'Skip to content',
    more: 'More',
  },
  hr: {
    primary: 'Javno izdanje',
    boundary: 'Granica izdanja',
    presentation: 'Prezentacija',
    transparency: 'Transparentnost',
    source: 'Izvor',
    language: 'English',
    present: 'Izlaganje',
    skip: 'Preskoči na sadržaj',
    more: 'Dalje',
  },
}[lang];

/*
 * Local demonstrator navigation. Thirteen flat links became four groups so a
 * reader chooses a subject before a destination (rules I2, S3). Each item
 * carries one line saying what the page does; the group holding the current
 * page and the current page itself are marked by weight, not colour (P4).
 */
const localNavGroups = [
  {
    id: 'record',
    label: 'Record',
    items: [
      { href: '/issues', label: 'Issues', note: 'Public problems under deliberation' },
      { href: '/complaints', label: 'Complaints', note: 'Your own casework, kept private' },
      { href: '/deliberate', label: 'Deliberate', note: 'Conversations that feed an issue' },
      {
        href: '/governance/jur-croatia-local',
        label: 'Governance',
        note: 'Which office answers for what',
      },
      { href: '/assistant', label: 'Assistant', note: 'Drafting help with cited sources' },
    ],
  },
  {
    id: 'trust',
    label: 'Trust',
    items: [
      { href: '/verify', label: 'Verify', note: 'Check a file against a registered digest' },
      { href: '/proofs', label: 'Proofs', note: 'Receipts and the proofs behind them' },
      { href: '/audit', label: 'Audit', note: 'The append-only event trail' },
      { href: '/transparency', label: 'Transparency', note: 'What this build does and does not do' },
    ],
  },
  {
    id: 'learn',
    label: 'Learn',
    items: [
      { href: '/docs', label: 'Docs', note: 'How the platform is put together' },
      { href: '/methodology', label: 'Methodology', note: 'How evidence and review work' },
      { href: '/source', label: 'Source', note: 'Repository, licence, and build' },
      { href: '/privacy', label: 'Privacy', note: 'What is stored and what stays private' },
    ],
  },
];

const isCurrentPath = (href: string) =>
  currentPath === href || currentPath.startsWith(`${href}/`);
---

<html
  lang={lang}
  data-theme={publicRelease ? 'light' : 'dark'}
  data-release={publicRelease ? 'public' : 'local'}
  data-presenter={publicRelease && presenter ? 'true' : undefined}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body><Fragment set:html={`<!-- direction-contract\n${directionContract}\n-->`} />
    <a class="skip-link" href="#main-content">{publicRelease ? releaseNavigation.skip : 'Skip to content'}</a>
    <div class:list={['site-shell', { 'site-shell--presenter': publicRelease && presenter }]}>
      {
        demoChrome ? null : publicRelease ? (
          <aside class="release-boundary-banner" aria-label={releaseNavigation.boundary}>
            <p>
              {releaseBanner[lang]}{' '}
              <a href="/transparency">{releaseBannerDetails[lang]}</a>
            </p>
          </aside>
        ) : (
          <DemoBadge banner label="Demo — synthetic data, development proof keys." />
        )
      }

      {!demoChrome && (
      <header class="site-header site-header--chrome">
        <a class="site-brand" href={homeHref}>Polis</a>
        {
          publicRelease ? (
            <div class="release-nav-shell">
              <nav class="site-nav release-nav" aria-label={releaseNavigation.primary}>
                <a class="nav-link" href={presentationHref} aria-current={onPresentation ? 'page' : undefined}>
                  {releaseNavigation.presentation}
                </a>
                <a class="nav-link" href="/transparency" aria-current={currentPath === '/transparency' ? 'page' : undefined}>
                  {releaseNavigation.transparency}
                </a>
                <a class="nav-link" href="/source" aria-current={currentPath === '/source' ? 'page' : undefined}>
                  {releaseNavigation.source}
                </a>
                <a class="nav-link" href={otherLanguageHref} hreflang={lang === 'hr' ? 'en' : 'hr'}>
                  {releaseNavigation.language}
                </a>
                {!presenter && <a class="nav-link" href={presentHref}>{releaseNavigation.present}</a>}
              </nav>
              <span class="release-nav-overflow" aria-hidden="true">{releaseNavigation.more} →</span>
            </div>
          ) : (
            <details class="nav-root" data-nav-root open>
              <summary class="nav-root-summary">Menu</summary>
              <nav class="site-nav site-nav--groups" aria-label="Primary">
                {localNavGroups.map((group) => (
                  <details
                    class="nav-group"
                    name="polis-nav-group"
                    data-nav-group
                    data-current={group.items.some((item) => isCurrentPath(item.href)) ? 'true' : undefined}
                  >
                    <summary class="nav-group-summary">{group.label}</summary>
                    <div class="nav-menu">
                      {group.items.map((item) => (
                        <a
                          class="nav-item"
                          href={item.href}
                          aria-current={isCurrentPath(item.href) ? 'page' : undefined}
                        >
                          <span class="nav-item-label">{item.label}</span>
                          <span class="nav-item-note">{item.note}</span>
                        </a>
                      ))}
                    </div>
                  </details>
                ))}
                <details
                  class="nav-group"
                  name="polis-nav-group"
                  data-nav-group
                  data-current={isCurrentPath('/login') || isCurrentPath('/mandate-holders') ? 'true' : undefined}
                >
                  <summary class="nav-group-summary">Account</summary>
                  <div class="nav-menu" id="auth-nav">
                    <a class="nav-item" href="/login" aria-current={isCurrentPath('/login') ? 'page' : undefined}>
                      <span class="nav-item-label">Login</span>
                      <span class="nav-item-note">Sign in to file and follow casework</span>
                    </a>
                  </div>
                </details>
              </nav>
            </details>
          )
        }
      </header>
      )}

      <main class="site-main" id="main-content"><slot /></main>

      <footer class="site-footer site-footer--chrome" id="site-footer">
        {
          publicRelease ? (
            <>
              <span class="footer-item footer-label">{statusLabels.demonstrationFixture[lang]}</span>
              <span class="footer-separator" aria-hidden="true">·</span>
              <span class="footer-item footer-label">{statusLabels.notLive[lang]}</span>
              <span class="footer-separator" aria-hidden="true">·</span>
              <span class="footer-item">AGPL-3.0-or-later</span>
              <span class="footer-separator" aria-hidden="true">·</span>
              <span class="footer-item"><a href="/source">{releaseNavigation.source}</a></span>
            </>
          ) : (
            <>
              <span class="footer-item">Source: https://github.com/basicalex/polis</span>
              <span class="footer-separator" aria-hidden="true">·</span>
              <span class="footer-item">AGPL-3.0-or-later</span>
              <span class="footer-separator" aria-hidden="true">·</span>
              <span class="footer-item" id="version-meta">version unavailable</span>
              <script is:inline define:vars={{ apiUrl }}>
                const target = document.getElementById('version-meta');
                fetch(apiUrl + '/version')
                  .then((response) => (response.ok ? response.json() : null))
                  .then((version) => {
                    if (!version) return;
                    const meta = [
                      version.version ? 'v' + version.version : '',
                      version.gitSha ? 'git ' + version.gitSha : '',
                      version.buildTime ? 'built ' + version.buildTime : '',
                      version.environment ? version.environment : '',
                    ]
                      .filter(Boolean)
                      .join(' · ');
                    if (target && meta) target.textContent = meta;
                  })
                  .catch(() => {
                    /* offline/API down: keep static label */
                  });
              </script>
            </>
          )
        }
      </footer>
    </div>

    {
      !publicRelease && !demoChrome && (
        <script is:inline>
          /*
           * Chrome behaviour only: collapse the root disclosure on phones and
           * close an open group on Escape or an outside click. The markup ships
           * expanded so the navigation still works with scripting off.
           */
          (() => {
            const root = document.querySelector('[data-nav-root]');
            if (!root) return;
            const summary = root.querySelector('.nav-root-summary');
            const groups = Array.from(root.querySelectorAll('[data-nav-group]'));
            const phone = window.matchMedia('(max-width: 40rem)');
            const syncRoot = () => {
              root.open = !phone.matches;
            };
            syncRoot();
            phone.addEventListener('change', syncRoot);
            const closeGroups = () => {
              for (const group of groups) group.open = false;
            };
            document.addEventListener('keydown', (event) => {
              if (event.key !== 'Escape') return;
              const openGroup = groups.find((group) => group.open);
              if (openGroup) {
                closeGroups();
                openGroup.querySelector('summary')?.focus();
                return;
              }
              if (phone.matches && root.open) {
                root.open = false;
                summary?.focus();
              }
            });
            document.addEventListener('click', (event) => {
              if (root.contains(event.target)) return;
              closeGroups();
              if (phone.matches) root.open = false;
            });
          })();
        </script>
      )
    }

    {
      !publicRelease && (
        <script is:inline define:vars={{ apiUrl }}>
          window.__API_URL = apiUrl;
          const rawSession = sessionStorage.getItem('web_session');
          const authNav = document.getElementById('auth-nav');
          if (authNav) {
            const path = location.pathname.replace(/\/+$/, '') || '/';
            const item = (href, label, note) => {
              const link = document.createElement('a');
              link.className = 'nav-item';
              link.href = href;
              if (path === href || path.startsWith(href + '/')) link.setAttribute('aria-current', 'page');
              const name = document.createElement('span');
              name.className = 'nav-item-label';
              name.textContent = label;
              const hint = document.createElement('span');
              hint.className = 'nav-item-note';
              hint.textContent = note;
              link.append(name, hint);
              return link;
            };
            if (!rawSession) {
              authNav.replaceChildren(item('/login', 'Login', 'Sign in to file and follow casework'));
            } else {
              const mandateHolders = item(
                '/mandate-holders',
                'Mandate-holders',
                'People holding a public mandate',
              );
              const logout = item('#', 'Logout', 'End this browser session');
              logout.removeAttribute('aria-current');
              logout.addEventListener('click', (event) => {
                event.preventDefault();
                sessionStorage.removeItem('web_session');
                location.reload();
              });
              authNav.replaceChildren(mandateHolders, logout);
            }
          }
        </script>
      )
    }
  </body>
</html>
