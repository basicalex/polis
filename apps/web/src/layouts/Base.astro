import '../styles.css';
import '../styles/chrome.css';
import DemoBadge from '@polis/ui/astro/DemoBadge.astro';
import {
  accountNav,
  footer as footerChrome,
  languageEndonyms,
  languageHomes,
  languageSwitch,
  localBanner,
  localNavGroups,
  menuButton,
  presentationHrefs,
  releaseBanner,
  releaseBannerDetails,
  releaseNav,
  skipLink,
  text,
} from '../content/chrome';
import { directionContract, statusLabels, type Lang } from '../content/public-release';

interface Props {
  title?: string;
  description?: string;
  lang?: Lang;
  /**
   * The Croatian and English addresses of this same page, for `hreflang` and the
   * language switch. Only the landing and the presentation exist in both
   * languages; every other page omits this and the switch falls back to the other
   * language's home.
   */
  alternates?: { hr: string; en: string };
  /**
   * Which chrome the page wants around its content.
   *
   * `'site'` (default) is every ordinary page: boundary banner or demo badge, site header with the
   * primary navigation, main, footer.
   *
   * `'demo'` is for `/demo/*` pages, which render their own app bar and their own single boundary
   * line through `DemoShell`. It suppresses the release boundary banner, the `DemoBadge`, and the
   * site header so the boundary and the navigation are each stated exactly once. The skip link,
   * head, main, and footer are unchanged. `DemoShell` does not set this — the page passes it.
   */
  chrome?: 'site' | 'demo';
}

const {
  title = 'Polis Interface',
  description = 'Follow one synthetic public response from community voice to an independently reviewed receipt.',
  lang = 'en',
  alternates,
  chrome = 'site',
} = Astro.props as Props;
const demoChrome = chrome === 'demo';
const publicRelease = import.meta.env.PUBLIC_RELEASE === '1';
const presenter = Astro.url.searchParams.get('present') === '1';
const apiUrl = import.meta.env.PUBLIC_API_URL ?? 'http://localhost:8080';
const otherLang: Lang = lang === 'hr' ? 'en' : 'hr';
const homeHref = languageHomes[lang];
const presentationHref = presentationHrefs[lang];
const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const onPresentation = currentPath === '/presentation' || currentPath === '/en/presentation';
const languageHrefs = {
  hr: alternates?.hr ?? languageHomes.hr,
  en: alternates?.en ?? languageHomes.en,
};
const otherLanguageHref = languageHrefs[otherLang];
const presentHref = `${presentationHref}?present=1`;

/** Absolute URL for a site-relative path, for the `hreflang` alternates. */
const absolute = (path: string) => new URL(path, Astro.site ?? Astro.url).href;

const accountStrings = {
  login: {
    label: text(accountNav.login.label, lang),
    note: text(accountNav.login.note, lang),
  },
  mandateHolders: {
    label: text(accountNav.mandateHolders.label, lang),
    note: text(accountNav.mandateHolders.note, lang),
  },
  logout: {
    label: text(accountNav.logout.label, lang),
    note: text(accountNav.logout.note, lang),
  },
};
const versionUnavailable = text(footerChrome.versionUnavailable, lang);

const isCurrentPath = (href: string) =>
  currentPath === href || currentPath.startsWith(`${href}/`);
---

<html
  lang={lang}
  data-theme={publicRelease ? 'light' : 'dark'}
  data-release={publicRelease ? 'public' : 'local'}
  data-presenter={publicRelease && presenter ? 'true' : undefined}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {
      alternates && (
        <>
          <link rel="alternate" hreflang="hr" href={absolute(alternates.hr)} />
          <link rel="alternate" hreflang="en" href={absolute(alternates.en)} />
          <link rel="alternate" hreflang="x-default" href={absolute(alternates.hr)} />
        </>
      )
    }
  </head>
  <body><Fragment set:html={`<!-- direction-contract\n${directionContract}\n-->`} />
    <a class="skip-link" href="#main-content">{text(skipLink, lang)}</a>
    <div class:list={['site-shell', { 'site-shell--presenter': publicRelease && presenter }]}>
      {
        demoChrome ? null : publicRelease ? (
          <aside
            class="release-boundary-banner release-banner--chrome"
            aria-label={text(releaseNav.boundary, lang)}
          >
            <div class="site-container">
              <p>
                {releaseBanner[lang]}{' '}
                <a href="/transparency">{releaseBannerDetails[lang]}</a>
              </p>
            </div>
          </aside>
        ) : (
          <DemoBadge banner label={text(localBanner, lang)} />
        )
      }

      {!demoChrome && (
      <header class="site-header site-header--chrome">
        <div class="site-container site-header-inner">
        <a class="site-brand" href={homeHref}>Polis</a>
        {
          publicRelease ? (
            <div class="release-nav-shell">
              <nav class="site-nav release-nav" aria-label={text(releaseNav.primary, lang)}>
                <a class="nav-link" href={presentationHref} aria-current={onPresentation ? 'page' : undefined}>
                  {text(releaseNav.presentation, lang)}
                </a>
                <a class="nav-link" href="/transparency" aria-current={currentPath === '/transparency' ? 'page' : undefined}>
                  {text(releaseNav.transparency, lang)}
                </a>
                <a class="nav-link" href="/source" aria-current={currentPath === '/source' ? 'page' : undefined}>
                  {text(releaseNav.source, lang)}
                </a>
                <a class="nav-link" href={otherLanguageHref} hreflang={otherLang} lang={otherLang}>
                  {languageEndonyms[otherLang]}
                </a>
                {!presenter && <a class="nav-link" href={presentHref}>{text(releaseNav.present, lang)}</a>}
              </nav>
              <span class="release-nav-overflow" aria-hidden="true">{text(releaseNav.more, lang)} →</span>
            </div>
          ) : (
            <details class="nav-root" data-nav-root open>
              <summary class="nav-root-summary">{text(menuButton, lang)}</summary>
              <nav class="site-nav site-nav--groups" aria-label={text(releaseNav.primary, lang)}>
                {localNavGroups.map((group) => (
                  <details
                    class="nav-group"
                    name="polis-nav-group"
                    data-nav-group
                    data-current={group.items.some((item) => isCurrentPath(item.href)) ? 'true' : undefined}
                  >
                    <summary class="nav-group-summary">{text(group.label, lang)}</summary>
                    <div class="nav-menu">
                      {group.items.map((item) => (
                        <a
                          class="nav-item"
                          href={item.href}
                          aria-current={isCurrentPath(item.href) ? 'page' : undefined}
                        >
                          <span class="nav-item-label">{text(item.label, lang)}</span>
                          <span class="nav-item-note">{text(item.note, lang)}</span>
                        </a>
                      ))}
                    </div>
                  </details>
                ))}
                <details
                  class="nav-group"
                  name="polis-nav-group"
                  data-nav-group
                  data-current={isCurrentPath('/login') || isCurrentPath('/mandate-holders') ? 'true' : undefined}
                >
                  <summary class="nav-group-summary">{text(accountNav.label, lang)}</summary>
                  <div class="nav-menu" id="auth-nav">
                    <a class="nav-item" href={accountNav.login.href} aria-current={isCurrentPath('/login') ? 'page' : undefined}>
                      <span class="nav-item-label">{accountStrings.login.label}</span>
                      <span class="nav-item-note">{accountStrings.login.note}</span>
                    </a>
                  </div>
                </details>
              </nav>
            </details>
          )
        }
        </div>
      </header>
      )}

      <main class="site-main" id="main-content"><slot /></main>

      <footer class="site-footer site-footer--chrome" id="site-footer">
        <div class="site-container site-footer-inner">
          <div class="footer-brand">
            <span class="footer-wordmark">Polis</span>
            <p class="footer-blurb">{text(footerChrome.blurb, lang)}</p>
          </div>

          <nav class="footer-nav" aria-label={text(footerChrome.navLabel, lang)}>
            {footerChrome.groups.map((group) => (
              <div class="footer-column">
                <h2 class="footer-heading">{text(group.label, lang)}</h2>
                <ul class="footer-links">
                  {group.links.map((link) => (
                    <li>
                      <a
                        href={link.href[lang]}
                        rel={link.external ? 'noreferrer' : undefined}
                      >
                        {text(link.label, lang)}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))}

            <div class="footer-column">
              <h2 class="footer-heading">{text(languageSwitch, lang)}</h2>
              <ul class="footer-links">
                <li>
                  <a href={languageHrefs.hr} hreflang="hr" lang="hr" aria-current={lang === 'hr' ? 'true' : undefined}>
                    {languageEndonyms.hr}
                  </a>
                </li>
                <li>
                  <a href={languageHrefs.en} hreflang="en" lang="en" aria-current={lang === 'en' ? 'true' : undefined}>
                    {languageEndonyms.en}
                  </a>
                </li>
              </ul>
            </div>
          </nav>

          <div class="footer-bottom">
            {
              publicRelease ? (
                <>
                  <span class="footer-item footer-label">{statusLabels.demonstrationFixture[lang]}</span>
                  <span class="footer-separator" aria-hidden="true">·</span>
                  <span class="footer-item footer-label">{statusLabels.notLive[lang]}</span>
                </>
              ) : (
                <>
                  <span class="footer-item" id="version-meta">{versionUnavailable}</span>
                  <script is:inline define:vars={{ apiUrl }}>
                    const target = document.getElementById('version-meta');
                    fetch(apiUrl + '/version')
                      .then((response) => (response.ok ? response.json() : null))
                      .then((version) => {
                        if (!version) return;
                        const meta = [
                          version.version ? 'v' + version.version : '',
                          version.gitSha ? 'git ' + version.gitSha : '',
                          version.buildTime ? 'built ' + version.buildTime : '',
                          version.environment ? version.environment : '',
                        ]
                          .filter(Boolean)
                          .join(' · ');
                        if (target && meta) target.textContent = meta;
                      })
                      .catch(() => {
                        /* offline/API down: keep static label */
                      });
                  </script>
                </>
              )
            }
          </div>
        </div>
      </footer>
    </div>

    {
      !publicRelease && !demoChrome && (
        <script is:inline>
          /*
           * Chrome behaviour only: collapse the root disclosure on phones and
           * close an open group on Escape or an outside click. The markup ships
           * expanded so the navigation still works with scripting off.
           */
          (() => {
            const root = document.querySelector('[data-nav-root]');
            if (!root) return;
            const summary = root.querySelector('.nav-root-summary');
            const groups = Array.from(root.querySelectorAll('[data-nav-group]'));
            const phone = window.matchMedia('(max-width: 40rem)');
            const syncRoot = () => {
              root.open = !phone.matches;
            };
            syncRoot();
            phone.addEventListener('change', syncRoot);
            const closeGroups = () => {
              for (const group of groups) group.open = false;
            };
            document.addEventListener('keydown', (event) => {
              if (event.key !== 'Escape') return;
              const openGroup = groups.find((group) => group.open);
              if (openGroup) {
                closeGroups();
                openGroup.querySelector('summary')?.focus();
                return;
              }
              if (phone.matches && root.open) {
                root.open = false;
                summary?.focus();
              }
            });
            document.addEventListener('click', (event) => {
              if (root.contains(event.target)) return;
              closeGroups();
              if (phone.matches) root.open = false;
            });
          })();
        </script>
      )
    }

    {
      !publicRelease && (
        <script is:inline define:vars={{ apiUrl, accountStrings }}>
          window.__API_URL = apiUrl;
          const rawSession = sessionStorage.getItem('web_session');
          const authNav = document.getElementById('auth-nav');
          if (authNav) {
            const path = location.pathname.replace(/\/+$/, '') || '/';
            const item = (href, label, note) => {
              const link = document.createElement('a');
              link.className = 'nav-item';
              link.href = href;
              if (path === href || path.startsWith(href + '/')) link.setAttribute('aria-current', 'page');
              const name = document.createElement('span');
              name.className = 'nav-item-label';
              name.textContent = label;
              const hint = document.createElement('span');
              hint.className = 'nav-item-note';
              hint.textContent = note;
              link.append(name, hint);
              return link;
            };
            if (!rawSession) {
              authNav.replaceChildren(
                item('/login', accountStrings.login.label, accountStrings.login.note),
              );
            } else {
              const mandateHolders = item(
                '/mandate-holders',
                accountStrings.mandateHolders.label,
                accountStrings.mandateHolders.note,
              );
              const logout = item('#', accountStrings.logout.label, accountStrings.logout.note);
              logout.removeAttribute('aria-current');
              logout.addEventListener('click', (event) => {
                event.preventDefault();
                sessionStorage.removeItem('web_session');
                location.reload();
              });
              authNav.replaceChildren(mandateHolders, logout);
            }
          }
        </script>
      )
    }
  </body>
</html>
