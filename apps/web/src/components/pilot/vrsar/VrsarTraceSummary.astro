import { stageLabels, type PilotLang } from '../../../content/pilot/vrsar';

interface Props {
  lang: PilotLang;
}

const { lang } = Astro.props as Props;
const stages = ['voice', 'responsibility', 'response', 'check', 'receipt'] as const;
---

<ol class="pilot-trace" data-trace>
  {stages.map((stage) => (
    <li class="pilot-trace-stage" data-stage={stage} data-state="ahead">
      <span class="pilot-trace-marker" aria-hidden="true"></span>
      <div class="pilot-trace-body">
        <p class="pilot-trace-title" data-trace-title>{stageLabels[stage][lang]}</p>
        <p class="pilot-trace-note" data-trace-note></p>
      </div>
    </li>
  ))}
</ol>
