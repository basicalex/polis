import { pilotCopy, translatedOrigin, type PilotLang } from '../../../content/pilot/vrsar';

interface Props {
  origin?: string;
  lang: PilotLang;
}

const { origin = 'unknown', lang } = Astro.props as Props;
const label = translatedOrigin(origin, lang);
---

{/* The channel is a fact about the case, not a state of it: the shared stamp
    recipe at its neutral tone, so it never competes with the status word. */}
<span
  class="status-label"
  data-tone="unknown"
  data-origin={origin}
  aria-label={`${pilotCopy.channel.label[lang]}: ${label}`}
>{label}</span>
