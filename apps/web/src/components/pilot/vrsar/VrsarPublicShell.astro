/**
 * The public case shell: what everyone may read about a case from the moment it
 * is filed.
 *
 * The order on the page is the order a reader needs it in. First the case
 * itself: the number, the state, the area. Then the answer the municipality
 * gave — the promise, its due date, the person who signed it and what the
 * office reported doing — because that is what a reader came for. Then the
 * report as it was written, then the public's check on the completion claim,
 * then the six states of the ledger with the one the case stands in, then the
 * attention counts, and last the verification block: every public event with
 * its hash, the hash before it, and the receipt that covers the chain.
 *
 * Nothing on this page waits for a reviewer: there is none. A text the
 * compliance pass held says so in plain words and names what the office can
 * still do with it.
 */

import { pilotCopy, type PilotLang } from '../../../content/pilot/vrsar';
import { publicCaseCopy } from '../../../content/pilot/vrsar-public-case';
import { findPilotPlace, type LivePlace } from '../../../content/places';
import VrsarAttentionControl from './VrsarAttentionControl.astro';
import VrsarStateStrip from './VrsarStateStrip.astro';

interface Props {
  lang: PilotLang;
  /** The municipality this case belongs to; the page URL names it when it is not passed. */
  place?: LivePlace;
}

const { lang, place } = Astro.props as Props;
const copy = publicCaseCopy.shell;
const report = publicCaseCopy.text;
const removed = publicCaseCopy.removed;
const notice = publicCaseCopy.notice;
const erase = publicCaseCopy.erase;
const holdReasons = publicCaseCopy.holdReason;
const chip = publicCaseCopy.label;
const answer = publicCaseCopy.answer;
const check = publicCaseCopy.check;
const pending = publicCaseCopy.pending;
const strip = publicCaseCopy.stateStrip;
const verification = publicCaseCopy.verification;
const receipts = pilotCopy.receipts;

/*
 * A text held as confidential names the person who takes it instead. The
 * contact belongs to the municipality, so it is read from places.ts: from the
 * place the page passed, or else from the place slug in the address.
 */
const pathPlace = Astro.url.pathname
  .split('/')
  .filter(Boolean)
  .map((segment) => findPilotPlace(segment))
  .find((match) => match !== undefined);
const contact = (place ?? pathPlace ?? findPilotPlace('vrsar'))?.privacy.confidentialContact;
const contactName = contact ? (lang === 'en' ? contact.name.en : contact.name.hr) : undefined;
/** The four reasons a reader may name; the other four belong to the system. */
const noticeReasons = ['personal-data', 'abuse', 'off-topic', 'other'] as const;
---

<div
  class="pilot-page"
  data-public-case
  data-confidential-name={contactName}
  data-confidential-email={contact?.email}
  data-confidential-phone={contact?.phone}
  hidden
>
  <section class="pilot-section panel" aria-labelledby="public-case-title">
    <div class="pilot-public-case-head">
      <h2 id="public-case-title">{copy.heading[lang]}</h2>
      <span class="status-label" data-style="stamp" data-tone="unknown" data-case-state></span>
    </div>

    <dl class="pilot-meta">
      <div>
        <dt>{copy.caseNumber[lang]}</dt>
        <dd class="pilot-ledger-id" data-case-number></dd>
      </div>
      <div>
        <dt>{copy.area[lang]}</dt>
        <dd data-case-area></dd>
      </div>
      <div>
        <dt>{copy.category[lang]}</dt>
        <dd data-case-category></dd>
      </div>
      <div>
        <dt>{copy.time[lang]}</dt>
        <dd data-case-time></dd>
      </div>
    </dl>

    <p class="pilot-state" data-case-closed-reason hidden></p>
  </section>

  <!-- The office's answer: published at once, signed by the person who made it. -->
  <article class="pilot-receipt pilot-answer panel" data-public-receipt hidden>
    <header class="pilot-receipt-header">
      <h2>{answer.heading[lang]}</h2>
      <span class="status-label" data-style="stamp" data-tone="unknown" data-public-state></span>
    </header>

    <div class="pilot-answer-body">
      <section class="pilot-section">
        <h3>{answer.commitment[lang]}</h3>
        <p class="pilot-public-copy" data-public-commitment></p>
      </section>
    </div>

    <dl class="pilot-meta">
      <div>
        <dt>{pilotCopy.common.office[lang]}</dt>
        <dd data-public-office></dd>
      </div>
      <div data-public-unit-row hidden>
        <dt>{answer.unit[lang]}</dt>
        <dd data-public-unit></dd>
      </div>
      <div>
        <dt>{answer.signedBy[lang]}</dt>
        <dd data-public-signed-by></dd>
      </div>
      <div>
        <dt>{answer.dueDate[lang]}</dt>
        <dd data-public-due-date></dd>
      </div>
      <div>
        <dt>{answer.publishedAt[lang]}</dt>
        <dd data-public-published-at></dd>
      </div>
      <div data-public-resolved-at-row hidden>
        <dt>{answer.resolvedAt[lang]}</dt>
        <dd data-public-resolved-at></dd>
      </div>
    </dl>

    <section class="pilot-section" data-public-evidence-section hidden>
      <h3>{answer.doneHeading[lang]}</h3>
      <p class="pilot-public-copy" data-public-evidence-note></p>
      <h4 class="pilot-answer-subhead">{answer.evidenceLinks[lang]}</h4>
      <ul class="pilot-evidence-links" data-public-evidence-links></ul>
    </section>

    <p class="field-hint">{answer.note[lang]}</p>
  </article>

  <!-- What the case is waiting for, in the words of the state it stands in. -->
  <section class="pilot-section panel pilot-pending" data-case-pending hidden aria-labelledby="public-case-pending-title">
    <h2 id="public-case-pending-title">{pending.heading[lang]}</h2>
    <p class="pilot-pending-line" data-case-pending-text></p>
  </section>

  <!--
    A report filed on the web carries no contact, so nothing is sent anywhere:
    this page and the filer's own link are the whole channel.
  -->
  <p class="field-hint pilot-no-contact" data-web-no-contact hidden>{answer.webNoContact[lang]}</p>

  <!--
    The report as it was filed. Public from the first minute; held only when the
    compliance pass found a reason, and then the reason is named here.
  -->
  <section class="pilot-section panel" aria-labelledby="public-case-text-title" data-case-text>
    <div class="pilot-public-case-head">
      <h2 id="public-case-text-title">{report.heading[lang]}</h2>
      <span class="status-label" data-style="stamp" data-tone="restricted" data-text-state hidden></span>
    </div>

    <p class="pilot-public-copy pilot-case-text" data-case-narrative hidden></p>

    <div class="pilot-hold" data-case-hold hidden>
      <h3 class="pilot-answer-subhead">{report.heldHeading[lang]}</h3>
      <p class="pilot-hold-reason" data-case-hold-reason></p>
      <p class="field-hint" data-case-confidential hidden></p>
      <p class="field-hint">{report.heldNext[lang]}</p>
    </div>

    <!-- A removed text. The block stands where a held one would; never both. -->
    <div class="pilot-hold pilot-removed" data-case-removed hidden>
      <h3 class="pilot-answer-subhead">{removed.heading[lang]}</h3>
      <p class="pilot-hold-reason" data-case-removed-reason></p>
      <p class="field-hint">{removed.permanent[lang]}</p>
    </div>

    <p class="field-hint" data-case-redacted hidden></p>

    <dl class="pilot-meta">
      <div>
        <dt>{report.locationLabel[lang]}</dt>
        <dd data-case-location></dd>
      </div>
    </dl>

    <p class="field-hint" data-case-as-filed hidden>{report.asFiled[lang]}</p>

    <div class="pilot-label" data-case-label hidden>
      <p class="pilot-label-head">
        <span class="status-label" data-style="stamp" data-tone="unknown">{chip.formLetter[lang]}</span>
      </p>
      <p class="field-hint">{chip.formLetterNote[lang]}</p>

      <form class="pilot-appeal entry-form" data-label-appeal hidden novalidate>
        <label for="public-case-appeal">{chip.appealLabel[lang]}</label>
        <textarea id="public-case-appeal" name="appeal" rows="3" maxlength="2000" data-appeal-text></textarea>
        <p class="field-hint">{chip.appealHint[lang]}</p>
        <button class="btn" data-variant="secondary" type="submit">{chip.appealSubmit[lang]}</button>
        <p class="pilot-state" role="status" data-appeal-state></p>
      </form>
    </div>

    <!--
      Two controls on the text itself. The reader's report is quiet: it opens
      only when someone wants it. The filer's removal asks twice and says what
      it costs before it takes anything.
    -->
    <details class="pilot-notice" data-case-notice hidden>
      <summary>{notice.open[lang]}</summary>
      <form class="pilot-notice-form entry-form" data-notice-form novalidate>
        <p class="field-hint">{notice.intro[lang]}</p>
        <label for="public-case-notice-reason">{notice.reasonLabel[lang]}</label>
        <select id="public-case-notice-reason" name="reason" data-notice-reason>
          {noticeReasons.map((reason) => <option value={reason}>{holdReasons[reason][lang]}</option>)}
        </select>
        <label for="public-case-notice-note">{notice.noteLabel[lang]}</label>
        <textarea id="public-case-notice-note" name="note" rows="3" maxlength="600" data-notice-note></textarea>
        <button class="btn" data-variant="secondary" type="submit" data-notice-submit>{notice.submit[lang]}</button>
        <p class="pilot-state" role="status" data-notice-state></p>
      </form>
    </details>

    <div class="pilot-erase" data-case-erase hidden>
      <button class="btn" data-variant="secondary" type="button" data-erase-open>{erase.open[lang]}</button>

      <div class="pilot-erase-confirm" data-erase-confirm hidden>
        <h3 class="pilot-answer-subhead">{erase.confirmHeading[lang]}</h3>
        <p class="field-hint">{erase.confirmBody[lang]}</p>
        <div class="pilot-erase-actions">
          <button class="btn" type="button" data-erase-go>{erase.confirm[lang]}</button>
          <button class="btn" data-variant="secondary" type="button" data-erase-cancel>{erase.cancel[lang]}</button>
        </div>
      </div>

      <p class="pilot-state" role="status" data-erase-state></p>
    </div>
  </section>

  <!-- The public's check on the completion claim. -->
  <section class="pilot-section panel" data-case-check hidden aria-labelledby="public-case-check-title">
    <h2 id="public-case-check-title">{check.heading[lang]}</h2>

    <p class="pilot-check-count">
      <span class="pilot-check-label">{check.notFixedCount[lang]}:</span>
      <span class="pilot-check-value" data-not-fixed-count>0</span>
    </p>

    <div data-case-disputes hidden>
      <h3 class="pilot-answer-subhead">{check.disputesHeading[lang]}</h3>
      <ol class="pilot-disputes" data-dispute-list></ol>
    </div>

    <form class="pilot-dispute entry-form" data-dispute-form hidden novalidate>
      <h3 class="pilot-answer-subhead">{check.disputeHeading[lang]}</h3>
      <p class="field-hint">{check.disputeIntro[lang]}</p>
      <label for="public-case-dispute">{check.disputeLabel[lang]}</label>
      <textarea id="public-case-dispute" name="dispute" rows="4" maxlength="4000" data-dispute-text></textarea>
      <button class="btn" type="submit" data-dispute-submit>{check.disputeSubmit[lang]}</button>
      <p class="pilot-state" role="status" data-dispute-state></p>
    </form>
  </section>

  <!-- The six states of the ledger, and the one this case stands in. -->
  <section class="pilot-section panel" aria-labelledby="public-case-trace-title" data-case-trace>
    <h2 id="public-case-trace-title">{strip.heading[lang]}</h2>
    <VrsarStateStrip lang={lang} />
  </section>

  <VrsarAttentionControl lang={lang} />

  <section
    class="pilot-section panel"
    data-public-verification
    hidden
    aria-labelledby="public-case-verification-title"
  >
    <h2 id="public-case-verification-title">{verification.heading[lang]}</h2>
    <p class="field-hint">{verification.note[lang]}</p>

    <h3 class="pilot-answer-subhead">{verification.events[lang]}</h3>
    <ol class="pilot-verify-events" data-public-events></ol>
    <p class="pilot-state" data-public-events-empty hidden>{verification.eventsEmpty[lang]}</p>

    <div class="pilot-receipt-hash">
      <strong>{verification.textHash[lang]}</strong>
      <span class="pilot-hash" data-case-text-hash></span>
    </div>
    <p class="field-hint" data-case-text-hash-legacy hidden>{verification.textHashLegacy[lang]}</p>

    <div class="pilot-receipt-hash" data-last-event-hash-row hidden>
      <strong>{verification.lastEventHash[lang]}</strong>
      <span class="pilot-hash" data-last-event-hash></span>
    </div>

    <div class="pilot-receipt-hash" data-receipt-id-row hidden>
      <strong>{pilotCopy.common.recordId[lang]}</strong>
      <span class="pilot-ledger-id" data-receipt-id></span>
    </div>

    <div class="pilot-receipt-hash" data-receipt-hash-row hidden>
      <strong>{receipts.receiptHash[lang]}</strong>
      <span class="pilot-hash" data-public-hash></span>
    </div>
    <p class="pilot-disclosure-line">{receipts.receiptHashNote[lang]}</p>
  </section>
</div>

<style>
  /*
   * A web filing has no channel back, so the sentence that says so sits right
   * under the answer area rather than inside a block that can be hidden.
   */
  .pilot-no-contact {
    margin: calc(-1 * var(--space-2)) 0 0;
  }
  .pilot-public-case-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2) var(--space-4);
    margin-bottom: var(--space-4);
  }

  .pilot-public-case-head h2 {
    margin: 0;
  }

  /* The report reads as written: line breaks stay, nothing is reflowed. */
  .pilot-case-text {
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .pilot-hold {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-4);
    border-inline-start: 3px solid var(--polis-restricted);
    background: var(--polis-surface-2);
  }

  .pilot-hold-reason {
    margin: 0;
    font-weight: 650;
  }

  /* Removal is not a category of hold, so the rule beside it is neutral. */
  .pilot-removed {
    border-inline-start-color: var(--polis-border-strong);
  }

  /* A reader's report on the text: available, not advertised. */
  .pilot-notice {
    margin-top: var(--space-4);
    padding-top: var(--space-4);
    border-top: 1px solid var(--polis-border);
  }

  .pilot-notice > summary {
    display: flex;
    align-items: center;
    min-height: var(--tap-target);
    color: var(--polis-muted);
    font-size: var(--type-data);
    cursor: pointer;
  }

  .pilot-notice-form {
    display: grid;
    gap: var(--space-2);
    justify-items: start;
    margin-top: var(--space-3);
  }

  .pilot-notice-form select,
  .pilot-notice-form textarea {
    width: 100%;
  }

  .pilot-erase {
    display: grid;
    gap: var(--space-3);
    justify-items: start;
    margin-top: var(--space-4);
  }

  /* The warning is the rule and the words, not a colour and not a modal. */
  .pilot-erase-confirm {
    display: grid;
    gap: var(--space-2);
    width: 100%;
    padding: var(--space-4);
    border-inline-start: 3px solid var(--polis-restricted);
    background: var(--polis-surface-2);
  }

  .pilot-erase-confirm h3 {
    margin: 0;
  }

  .pilot-erase-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .pilot-label {
    display: grid;
    gap: var(--space-2);
    margin-top: var(--space-4);
    padding-top: var(--space-4);
    border-top: 1px solid var(--polis-border);
  }

  .pilot-label-head {
    margin: 0;
  }

  .pilot-appeal,
  .pilot-dispute {
    display: grid;
    gap: var(--space-2);
    justify-items: start;
    margin-top: var(--space-3);
  }

  .pilot-appeal textarea,
  .pilot-dispute textarea {
    width: 100%;
  }

  /* The count is the fact; the label only names it (rule H3). */
  .pilot-check-count {
    margin: 0 0 var(--space-4);
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
  }

  .pilot-check-label {
    color: var(--polis-muted);
    font-size: var(--type-data);
    font-weight: 650;
  }

  .pilot-check-value {
    font-size: var(--type-body-lg);
    font-weight: 650;
    font-variant-numeric: tabular-nums;
  }

  .pilot-disputes {
    display: grid;
    gap: var(--space-3);
    margin: 0 0 var(--space-4);
    padding: 0;
    list-style: none;
  }
</style>

<!-- One dispute is drawn by the script, so its rule cannot be scoped here. -->
<style is:global>
  .pilot-dispute-item {
    display: grid;
    gap: var(--space-1);
    padding-inline-start: var(--space-3);
    border-inline-start: 3px solid var(--polis-border-strong);
  }

  .pilot-dispute-text {
    margin: 0;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .pilot-dispute-date {
    color: var(--polis-muted);
    font-size: var(--type-meta);
  }
</style>
