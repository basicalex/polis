/*
 * S3 · the place ledger.
 *
 * Every case of the place, in every state, newest activity first, with the
 * counts and the clock in one strip above and the case-number search under it
 * (entry-flow R8). It is a ledger, not a dashboard: attention is shown as two
 * counts and the line under the list says a count is not a vote.
 */

import '../../styles/entry.css';
import EmptyState from '@polis/ui/astro/EmptyState.astro';
import { entryStrings } from '../../content/entry';
import { text } from '../../content/chrome';
import type { Lang } from '../../content/public-release';
import type { LivePlace } from '../../content/places';
import { CASE_NUMBER_PATTERN } from '../../content/pilot/vrsar-public-case';

interface Props {
  lang: Lang;
  place: LivePlace;
}

const { lang, place } = Astro.props as Props;
const base = lang === 'hr' ? '/' : '/en/';
const label = (key: keyof typeof entryStrings) => text(entryStrings[key], lang);
const strings = {
  open: label('ledgerOpen'),
  overdue: label('ledgerOverdue'),
  closed: label('ledgerClosed'),
  capped: label('ledgerCapped'),
  searchInvalid: label('ledgerSearchInvalid'),
  filed: label('ledgerFiled'),
  due: label('ledgerDue'),
  followers: label('ledgerFollowers'),
  alsoAffected: label('ledgerAlsoAffected'),
};
const summary = [
  { key: 'open', label: strings.open },
  { key: 'overdue', label: strings.overdue },
  { key: 'closed', label: strings.closed },
] as const;
---

<div
  class="ledger"
  data-ledger
  data-base={base}
  data-place={place.slug}
  data-prefix={place.caseNumberPrefix}
>
  <a class="intent-back" href={`${base}${place.slug}`}>← {place.name[lang]}</a>
  <h1 class="ledger-title">{label('ledgerTitle')}</h1>

  <div class="ledger-summary" data-summary>
    {
      summary.map((item) => (
        <p class="ledger-summary-item">
          <span class="ledger-summary-value" data-count={item.key}>—</span>
          <span class="ledger-summary-label">{item.label}</span>
        </p>
      ))
    }
    <span class="ledger-summary-note" data-capped hidden>{strings.capped}</span>
  </div>

  <!--
    The field validates in script so a wrong number gets the reviewed line
    instead of a browser bubble; the pattern still declares the shape.
  -->
  <form class="ledger-search entry-form" data-ledger-search novalidate>
    <label for="ledger-case-number">{label('ledgerSearchLabel')}</label>
    <div class="entry-form-row">
      <input
        type="text"
        id="ledger-case-number"
        name="caseNumber"
        inputmode="text"
        autocomplete="off"
        spellcheck="false"
        pattern={CASE_NUMBER_PATTERN}
        placeholder={label('ledgerSearchPlaceholder')}
        data-case-input
      />
      <button class="btn" type="submit">{label('ledgerSearchSubmit')}</button>
    </div>
    <p class="field-error" role="alert" data-search-error></p>
  </form>

  <ul class="ledger-list" data-list aria-busy="true" aria-label={label('ledgerTitle')}>
    {
      [0, 1, 2, 3].map(() => (
        <li class="ledger-row ledger-row--skeleton" aria-hidden="true">
          <span class="ledger-skeleton ledger-skeleton--id"></span>
          <span class="ledger-skeleton ledger-skeleton--stamp"></span>
          <span class="ledger-skeleton ledger-skeleton--line"></span>
        </li>
      ))
    }
  </ul>
  <p class="ledger-loading" data-loading>{label('ledgerLoading')}</p>

  <div class="ledger-empty" data-empty hidden>
    <EmptyState
      title={label('ledgerEmpty')}
      purpose={label('ledgerEmptyPurpose')}
      actionLabel={label('report')}
      actionHref={`${base}${place.slug}/prijava`}
      actionVariant="primary"
      lang={lang}
    />
  </div>

  <div class="ledger-failure" data-failure hidden>
    <p class="ledger-failure-line" role="alert">{label('ledgerError')}</p>
    <button class="btn" data-variant="secondary" type="button" data-retry>{label('ledgerRetry')}</button>
  </div>

  <p class="ledger-note">{label('ledgerNotAVote')}</p>

  <script is:inline type="application/json" id="ledger-strings" set:html={JSON.stringify(strings)} />
</div>

<script>
  import '../../scripts/entry/ledger';
</script>
