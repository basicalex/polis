/*
 * S5 · the case number.
 *
 * The last screen of the flow, not a thank-you (entry-flow R10). The number is
 * the thing to keep, so it is the biggest thing on the page; the reopen key
 * sits in this page's own fragment and is copied, never sent. Opened without a
 * fragment — a shared address — the page shows the number and the public record
 * and says nothing about a key it does not have.
 */

import '../../styles/entry.css';
import { entryStrings } from '../../content/entry';
import { text } from '../../content/chrome';
import type { Lang } from '../../content/public-release';
import type { LivePlace } from '../../content/places';

interface Props {
  lang: Lang;
  place: LivePlace;
  caseNumber: string;
}

const { lang, place, caseNumber } = Astro.props as Props;
const base = lang === 'hr' ? '/' : '/en/';
const label = (key: keyof typeof entryStrings) => text(entryStrings[key], lang);
const recordHref = `${base}${place.slug}/zapis/${encodeURIComponent(caseNumber)}`;
const strings = {
  copy: label('copy'),
  copyLink: label('copyLink'),
  copied: label('copied'),
  outcomeConfidentialHeading: label('caseOutcomeConfidentialHeading'),
  outcomeConfidentialNote: label('caseOutcomeConfidentialNote'),
  outcomePendingRelease: label('caseOutcomePendingRelease'),
  outcomePolicy: label('caseOutcomePolicy'),
  outcomeHeld: label('caseOutcomeHeld'),
  outcomeOfficeDecides: label('caseOutcomeOfficeDecides'),
};

/*
 * The confidential officer of this municipality. It rides on the root as plain
 * data so the script never needs a second request to name a person the filer
 * should call, and the lines only appear when the page carries the reopen key.
 */
const confidential = place.privacy.confidentialContact;
---

<div
  class="case-number"
  data-case-number
  data-record-href={recordHref}
  data-case={caseNumber}
  data-confidential-name={confidential.name[lang]}
  data-confidential-email={confidential.email}
  data-confidential-phone={confidential.phone}
>
  <p class="case-number-label">{label('caseNumberTitle')}</p>
  <p class="case-number-value" data-number>{caseNumber}</p>
  <button class="btn" data-variant="secondary" type="button" data-copy-number>{strings.copy}</button>

  <section class="case-number-key" data-key-section hidden aria-labelledby="case-key-title">
    <h2 class="case-number-subtitle" id="case-key-title">{label('caseLinkTitle')}</h2>
    <p class="case-number-link" data-link></p>
    <button class="btn" data-variant="secondary" type="button" data-copy-link>{strings.copyLink}</button>
    <p class="case-number-note">{label('caseKeyNote')}</p>
  </section>

  {/*
    What happened to the text. The height is reserved from the first paint, so
    the answer arrives into a space that is already there and nothing below it
    moves. Public text says nothing here; the block stays empty.
  */}
  <section class="case-number-outcome" data-outcome>
    <div class="case-number-outcome-body" data-outcome-body role="status" aria-live="polite" hidden>
      <h2 class="case-number-subtitle" data-outcome-heading hidden></h2>
      <p class="case-number-note" data-outcome-note></p>
      <ul class="case-number-contact" data-outcome-contact hidden>
        <li data-outcome-contact-name></li>
        <li><a data-outcome-contact-email></a></li>
        <li><a data-outcome-contact-phone></a></li>
      </ul>
    </div>
  </section>

  <div class="case-number-actions">
    <a class="btn" data-variant="primary" href={recordHref} data-record-link>{label('caseOpenRecord')}</a>
    <a class="btn" data-variant="tertiary" href={`${base}${place.slug}`}>{label('caseBackToPlace')}</a>
  </div>

  <script is:inline type="application/json" id="case-number-strings" set:html={JSON.stringify(strings)} />
</div>

<script>
  import '../../scripts/entry/case-number';
</script>
