import ConfidenceBadge from '@polis/ui/astro/ConfidenceBadge.astro';
import ReviewStateBadge from '@polis/ui/astro/ReviewStateBadge.astro';
import SourcePanel from '@polis/ui/astro/SourcePanel.astro';
import AiLabel from '@polis/ui/astro/AiLabel.astro';
import type { ConfidenceState, EvidenceLink, ReviewState } from '@polis/domain';

export interface Props {
  claim: {
    id: string;
    text: string;
    confidenceState: ConfidenceState;
    reviewState: ReviewState;
    evidence: Array<{
      sourceId: string;
      quote: string | null;
      sourceHash: string | null;
      retrievedAt: string | null;
    }>;
    sources: Array<{ id: string; title: string; url: string | null; publisher: string | null }>;
    aiTraceId?: string;
  };
}

const { claim } = Astro.props;

const evidence: EvidenceLink[] = claim.evidence.map((item, index) => ({
  id: `${claim.id}-ev-${index}`,
  sourceId: item.sourceId,
  quote: item.quote ?? undefined,
  sourceHash: item.sourceHash ?? undefined,
  retrievedAt: item.retrievedAt ?? undefined,
  confidence: 0,
}));

const sources = claim.sources.map((source) => ({
  id: source.id,
  title: source.title,
  url: source.url ?? undefined,
  publisher: source.publisher ?? undefined,
}));
---

<article class="claim-block">
  <p class="record-statement">{claim.text}</p>
  <div class="trust-strip">
    <ConfidenceBadge state={claim.confidenceState} />
    <ReviewStateBadge state={claim.reviewState} />
    {claim.aiTraceId && <AiLabel traceId={claim.aiTraceId} />}
    <a href={`/claims/${encodeURIComponent(claim.id)}`}>Details</a>
  </div>
  <SourcePanel
    evidence={evidence}
    sources={sources}
    emptyActionLabel="Contribute a source"
    emptyActionHref="/contribute/evidence"
  />
</article>
