import '../styles/public.css';
import {
  landing,
  landingEntryIds,
  landingPlaceIds,
  landingSectionIds,
  landingWayIds,
  record,
  stageLabels,
  stages,
  statusLabels,
  type Lang,
  type LandingEntryId,
  type LandingPlaceId,
  type LocalizedText,
  type Stage,
} from '../content/public-release';
import { aboutHrefs } from '../content/chrome';

interface Props {
  lang: Lang;
  /**
   * Destinations for the six entry rows. The pages own them because the
   * presentation route is language-specific and the demo routes are not.
   */
  entryHrefs: Record<LandingEntryId, string>;
}

const { lang, entryHrefs } = Astro.props as Props;
const text = landing[lang];
const ids = landingSectionIds[lang];
const loopStages = stages.map((stage) => stage.stage);

/**
 * The opening figure is one static synthetic record in the locked engraved
 * trace material: the first stages are appended history, the record stands on
 * the response stage, and the review gate and the receipt are still ahead.
 */
/**
 * Both places are marked for what they are before the visitor picks one: Vrsar
 * is a target and nothing more, Grad Primjer is the fictional town the
 * demonstration runs in. The stamp words are the reviewed ones (P4).
 */
const placeStamps: Record<LandingPlaceId, LocalizedText> = {
  vrsar: statusLabels.pilotTarget,
  primjer: statusLabels.demonstrationFixture,
};

const recordStageState: Record<Stage, 'is-appended' | 'is-active' | 'is-ahead'> = {
  voice: 'is-appended',
  responsibility: 'is-appended',
  response: 'is-active',
  check: 'is-ahead',
  receipt: 'is-ahead',
};
---

<article class="landing" id="public-record">
  <section class="landing-opening">
    <div class="landing-opening-text">
      <p class="kicker">{text.kicker}</p>
      <h1>{text.headline}</h1>
      <p class="landing-lede">{text.lede}</p>
      <p class="landing-actions">
        <a class="btn" data-variant="primary" href={`#${ids.howItWorks}`}>{text.primaryAction}</a>
        <a class="landing-actions-link" href={`#${ids.demonstration}`}>{text.secondaryAction}</a>
      </p>
    </div>

    <figure class="landing-record panel" aria-labelledby="landing-record-title">
      <figcaption class="landing-record-head">
        <p class="landing-record-title" id="landing-record-title">{text.recordTitle}</p>
        <span class="record-id">{record.id}</span>
        <span class="status-label" data-tone="warning">
          {statusLabels.demonstrationFixture[lang]}
        </span>
      </figcaption>
      <ol class="demo-trace">
        {
          loopStages.map((stage) => (
            <li class={`demo-trace-stage ${recordStageState[stage]}`} data-stage={stage}>
              <span class="demo-trace-marker" aria-hidden="true" />
              <div class="demo-trace-body">
                <div class="demo-trace-head">
                  <p class="demo-trace-line">{stageLabels[stage][lang]}</p>
                </div>
                <p class="demo-trace-note">{text.recordStages[stage]}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </figure>
  </section>

  <section class="landing-section" id={ids.place} aria-labelledby={`${ids.place}-title`}>
    <h2 id={`${ids.place}-title`}>{text.placeTitle}</h2>
    <p class="landing-section-lede">{text.placeLede}</p>

    <ul class="landing-places">
      {
        landingPlaceIds.map((place) => (
          <li>
            <a class="landing-place" href={`${entryHrefs.citizen}?place=${place}`}>
              <span class="landing-place-head">
                <span class="landing-place-name">{text.places[place].name}</span>
                <span class="status-label" data-style="stamp" data-tone="warning">
                  {placeStamps[place][lang]}
                </span>
              </span>
              <span class="landing-place-note">{text.places[place].note}</span>
              <span class="landing-entry-arrow" aria-hidden="true">
                →
              </span>
            </a>
          </li>
        ))
      }
    </ul>

    <ul class="landing-ways" aria-label={text.waysTitle}>
      {
        landingWayIds.map((way) => (
          <li class="landing-way">
            <span class="landing-way-name">{text.ways[way]}</span>
            {way === 'web' ? (
              <a class="landing-way-link" href={entryHrefs.citizen}>
                {text.webWay}
              </a>
            ) : (
              <Fragment>
                <span class="landing-way-value">{text.phoneUnset}</span>
                <span class="status-label" data-style="stamp" data-tone="warning">
                  {statusLabels.notLive[lang]}
                </span>
              </Fragment>
            )}
          </li>
        ))
      }
    </ul>
  </section>

  <section class="landing-section" id={ids.audience} aria-labelledby={`${ids.audience}-title`}>
    <h2 id={`${ids.audience}-title`}>{text.audienceTitle}</h2>
    <div class="landing-audiences">
      {
        text.audiences.map((audience) => (
          <div class="landing-audience">
            <h3>{audience.title}</h3>
            <p>{audience.body}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="landing-section" id={ids.howItWorks} aria-labelledby={`${ids.howItWorks}-title`}>
    <h2 id={`${ids.howItWorks}-title`}>{text.howItWorksTitle}</h2>
    <ol class="landing-stages">
      {
        loopStages.map((stage, index) => (
          <li>
            <span class="landing-stage-index" aria-hidden="true">
              {index + 1}
            </span>
            <h3 class="landing-stage-name">{stageLabels[stage][lang]}</h3>
            <p class="landing-stage-line">{text.stageLines[stage]}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="landing-section" id={ids.trust} aria-labelledby={`${ids.trust}-title`}>
    <h2 id={`${ids.trust}-title`}>{text.trustTitle}</h2>
    <div class="landing-trust">
      {
        text.trust.map((item) => (
          <div class="landing-trust-item">
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="landing-section" id={ids.pilot} aria-labelledby={`${ids.pilot}-title`}>
    <h2 id={`${ids.pilot}-title`}>{text.pilotTitle}</h2>
    <p class="landing-pilot-body">{text.pilotBody}</p>
    <p class="landing-pilot-links">
      <a href={entryHrefs.presentation}>{text.pilotLinks.presentation}</a>
      <a href={aboutHrefs[lang]}>{text.pilotLinks.source}</a>
    </p>
  </section>

  <section
    class="landing-section"
    id={ids.demonstration}
    aria-labelledby={`${ids.demonstration}-title`}
  >
    <h2 id={`${ids.demonstration}-title`}>{text.entriesTitle}</h2>
    <p class="landing-section-lede">{text.entriesLede}</p>
    <ul class="landing-entries">
      {
        landingEntryIds.map((id) => (
          <li>
            <a href={entryHrefs[id]}>
              <span class="landing-entry-label">{text.entries[id].label}</span>
              <span class="landing-entry-note">{text.entries[id].note}</span>
              <span class="landing-entry-arrow" aria-hidden="true">
                →
              </span>
            </a>
          </li>
        ))
      }
    </ul>
    <p class="landing-note">{text.demoNote}</p>
  </section>
</article>
