        },
        tips: [
          {
            en: 'Accept a pending commitment to append it as public history.',
            hr: 'Prihvatite obvezu koja čeka kako bi se upisala u javnu povijest.',
          },
          {
            en: 'Published is a publication status; it does not claim the promise is kept.',
            hr: '„Objavljeno” je status objave; ne tvrdi da je obećanje ispunjeno.',
          },
        ],
      },
    },
