            hr: 'Ništa se ne objavljuje dok to ne prihvati provjeritelj odvojen od ureda koji je podnio obvezu.',
          },
        ],
        action: {
          label: { en: 'Official surface', hr: 'Prikaz za dužnosnika' },
          href: '/demo/official',
        },
      },
      returned: {
        title: { en: 'Nothing returned', hr: 'Ništa nije vraćeno' },
        purpose: {
          en: 'A record you sent back to the filing office appears here until it is re-filed.',
          hr: 'Zapis koji ste vratili uredu pojavljuje se ovdje dok se obveza ponovno ne podnese.',
        },
