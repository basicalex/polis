---
/**
 * `/demo/review` — the independent reviewer queue over the shared demo store.
 *
 * Same queue anatomy as the official surface: a status-bucket rail with live counts, ledger rows,
 * and a detail panel with the trace timeline plus only the decisions this role may take. Static
 * chrome renders both languages as `data-lang` siblings (EN visible without JavaScript); the queue
 * is client-rendered from the demo store and re-renders on every store notification, cross-tab
 * ones included.
 *
 * This is the only surface that can publish. Accepting appends the proposed commitment as public
 * history and writes the receipt; returning sends the record back to the filing office with a
 * required note.
 */
import Base from '../../layouts/Base.astro';
import DemoShell from '../../components/demo/DemoShell.astro';
import { seedFixtureId } from '../../content/demo-fixtures.mjs';
import { institutionAnchor } from '../../content/demo-strings.mjs';

const headings = {
  page: { en: 'Independent review queue', hr: 'Red za neovisnu provjeru' },
  rail: { en: 'Filter by status', hr: 'Filtriraj po statusu' },
  ledger: { en: 'Queue — oldest first', hr: 'Red — najstarije prvo' },
  detail: { en: 'Selected record', hr: 'Odabrani zapis' },
};

const noscriptCopy = {
  en: 'This surface needs JavaScript: the demo records live in your browser, not on a server.',
  hr: 'Ovaj prikaz treba JavaScript: demo zapisi pohranjeni su u vašem pregledniku, a ne na poslužitelju.',
};

const loadingCopy = {
  en: 'Loading the review queue…',
  hr: 'Učitavanje reda za provjeru…',
};

const roleNote = {
  en: 'You are a distinct reviewer: an official cannot publish their own follow-through, so every filed commitment waits here until you accept or return it. Accepting publishes the receipt; returning needs a note naming what the office must change.',
  hr: 'Vi ste zaseban provjeritelj: dužnosnik ne može objaviti vlastito izvršenje, pa svaka podnesena obveza čeka ovdje dok je ne prihvatite ili vratite. Prihvaćanjem se objavljuje potvrda; vraćanjem se traži bilješka o tome što ured mora promijeniti.',
};

const provenance = {
  en: `Seeded from fixture ${seedFixtureId}. Sources:`,
  hr: `Popunjeno iz primjera ${seedFixtureId}. Izvori:`,
};

const provenanceLink = { en: 'Transparency', hr: 'Transparentnost' };
---

<Base
  lang="en"
  chrome="demo"
  title="Polis — Independent review demo surface"
  description="The independent reviewer queue: assess a filed commitment, then publish the receipt or return the record to the office."
>
  <DemoShell surface="review">
    <article class="queue" id="public-record">
      <header class="queue-lead">
        <h1 class="queue-title">
          <span data-lang="en">{headings.page.en}</span>
          <span data-lang="hr" hidden>{headings.page.hr}</span>
        </h1>
        <p class="demo-anchor">
          <span data-lang="en">{institutionAnchor.en}</span>
          <span data-lang="hr" hidden>{institutionAnchor.hr}</span>
        </p>
      </header>

      <noscript>
        <p class="queue-noscript">
          <span data-lang="en">{noscriptCopy.en}</span>
          <span data-lang="hr" hidden>{noscriptCopy.hr}</span>
        </p>
      </noscript>

      <div class="queue-grid">
        <nav class="queue-rail" aria-label={headings.rail.en} data-rail>
          <ul class="queue-buckets" data-buckets></ul>
        </nav>

        <section class="queue-ledger" aria-labelledby="queue-ledger-title">
          <h2 class="queue-column-title" id="queue-ledger-title">
            <span data-lang="en">{headings.ledger.en}</span>
            <span data-lang="hr" hidden>{headings.ledger.hr}</span>
          </h2>
          <p class="queue-loading" data-loading>
            <span data-lang="en">{loadingCopy.en}</span>
            <span data-lang="hr" hidden>{loadingCopy.hr}</span>
          </p>
          <p class="queue-status" role="status" data-status></p>
          <ul class="demo-ledger" data-ledger></ul>
        </section>

        <section class="queue-detail" aria-labelledby="queue-detail-title" data-detail-column>
          <h2 class="queue-column-title" id="queue-detail-title">
            <span data-lang="en">{headings.detail.en}</span>
            <span data-lang="hr" hidden>{headings.detail.hr}</span>
          </h2>
          <div data-detail></div>
        </section>
      </div>

      <footer class="queue-foot">
        <p class="queue-role-note">
          <span data-lang="en">{roleNote.en}</span>
          <span data-lang="hr" hidden>{roleNote.hr}</span>
        </p>
        <p class="queue-provenance">
          <span data-lang="en">{provenance.en}</span>
          <span data-lang="hr" hidden>{provenance.hr}</span>{' '}
          <a href="/transparency">
            <span data-lang="en">{provenanceLink.en}</span>
            <span data-lang="hr" hidden>{provenanceLink.hr}</span>
          </a>
        </p>
      </footer>
    </article>
  </DemoShell>
</Base>

<style>
  .queue {
    display: grid;
    gap: var(--space-md);
    min-width: 0;
    max-width: 74rem;
  }

  .queue-lead {
    display: grid;
    gap: var(--space-xs);
    min-width: 0;
  }

  .queue-title {
    margin: 0;
    font-family: var(--display);
    font-size: var(--type-heading-sm);
    line-height: 1.15;
  }

  .queue-noscript {
    max-width: 68ch;
    margin: 0;
    padding: var(--space-sm);
    background: var(--polis-surface-tint);
    color: var(--polis-text);
    font-size: var(--type-data);
  }

  .queue-grid {
    display: grid;
    gap: var(--space-md);
    min-width: 0;
    align-items: start;
  }

  @media (min-width: 56.25rem) {
    .queue-grid {
      grid-template-columns: minmax(0, 15rem) minmax(0, 1fr) minmax(0, 24rem);
      gap: var(--space-lg);
    }
  }

  /* Rail: a vertical bucket list on desktop, a horizontal chip row below 56.25rem. */
  .queue-rail {
    min-width: 0;
  }

  .queue-buckets {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    min-width: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 56.25rem) {
    .queue-buckets {
      display: grid;
      gap: 0;
    }
  }

  .queue-column-title {
    margin: 0 0 var(--space-sm);
    padding-bottom: var(--space-xs);
    border-bottom: 1px solid var(--polis-border);
    color: var(--polis-muted);
    font-family: var(--body);
    font-size: var(--type-data);
    font-weight: 600;
    letter-spacing: 0.06em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .queue-loading,
  .queue-status {
    margin: 0 0 var(--space-sm);
    color: var(--polis-muted);
    font-size: var(--type-data);
    line-height: 1.5;
  }

  .queue-status {
    color: var(--polis-text);
  }

  .queue-status:empty,
  .queue-loading[hidden] {
    display: none;
  }

  .queue-status a {
    color: var(--polis-trace);
  }

  .queue-detail {
    display: grid;
    min-width: 0;
  }

  .queue-detail[hidden] {
    display: none;
  }

  .queue-foot {
    display: grid;
    gap: var(--space-xs);
    max-width: 68ch;
    min-width: 0;
    padding-top: var(--space-md);
    border-top: 1px solid var(--polis-border);
  }

  .queue-role-note {
    margin: 0;
    color: var(--polis-text);
    font-size: var(--type-data);
    line-height: 1.55;
  }

  .queue-provenance {
    margin: 0;
    color: var(--polis-muted);
    font-size: var(--type-data);
  }

  .queue-provenance a {
    color: var(--polis-trace);
  }

  /*
   * Everything below is built by the page script, so Astro cannot stamp it with the scope
   * attribute. It stays inside this page's scope through the `.queue-grid` ancestor, which is
   * an ancestor of the detail panel in both placements (own column on desktop, inside the
   * selected ledger row below 56.25rem).
   */
  .queue-grid :global(.queue-bucket) {
    min-width: 0;
    width: 100%;
    min-height: var(--tap-target);
    display: flex;
    align-items: center;
    gap: var(--space-xs) var(--space-sm);
    padding: var(--space-xs) var(--space-sm);
    border: 1px solid var(--polis-border-strong);
    border-radius: var(--radius-sm);
    background: var(--polis-surface);
    color: var(--polis-text);
    font-family: var(--body);
    font-size: 0.9375rem;
    font-weight: 600;
    text-align: start;
    cursor: pointer;
  }

  .queue-grid :global(.queue-bucket:hover) {
    background: var(--polis-surface-tint);
  }

  .queue-grid :global(.queue-bucket[aria-pressed='true']) {
    border-color: var(--polis-trace);
    color: var(--polis-trace);
  }

  .queue-grid :global(.queue-bucket-count) {
    margin-left: auto;
    color: var(--polis-muted);
    font-family: var(--mono);
    font-size: var(--type-data);
  }

  .queue-grid :global(.queue-bucket[aria-pressed='true'] .queue-bucket-count) {
    color: var(--polis-trace);
  }

  @media (min-width: 56.25rem) {
    .queue-grid :global(.queue-bucket) {
      border: 0;
      border-bottom: 1px solid var(--polis-border);
      border-left: 0.1875rem solid transparent;
      border-radius: 0;
      background: transparent;
    }

    .queue-grid :global(.queue-bucket[aria-pressed='true']) {
      border-left-color: var(--polis-trace);
      background: var(--polis-surface-tint);
    }
  }

  .queue-grid :global(.queue-empty) {
    max-width: 68ch;
    margin: 0;
    padding: var(--space-sm) 0;
    color: var(--polis-muted);
    font-size: var(--type-data);
    line-height: 1.5;
  }

  .queue-grid :global(.queue-empty a) {
    color: var(--polis-trace);
  }

  .queue-grid :global(.queue-detail-card) {
    display: grid;
    gap: var(--space-sm);
    min-width: 0;
  }

  @media (max-width: 56.24rem) {
    .queue-grid :global(.queue-detail-card) {
      margin: 0 0 var(--space-sm) var(--space-sm);
    }
  }

  .queue-grid :global(.queue-detail-id) {
    color: var(--polis-muted);
    font-family: var(--mono);
    font-size: var(--type-data);
    overflow-wrap: anywhere;
  }

  .queue-grid :global(.queue-detail-subject) {
    margin: 0;
    font-family: var(--display);
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.2;
  }

  .queue-grid :global(.queue-detail-head) {
    display: grid;
    gap: 0.2rem;
    min-width: 0;
  }

  .queue-grid :global(.queue-detail-stamps) {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    min-width: 0;
    margin-top: 0.2rem;
  }

  .queue-grid :global(.queue-fields) {
    display: grid;
    grid-template-columns: minmax(0, 9rem) minmax(0, 1fr);
    gap: 0.2rem var(--space-sm);
    min-width: 0;
    margin: 0;
    font-size: var(--type-data);
    line-height: 1.5;
  }

  .queue-grid :global(.queue-fields dt) {
    color: var(--polis-muted);
    font-weight: 600;
  }

  .queue-grid :global(.queue-fields dd) {
    min-width: 0;
    margin: 0;
    overflow-wrap: anywhere;
  }

  .queue-grid :global(.queue-note) {
    margin: 0;
    color: var(--polis-muted);
    font-size: var(--type-data);
    line-height: 1.5;
  }

  /* What the reviewer must read before deciding: role, independence, scope, consequence. */
  .queue-grid :global(.queue-preamble) {
    display: grid;
    gap: 0.2rem var(--space-sm);
    min-width: 0;
    margin: 0;
    padding: var(--space-sm);
    border-radius: var(--radius-sm);
    background: var(--polis-surface-tint);
    font-size: var(--type-data);
    line-height: 1.5;
  }

  .queue-grid :global(.queue-preamble dt) {
    color: var(--polis-muted);
    font-weight: 600;
  }

  .queue-grid :global(.queue-preamble dd) {
    min-width: 0;
    margin: 0 0 var(--space-xs);
  }

  .queue-grid :global(.queue-preamble dd:last-child) {
    margin-bottom: 0;
  }

  .queue-grid :global(.queue-form) {
    display: grid;
    gap: var(--space-sm);
    min-width: 0;
    margin: 0;
    padding-top: var(--space-sm);
    border-top: 1px solid var(--polis-border);
  }

  .queue-grid :global(.queue-decision) {
    display: grid;
    gap: 0.25rem;
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .queue-grid :global(.queue-decision legend) {
    padding: 0;
    font-family: var(--body);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.4;
  }

  .queue-grid :global(.queue-choice) {
    min-height: var(--tap-target);
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
    font-size: var(--type-data);
    line-height: 1.4;
  }

  .queue-grid :global(.queue-choice input) {
    width: 1.15rem;
    height: 1.15rem;
    flex: 0 0 auto;
    accent-color: var(--polis-trace);
  }

  .queue-grid :global(.queue-field) {
    display: grid;
    gap: 0.25rem;
    min-width: 0;
  }

  .queue-grid :global(.queue-field label) {
    font-size: var(--type-data);
    font-weight: 600;
  }

  .queue-grid :global(.queue-hint) {
    color: var(--polis-muted);
    font-size: var(--type-meta);
    line-height: 1.45;
  }

  .queue-grid :global(.queue-field input),
  .queue-grid :global(.queue-field textarea) {
    box-sizing: border-box;
    width: 100%;
    min-width: 0;
    min-height: var(--tap-target);
    padding: 0.5rem 0.6rem;
    border: 1px solid var(--polis-border-strong);
    border-radius: var(--radius-sm);
    background: var(--polis-surface);
    color: var(--polis-text);
    font-family: var(--body);
    font-size: 1rem;
    line-height: 1.45;
  }

  .queue-grid :global(.queue-field textarea) {
    min-height: 5.5rem;
    resize: vertical;
  }

  /* Flat buttons: solid trace fill or hairline outline. No gloss, no gradient. */
  .queue-grid :global(.queue-submit),
  .queue-grid :global(.queue-link-action) {
    min-width: 0;
    min-height: var(--tap-target);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-xs) var(--space-md);
    border: 1px solid var(--polis-trace);
    border-radius: var(--radius-sm);
    background: var(--polis-trace);
    color: var(--polis-on-primary);
    font-family: var(--body);
    font-size: 0.9375rem;
    font-weight: 600;
    text-align: center;
    text-decoration: none;
    cursor: pointer;
  }

  .queue-grid :global(.queue-link-action) {
    background: var(--polis-surface);
    color: var(--polis-trace);
  }

  .queue-grid :global(.queue-link-action:hover) {
    background: var(--polis-surface-tint);
  }

  .queue-grid :global(.queue-error) {
    margin: 0;
    color: var(--polis-danger);
    font-size: var(--type-data);
    line-height: 1.5;
  }

  @media (max-width: 40rem) {
    .queue-grid :global(.queue-fields) {
      grid-template-columns: minmax(0, 1fr);
    }

    .queue-grid :global(.queue-fields dd) {
      margin-bottom: var(--space-xs);
    }
  }
</style>

<script>
  import { DEMO_STAGES, getState, reviewCommitment, subscribe } from '../../lib/demo-store.mjs';
  import {
    compactQuery,
    currentValue,
    el,
    fieldKey,
    formatDate,
    matchesBucket,
    messageOf,
    renderBuckets,
    renderRow,
    renderTrace,
    stamp,
    text,
    wireQueue,
  } from '../../lib/demo-queue.mjs';
  import {
    categoryLabels,
    institutionAnchor,
    originLabels,
    stageLabels,
    stampLabels,
    statusLabels,
  } from '../../content/demo-strings.mjs';
  import { seedRecords } from '../../content/demo-fixtures.mjs';

  type Lang = 'en' | 'hr';
  type Localized = { en: string; hr: string };
  type DemoRecord = ReturnType<typeof getState>['records'][number];
  type Status = DemoRecord['status'];

  const copy = {
    buckets: {
      all: { en: 'All', hr: 'Sve' },
      pending: { en: 'Pending review', hr: 'Čeka neovisnu provjeru' },
      returned: { en: 'Returned', hr: 'Vraćeno' },
      published: { en: 'Published', hr: 'Objavljeno' },
    },
    /* Short ink-stamp words, shared with every other demo surface. */
    stamps: {
      pending: stampLabels['commitment-pending-review'],
      returned: stampLabels.returned,
      published: stampLabels.published,
    },
    /* Sentence form of the decision, for the field list. The trace carries the accepted
       sentence as an event of its own; nothing else on this page carries the returned one. */
    decisionValues: {
      accepted: {
        en: 'ACCEPTED BY INDEPENDENT REVIEW',
        hr: 'PRIHVAĆENO U NEOVISNOJ PROVJERI',
      },
      returned: {
        en: 'RETURNED BY INDEPENDENT REVIEW',
        hr: 'VRAĆENO S NEOVISNE PROVJERE',
      },
    },
    stageNotes: {
      responsibility: { en: 'No responsible office yet', hr: 'Još nema nadležnog ureda' },
      response: { en: 'No commitment filed', hr: 'Obveza nije podnesena' },
      check: {
        en: 'Independent review has not decided',
        hr: 'Neovisna provjera nije odlučila',
      },
      receipt: { en: 'Nothing published', hr: 'Ništa nije objavljeno' },
    },
    categoryLabel: { en: 'Category', hr: 'Kategorija' },
    filedOnLabel: { en: 'Filed', hr: 'Podneseno' },
    officeLabel: { en: 'Responsible office', hr: 'Nadležni ured' },
    roleLabel: { en: 'Responsible role', hr: 'Nadležna funkcija' },
    commitmentLabel: { en: 'Commitment', hr: 'Obveza' },
    dueLabel: { en: 'Due date', hr: 'Rok' },
    filedByLabel: { en: 'Filed by', hr: 'Podnositelj' },
    decisionLabel: { en: 'Review decision', hr: 'Odluka provjere' },
    noteFieldLabel: { en: 'Review note', hr: 'Bilješka provjere' },
    roleTerm: { en: 'Reviewer role', hr: 'Uloga provjeritelja' },
    roleValue: {
      en: 'Independent reviewer. You decide whether this commitment is published; the office that filed it cannot.',
      hr: 'Neovisni provjeritelj. Vi odlučujete objavljuje li se ova obveza; ured koji ju je podnio ne može.',
    },
    independenceTerm: { en: 'Independence rule', hr: 'Pravilo neovisnosti' },
    independenceValue: {
      en: 'You are distinct from the filing office, {office}. An official never reviews their own follow-through.',
      hr: 'Odvojeni ste od ureda koji je podnio obvezu, {office}. Dužnosnik nikada ne provjerava vlastito izvršenje.',
    },
    evidenceTerm: { en: 'Evidence scope', hr: 'Opseg dokaza' },
    evidenceValue: {
      en: 'You are assessing the filed commitment text, its due date, and the public events on this record. Restricted case material is not part of this record and is never fetched here.',
      hr: 'Ocjenjujete tekst podnesene obveze, njezin rok i javne događaje na ovom zapisu. Ograničeni spis nije dio ovog zapisa i ovdje se nikada ne dohvaća.',
    },
    consequenceTerm: { en: 'Consequence', hr: 'Posljedica' },
    consequenceValue: {
      en: 'Accept appends the commitment as public history, records your check, and publishes the receipt. Return sends the record back to the office to re-file; nothing is published.',
      hr: 'Prihvaćanjem se obveza upisuje u javnu povijest, bilježi se vaša provjera i objavljuje potvrda. Vraćanjem se zapis vraća uredu na ponovno podnošenje; ništa se ne objavljuje.',
    },
    decisionLegend: { en: 'Decision', hr: 'Odluka' },
    accept: { en: 'Accept — publish the receipt', hr: 'Prihvati — objavi potvrdu' },
    return: { en: 'Return — send it back to the office', hr: 'Vrati — pošalji natrag uredu' },
    noteLabel: { en: 'Review note', hr: 'Bilješka provjere' },
    noteHintAccept: {
      en: 'Optional when you accept. Required when you return: name what the office must change.',
      hr: 'Neobavezno kad prihvaćate. Obavezno kad vraćate: navedite što ured mora promijeniti.',
    },
    noteHintReturn: {
      en: 'Required: name what the office must change. It is published with the decision.',
      hr: 'Obavezno: navedite što ured mora promijeniti. Objavljuje se uz odluku.',
    },
    reviewerLabel: { en: 'Reviewer', hr: 'Provjeritelj' },
    submit: { en: 'Submit review decision', hr: 'Pošalji odluku o provjeri' },
    decisionRequired: {
      en: 'Choose a decision: accept publishes the receipt, return sends the record back.',
      hr: 'Odaberite odluku: prihvaćanje objavljuje potvrdu, vraćanje šalje zapis natrag.',
    },
    noteRequired: {
      en: 'A returned record needs a note: name what the office must change.',
      hr: 'Vraćeni zapis treba bilješku: navedite što ured mora promijeniti.',
    },
    acceptedConfirm: {
      en: 'Accepted. {id} is published with a public receipt.',
      hr: 'Prihvaćeno. Zapis {id} objavljen je s javnom potvrdom.',
    },
    returnedConfirm: {
      en: 'Returned. {id} went back to the filing office to re-file.',
      hr: 'Vraćeno. Zapis {id} vraćen je uredu na ponovno podnošenje.',
    },
    decidedLine: {
      en: 'Decided. No further review action on this record.',
      hr: 'Odlučeno. Na ovom zapisu nema daljnje radnje provjere.',
    },
    openRecord: { en: 'View full record', hr: 'Otvori cijeli zapis' },
    emptyBucket: { en: 'No record in this bucket.', hr: 'U ovoj skupini nema zapisa.' },
    emptyPending: {
      en: 'No commitment is awaiting review. File one on the official surface:',
      hr: 'Nijedna obveza ne čeka provjeru. Podnesite obvezu na prikazu za dužnosnika:',
    },
    emptyLink: { en: 'Official surface', hr: 'Prikaz za dužnosnika' },
    nothingSelected: {
      en: 'Select a record to read the filing and decide.',
      hr: 'Odaberite zapis kako biste pročitali podnesak i odlučili.',
    },
  } as const;

  /** Statuses this surface reviews. Records before a filed commitment are not its business. */
  const reviewStatuses: Status[] = ['commitment-pending-review', 'returned', 'published'];

  /** Bucket → store status. The store's status field is the only source of truth. */
  const bucketDefs = [
    { id: 'all', statuses: null as Status[] | null, label: copy.buckets.all },
    {
      id: 'pending',
      statuses: ['commitment-pending-review'] as Status[],
      label: copy.buckets.pending,
    },
    { id: 'returned', statuses: ['returned'] as Status[], label: copy.buckets.returned },
    { id: 'published', statuses: ['published'] as Status[], label: copy.buckets.published },
  ];

  const stampFor: Record<string, { text: Localized; mod: string }> = {
    'commitment-pending-review': { text: copy.stamps.pending, mod: 'pending' },
    returned: { text: copy.stamps.returned, mod: 'returned' },
    published: { text: copy.stamps.published, mod: 'published' },
  };

  /** The map names only the statuses this surface reviews; anything else stamps as pending. */
  const fallbackStamp = { text: copy.stamps.pending, mod: 'pending' };
  const renderStamp = (status: string, lang: Lang): HTMLSpanElement =>
    stamp(stampFor, status, lang, fallbackStamp);

  const traceOptions = {
    stages: DEMO_STAGES,
    stageLabels,
    stageNotes: copy.stageNotes,
    pendingLabel: statusLabels.pendingReview,
  };

  const seedReviewer =
    seedRecords.find((entry) => entry.id === 'POLIS-D-0001')?.review?.reviewer ?? '';

  const rail = document.querySelector('[data-rail]');
  const bucketList = document.querySelector('[data-buckets]');
  const ledger = document.querySelector('[data-ledger]');
  const detailColumn = document.querySelector('[data-detail-column]');
  const detailSlot = document.querySelector('[data-detail]');
  const loading = document.querySelector('[data-loading]');
  const statusRegion = document.querySelector('[data-status]');

  /** Which bucket filters the ledger. The reviewer's own queue is the default. */
  let bucket = 'pending';
  /** Which record the detail panel shows. Local to this tab. */
  let selectedId: string | null = null;
  /** Values the visitor typed, kept across re-renders (a cross-tab update must not wipe a form). */
  const formValues = new Map<string, string>();
  /** Decision radio state, by record id. */
  const decisions = new Map<string, 'accepted' | 'returned'>();
  /** Inline errors, by record id. */
  const errors = new Map<string, Localized>();
  /** The last decision, announced above the ledger because a decided record leaves the queue. */
  let lastDecision: { id: string; decision: 'accepted' | 'returned' } | null = null;

  const compact = compactQuery();

  function field(
    recordId: string,
    name: string,
    labelText: string,
    kind: 'text' | 'textarea',
    value: string,
    hint?: string,
  ): {
    wrap: HTMLDivElement;
    control: HTMLInputElement | HTMLTextAreaElement;
    hintNode: HTMLSpanElement | null;
  } {
    const wrap = el('div', 'queue-field');
    const id = `${recordId}-${name}`.toLowerCase();
    const label = el('label', undefined, labelText);
    label.htmlFor = id;
    const control =
      kind === 'textarea' ? document.createElement('textarea') : document.createElement('input');
    if (control instanceof HTMLInputElement) control.type = 'text';
    control.id = id;
    control.name = name;
    control.value = value;
    control.setAttribute('data-focus-key', fieldKey(recordId, name));
    control.addEventListener('input', () => {
      formValues.set(fieldKey(recordId, name), control.value);
    });
    wrap.append(label, control);
    let hintNode: HTMLSpanElement | null = null;
    if (hint) {
      const hintId = `${id}-hint`;
      hintNode = el('span', 'queue-hint', hint);
      hintNode.id = hintId;
      control.setAttribute('aria-describedby', hintId);
      wrap.append(hintNode);
    }
    return { wrap, control, hintNode };
  }

  /* --------------------------------------------------------------- detail -- */

  function detailFields(record: DemoRecord, lang: Lang): HTMLDListElement {
    const fields = el('dl', 'queue-fields');
    fields.append(
      el('dt', undefined, text(copy.categoryLabel, lang)),
      el('dd', undefined, text(categoryLabels[record.category], lang)),
      el('dt', undefined, text(copy.filedOnLabel, lang)),
      el('dd', undefined, formatDate(record.createdAt, lang)),
    );
    if (record.responsibility) {
      fields.append(
        el('dt', undefined, text(copy.officeLabel, lang)),
        el('dd', undefined, text(record.responsibility.office, lang)),
        el('dt', undefined, text(copy.roleLabel, lang)),
        el('dd', undefined, text(record.responsibility.role, lang)),
      );
    }
    if (record.commitment) {
      fields.append(
        el('dt', undefined, text(copy.commitmentLabel, lang)),
        el('dd', undefined, text(record.commitment.text, lang)),
        el('dt', undefined, text(copy.dueLabel, lang)),
        el('dd', undefined, formatDate(record.commitment.due, lang)),
        el('dt', undefined, text(copy.filedByLabel, lang)),
        el('dd', undefined, text(record.commitment.filedBy, lang)),
      );
    }
    if (record.review) {
      fields.append(
        el('dt', undefined, text(copy.decisionLabel, lang)),
        el(
          'dd',
          undefined,
          text(
            record.review.decision === 'accepted'
              ? copy.decisionValues.accepted
              : copy.decisionValues.returned,
            lang,
          ),
        ),
        el('dt', undefined, text(copy.reviewerLabel, lang)),
        el('dd', undefined, text(record.review.reviewer, lang)),
      );
      const note = text(record.review.note, lang);
      if (note) {
        fields.append(
          el('dt', undefined, text(copy.noteFieldLabel, lang)),
          el('dd', undefined, note),
        );
      }
    }
    return fields;
  }

  /** Role, independence rule, evidence scope, and consequence — read before the decision. */
  function preamble(record: DemoRecord, lang: Lang): HTMLDListElement {
    const officeName = record.responsibility
      ? text(record.responsibility.office, lang)
      : text(copy.officeLabel, lang);
    const list = el('dl', 'queue-preamble');
    list.append(
      el('dt', undefined, text(copy.roleTerm, lang)),
      el('dd', undefined, text(copy.roleValue, lang)),
      el('dt', undefined, text(copy.independenceTerm, lang)),
      el('dd', undefined, text(copy.independenceValue, lang).replace('{office}', officeName)),
      el('dt', undefined, text(copy.evidenceTerm, lang)),
      el('dd', undefined, text(copy.evidenceValue, lang)),
      el('dt', undefined, text(copy.consequenceTerm, lang)),
      el('dd', undefined, text(copy.consequenceValue, lang)),
    );
    return list;
  }

  function decisionForm(record: DemoRecord, lang: Lang): HTMLFormElement {
    const form = el('form', 'queue-form');
    /* The page validates the decision itself: its message names what the office must change,
       which a browser's generic "fill out this field" bubble does not. */
    form.noValidate = true;
    const fieldset = el('fieldset', 'queue-decision');
    fieldset.append(el('legend', undefined, text(copy.decisionLegend, lang)));

    const chosen = decisions.get(record.id) ?? null;
    const radios: HTMLInputElement[] = [];
    const note = field(
      record.id,
      'note',
      text(copy.noteLabel, lang),
      'textarea',
      currentValue(formValues, record.id, 'note', ''),
      text(chosen === 'returned' ? copy.noteHintReturn : copy.noteHintAccept, lang),
    );

    /* A return must tell the office what to correct: the requirement is on the field, not only
       in the store's throw. */
    function applyNoteRequirement(decision: 'accepted' | 'returned' | null): void {
      const required = decision === 'returned';
      note.control.required = required;
      note.control.setAttribute('aria-required', required ? 'true' : 'false');
      if (note.hintNode) {
        note.hintNode.textContent = text(
          required ? copy.noteHintReturn : copy.noteHintAccept,
          lang,
        );
      }
    }

    for (const option of ['accepted', 'returned'] as const) {
      const choice = el('label', 'queue-choice');
      const input = document.createElement('input');
      input.type = 'radio';
      input.name = `decision-${record.id}`;
      input.value = option;
      input.checked = chosen === option;
      input.setAttribute('data-focus-key', fieldKey(record.id, `decision-${option}`));
      input.addEventListener('change', () => {
        if (!input.checked) return;
        decisions.set(record.id, option);
        applyNoteRequirement(option);
      });
      radios.push(input);
      choice.append(input, text(option === 'accepted' ? copy.accept : copy.return, lang));
      fieldset.append(choice);
    }
    applyNoteRequirement(chosen);

    const reviewer = field(
      record.id,
      'reviewer',
      text(copy.reviewerLabel, lang),
      'text',
      currentValue(formValues, record.id, 'reviewer', text(seedReviewer, lang)),
    );
    reviewer.control.required = true;

    const submit = el('button', 'queue-submit', text(copy.submit, lang));
    submit.type = 'submit';
    submit.setAttribute('data-focus-key', fieldKey(record.id, 'submit'));
    form.append(fieldset, note.wrap, reviewer.wrap, submit);

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const selected = radios.find((input) => input.checked)?.value;
      if (selected !== 'accepted' && selected !== 'returned') {
        errors.set(record.id, copy.decisionRequired);
        render();
        return;
      }
      const noteValue = note.control.value.trim();
      if (selected === 'returned' && !noteValue) {
        errors.set(record.id, copy.noteRequired);
        render();
        return;
      }
      try {
        errors.delete(record.id);
        reviewCommitment(record.id, {
          decision: selected,
          note: noteValue,
          reviewer: reviewer.control.value,
        });
        formValues.delete(fieldKey(record.id, 'note'));
        formValues.delete(fieldKey(record.id, 'reviewer'));
        decisions.delete(record.id);
        lastDecision = { id: record.id, decision: selected };
      } catch (error) {
        errors.set(record.id, messageOf(error));
      }
      render();
    });

    return form;
  }

  function renderDetail(record: DemoRecord, lang: Lang): HTMLDivElement {
    const card = el('div', 'demo-panel queue-detail-card');
    card.setAttribute('data-detail-card', record.id);

    const head = el('div', 'queue-detail-head');
    head.append(el('span', 'queue-detail-id', record.id));
    head.append(el('h3', 'queue-detail-subject', text(record.subject, lang)));
    head.append(
      el(
        'p',
        'demo-anchor',
        `${text(institutionAnchor, lang)} · ${text(originLabels[record.origin], lang)}`,
      ),
    );
    const stamps = el('div', 'queue-detail-stamps');
    stamps.append(renderStamp(record.status, lang));
    head.append(stamps);
    card.append(head);

    card.append(detailFields(record, lang));
    card.append(renderTrace(record, lang, traceOptions));

    /* Only a record still pending review carries a decision. Returned and published are decided. */
    if (record.status === 'commitment-pending-review' && record.commitment?.reviewStatus === 'pending') {
      card.append(preamble(record, lang));
      card.append(decisionForm(record, lang));
    } else {
      card.append(el('p', 'queue-note', text(copy.decidedLine, lang)));
    }

    const error = errors.get(record.id);
    if (error) {
      const node = el('p', 'queue-error', text(error, lang));
      node.setAttribute('role', 'alert');
      card.append(node);
    }

    const open = el('a', 'queue-link-action', text(copy.openRecord, lang));
    open.href = `/demo/record?id=${encodeURIComponent(record.id)}`;
    open.setAttribute('data-focus-key', fieldKey(record.id, 'open'));
    card.append(open);

    return card;
  }

  /* --------------------------------------------------------------- render -- */

  function renderNotice(lang: Lang): void {
    if (!(statusRegion instanceof HTMLElement)) return;
    if (!lastDecision) {
      statusRegion.replaceChildren();
      return;
    }
    const template =
      lastDecision.decision === 'accepted' ? copy.acceptedConfirm : copy.returnedConfirm;
    statusRegion.textContent = text(template, lang).replace('{id}', lastDecision.id);
  }

  function render(): void {
    if (!(ledger instanceof HTMLElement)) return;
    const state = getState();
    const lang: Lang = state.lang === 'hr' ? 'hr' : 'en';

    const active = document.activeElement;
    const focusKey = active instanceof HTMLElement ? active.getAttribute('data-focus-key') : null;
    const selectionStart =
      active instanceof HTMLInputElement || active instanceof HTMLTextAreaElement
        ? active.selectionStart
        : null;

    /* Oldest first: the commitment that has waited longest is the reviewer's next job. */
    const records = state.records
      .filter((record) => reviewStatuses.includes(record.status))
      .sort((a, b) => a.createdAt.localeCompare(b.createdAt) || a.id.localeCompare(b.id));

    renderBuckets(bucketList, records, lang, {
      bucketDefs,
      activeBucket: bucket,
      onSelect: (id) => {
        bucket = id;
        render();
      },
    });

    const visible = records.filter((record) => matchesBucket(record, bucket, bucketDefs));
    if (selectedId && !visible.some((record) => record.id === selectedId)) selectedId = null;
    if (!selectedId && visible.length > 0) selectedId = visible[0].id;

    const selected = visible.find((record) => record.id === selectedId) ?? null;
    const narrow = compact ? compact.matches : false;
    const card = selected ? renderDetail(selected, lang) : null;

    if (visible.length === 0) {
      const empty = el('li');
      const line = el('p', 'queue-empty');
      if (bucket === 'pending' || bucket === 'all') {
        const link = el('a', undefined, text(copy.emptyLink, lang));
        link.href = '/demo/official';
        line.append(`${text(copy.emptyPending, lang)} `, link);
      } else {
        line.textContent = text(copy.emptyBucket, lang);
      }
      empty.append(line);
      ledger.replaceChildren(empty);
    } else {
      ledger.replaceChildren(
        ...visible.map((record) => {
          const row = renderRow(record, lang, {
            selected: record.id === selectedId,
            categoryLabels,
            stamp: renderStamp,
            onSelect: (picked) => {
              selectedId = picked.id;
              render();
            },
          });
          if (narrow && card && record.id === selectedId) row.append(card);
          return row;
        }),
      );
    }

    if (detailSlot instanceof HTMLElement) {
      if (narrow) detailSlot.replaceChildren();
      else if (card) detailSlot.replaceChildren(card);
      else detailSlot.replaceChildren(el('p', 'queue-empty', text(copy.nothingSelected, lang)));
    }
    if (detailColumn instanceof HTMLElement) detailColumn.hidden = narrow;
    if (rail instanceof HTMLElement) {
      rail.setAttribute('aria-label', lang === 'hr' ? 'Filtriraj po statusu' : 'Filter by status');
    }

    renderNotice(lang);
    if (loading instanceof HTMLElement) loading.hidden = true;

    if (focusKey) {
      const restored = document.querySelector(
        `.queue-grid [data-focus-key="${CSS.escape(focusKey)}"]`,
      );
      if (restored instanceof HTMLElement) {
        restored.focus({ preventScroll: true });
        if (
          selectionStart !== null &&
          (restored instanceof HTMLInputElement || restored instanceof HTMLTextAreaElement)
        ) {
          try {
            restored.setSelectionRange(selectionStart, selectionStart);
          } catch {
            /* some input types refuse selection ranges */
          }
        }
      }
    }
  }

  wireQueue({ subscribe, compact, render });
</script>
