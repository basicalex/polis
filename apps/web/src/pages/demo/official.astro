---
/**
 * `/demo/official` — the municipal staff queue over the shared demo store.
 *
 * Queue idiom: a status-bucket rail with live counts, a ledger of records newest first, and a
 * detail panel carrying the trace timeline plus only the actions this role may take. Static
 * chrome renders both languages as `data-lang` siblings (Croatian visible without JavaScript); the
 * queue itself is client-rendered from the demo store and re-renders on every store
 * notification, cross-tab ones included.
 *
 * The meaning model is not negotiable here: this office can accept responsibility and file a
 * commitment, and nothing else. A filed commitment starts PENDING REVIEW and only the independent
 * reviewer surface can publish it or set a terminal status.
 */
import Base from '../../layouts/Base.astro';
import DemoShell from '../../components/demo/DemoShell.astro';
import { seedFixtureId } from '../../content/demo-fixtures.mjs';
import { institutionAnchor } from '../../content/demo-strings.mjs';

const headings = {
  page: { en: 'Official inbox', hr: 'Pristigli zapisi' },
  rail: { en: 'Filter by status', hr: 'Filtriraj po statusu' },
  ledger: { en: 'Inbox — newest first', hr: 'Pristiglo — najnovije prvo' },
  detail: { en: 'Selected record', hr: 'Odabrani zapis' },
};

const noscriptCopy = {
  en: 'This surface needs JavaScript: the demo records live in your browser, not on a server.',
  hr: 'Ovaj prikaz treba JavaScript: demo zapisi pohranjeni su u vašem pregledniku, a ne na poslužitelju.',
};

const loadingCopy = {
  en: 'Loading demo records…',
  hr: 'Učitavanje demo zapisa…',
};

const roleNote = {
  en: 'This is the municipal staff view of the shared records: accept responsibility, then file a commitment. Independent review clears it before anything is published; this office cannot publish or set a terminal status.',
  hr: 'Ovo je prikaz zajedničkih zapisa za gradsku upravu: preuzmite odgovornost, zatim podnesite obvezu. Neovisna provjera prihvaća je prije bilo kakve objave; ovaj ured ne može objaviti niti odrediti konačni status.',
};

const provenance = {
  en: `Seeded from fixture ${seedFixtureId}. Sources:`,
  hr: `Popunjeno iz primjera ${seedFixtureId}. Izvori:`,
};

const provenanceLink = { en: 'Transparency', hr: 'Transparentnost' };
---

<Base
  lang="hr"
  chrome="demo"
  title="Polis — Official demo surface"
  description="The municipal staff queue of the demo records: accept responsibility and file a commitment that independent review must clear."
>
  <DemoShell surface="official">
    <article class="queue" id="public-record">
      <header class="queue-lead">
        <h1 class="queue-title">
          <span data-lang="en" hidden>{headings.page.en}</span>
          <span data-lang="hr">{headings.page.hr}</span>
        </h1>
        <p class="demo-anchor">
          <span data-lang="en" hidden>{institutionAnchor.en}</span>
          <span data-lang="hr">{institutionAnchor.hr}</span>
        </p>
      </header>

      <noscript>
        <p class="queue-noscript">
          <span data-lang="en" hidden>{noscriptCopy.en}</span>
          <span data-lang="hr">{noscriptCopy.hr}</span>
        </p>
      </noscript>

      <div class="queue-grid">
        <nav class="queue-rail" aria-label={headings.rail.hr} data-rail>
          <ul class="queue-buckets" data-buckets></ul>
        </nav>

        <section class="queue-ledger" aria-labelledby="queue-ledger-title">
          <h2 class="queue-column-title" id="queue-ledger-title">
            <span data-lang="en" hidden>{headings.ledger.en}</span>
            <span data-lang="hr">{headings.ledger.hr}</span>
          </h2>
          <p class="queue-loading" data-loading>
            <span data-lang="en" hidden>{loadingCopy.en}</span>
            <span data-lang="hr">{loadingCopy.hr}</span>
          </p>
          <p class="queue-status" role="status" tabindex="-1" data-status></p>
          <ul class="demo-ledger" data-ledger></ul>
        </section>

        <section class="queue-detail" aria-labelledby="queue-detail-title" data-detail-column>
          <h2 class="queue-column-title" id="queue-detail-title">
            <span data-lang="en" hidden>{headings.detail.en}</span>
            <span data-lang="hr">{headings.detail.hr}</span>
          </h2>
          <div data-detail></div>
        </section>
      </div>

      <footer class="queue-foot">
        <p class="queue-role-note">
          <span data-lang="en" hidden>{roleNote.en}</span>
          <span data-lang="hr">{roleNote.hr}</span>
        </p>
        <p class="queue-provenance">
          <span data-lang="en" hidden>{provenance.en}</span>
          <span data-lang="hr">{provenance.hr}</span>{' '}
          <a href="/transparency">
            <span data-lang="en" hidden>{provenanceLink.en}</span>
            <span data-lang="hr">{provenanceLink.hr}</span>
          </a>
        </p>
      </footer>
    </article>
  </DemoShell>
</Base>


