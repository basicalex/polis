---
/**
 * `/demo/official` — the municipal staff queue over the shared demo store.
 *
 * Queue idiom: a status-bucket rail with live counts, a ledger of records newest first, and a
 * detail panel carrying the trace timeline plus only the actions this role may take. Static
 * chrome renders both languages as `data-lang` siblings (EN visible without JavaScript); the
 * queue itself is client-rendered from the demo store and re-renders on every store
 * notification, cross-tab ones included.
 *
 * The meaning model is not negotiable here: this office can accept responsibility and file a
 * commitment, and nothing else. A filed commitment starts PENDING REVIEW and only the independent
 * reviewer surface can publish it or set a terminal status.
 */
import Base from '../../layouts/Base.astro';
import DemoShell from '../../components/demo/DemoShell.astro';
import { seedFixtureId } from '../../content/demo-fixtures.mjs';
import { institutionAnchor } from '../../content/demo-strings.mjs';

const headings = {
  page: { en: 'Official inbox', hr: 'Pristigli zapisi' },
  rail: { en: 'Filter by status', hr: 'Filtriraj po statusu' },
  ledger: { en: 'Inbox — newest first', hr: 'Pristiglo — najnovije prvo' },
  detail: { en: 'Selected record', hr: 'Odabrani zapis' },
};

const noscriptCopy = {
  en: 'This surface needs JavaScript: the demo records live in your browser, not on a server.',
  hr: 'Ovaj prikaz treba JavaScript: demo zapisi pohranjeni su u vašem pregledniku, a ne na poslužitelju.',
};

const loadingCopy = {
  en: 'Loading demo records…',
  hr: 'Učitavanje demo zapisa…',
};

const roleNote = {
  en: 'This is the municipal staff view of the shared records: accept responsibility, then file a commitment. Independent review clears it before anything is published; this office cannot publish or set a terminal status.',
  hr: 'Ovo je prikaz zajedničkih zapisa za gradsku upravu: preuzmite odgovornost, zatim podnesite obvezu. Neovisna provjera prihvaća je prije bilo kakve objave; ovaj ured ne može objaviti niti odrediti konačni status.',
};

const provenance = {
  en: `Seeded from fixture ${seedFixtureId}. Sources:`,
  hr: `Popunjeno iz primjera ${seedFixtureId}. Izvori:`,
};

const provenanceLink = { en: 'Transparency', hr: 'Transparentnost' };
---

<Base
  lang="en"
  chrome="demo"
  title="Polis — Official demo surface"
  description="The municipal staff queue of the demo records: accept responsibility and file a commitment that independent review must clear."
>
  <DemoShell surface="official">
    <article class="queue" id="public-record">
      <header class="queue-lead">
        <h1 class="queue-title">
          <span data-lang="en">{headings.page.en}</span>
          <span data-lang="hr" hidden>{headings.page.hr}</span>
        </h1>
        <p class="demo-anchor">
          <span data-lang="en">{institutionAnchor.en}</span>
          <span data-lang="hr" hidden>{institutionAnchor.hr}</span>
        </p>
      </header>

      <noscript>
        <p class="queue-noscript">
          <span data-lang="en">{noscriptCopy.en}</span>
          <span data-lang="hr" hidden>{noscriptCopy.hr}</span>
        </p>
      </noscript>

      <div class="queue-grid">
        <nav class="queue-rail" aria-label={headings.rail.en} data-rail>
          <ul class="queue-buckets" data-buckets></ul>
        </nav>

        <section class="queue-ledger" aria-labelledby="queue-ledger-title">
          <h2 class="queue-column-title" id="queue-ledger-title">
            <span data-lang="en">{headings.ledger.en}</span>
            <span data-lang="hr" hidden>{headings.ledger.hr}</span>
          </h2>
          <p class="queue-loading" data-loading>
            <span data-lang="en">{loadingCopy.en}</span>
            <span data-lang="hr" hidden>{loadingCopy.hr}</span>
          </p>
          <p class="queue-status" role="status" data-status></p>
          <ul class="demo-ledger" data-ledger></ul>
        </section>

        <section class="queue-detail" aria-labelledby="queue-detail-title" data-detail-column>
          <h2 class="queue-column-title" id="queue-detail-title">
            <span data-lang="en">{headings.detail.en}</span>
            <span data-lang="hr" hidden>{headings.detail.hr}</span>
          </h2>
          <div data-detail></div>
        </section>
      </div>

      <footer class="queue-foot">
        <p class="queue-role-note">
          <span data-lang="en">{roleNote.en}</span>
          <span data-lang="hr" hidden>{roleNote.hr}</span>
        </p>
        <p class="queue-provenance">
          <span data-lang="en">{provenance.en}</span>
          <span data-lang="hr" hidden>{provenance.hr}</span>{' '}
          <a href="/transparency">
            <span data-lang="en">{provenanceLink.en}</span>
            <span data-lang="hr" hidden>{provenanceLink.hr}</span>
          </a>
        </p>
      </footer>
    </article>
  </DemoShell>
</Base>

<style>
  .queue {
    display: grid;
    gap: var(--space-md);
    min-width: 0;
    max-width: 74rem;
  }

  .queue-lead {
    display: grid;
    gap: var(--space-xs);
    min-width: 0;
  }

  .queue-title {
    margin: 0;
    font-family: var(--display);
    font-size: var(--type-heading-sm);
    line-height: 1.15;
  }

  .queue-noscript {
    max-width: 68ch;
    margin: 0;
    padding: var(--space-sm);
    background: var(--polis-surface-tint);
    color: var(--polis-text);
    font-size: var(--type-data);
  }

  .queue-grid {
    display: grid;
    gap: var(--space-md);
    min-width: 0;
    align-items: start;
  }

  @media (min-width: 56.25rem) {
    .queue-grid {
      grid-template-columns: minmax(0, 15rem) minmax(0, 1fr) minmax(0, 24rem);
      gap: var(--space-lg);
    }
  }

  /* Rail: a vertical bucket list on desktop, a horizontal chip row below 56.25rem. */
  .queue-rail {
    min-width: 0;
  }

  .queue-buckets {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    min-width: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 56.25rem) {
    .queue-buckets {
      display: grid;
      gap: 0;
    }
  }

  .queue-column-title {
    margin: 0 0 var(--space-sm);
    padding-bottom: var(--space-xs);
    border-bottom: 1px solid var(--polis-border);
    color: var(--polis-muted);
    font-family: var(--body);
    font-size: var(--type-data);
    font-weight: 600;
    letter-spacing: 0.06em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .queue-loading,
  .queue-status {
    margin: 0 0 var(--space-sm);
    color: var(--polis-muted);
    font-size: var(--type-data);
    line-height: 1.5;
  }

  .queue-status {
    color: var(--polis-text);
  }

  .queue-status:empty,
  .queue-loading[hidden] {
    display: none;
  }

  .queue-status a {
    color: var(--polis-trace);
  }

  .queue-detail {
    display: grid;
    min-width: 0;
  }

  .queue-detail[hidden] {
    display: none;
  }

  .queue-foot {
    display: grid;
    gap: var(--space-xs);
    max-width: 68ch;
    min-width: 0;
    padding-top: var(--space-md);
    border-top: 1px solid var(--polis-border);
  }

  .queue-role-note {
    margin: 0;
    color: var(--polis-text);
    font-size: var(--type-data);
    line-height: 1.55;
  }

  .queue-provenance {
    margin: 0;
    color: var(--polis-muted);
    font-size: var(--type-data);
  }

  .queue-provenance a {
    color: var(--polis-trace);
  }

  /*
   * Everything below is built by the page script, so Astro cannot stamp it with the scope
   * attribute. It stays inside this page's scope through the `.queue-grid` ancestor, which is
   * an ancestor of the detail panel in both placements (own column on desktop, inside the
   * selected ledger row below 56.25rem).
   */
  .queue-grid :global(.queue-bucket) {
    min-width: 0;
    width: 100%;
    min-height: var(--tap-target);
    display: flex;
    align-items: center;
    gap: var(--space-xs) var(--space-sm);
    padding: var(--space-xs) var(--space-sm);
    border: 1px solid var(--polis-border-strong);
    border-radius: var(--radius-sm);
    background: var(--polis-surface);
    color: var(--polis-text);
    font-family: var(--body);
    font-size: 0.9375rem;
    font-weight: 600;
    text-align: start;
    cursor: pointer;
  }

  .queue-grid :global(.queue-bucket:hover) {
    background: var(--polis-surface-tint);
  }

  .queue-grid :global(.queue-bucket[aria-pressed='true']) {
    border-color: var(--polis-trace);
    color: var(--polis-trace);
  }

  .queue-grid :global(.queue-bucket-count) {
    margin-left: auto;
    color: var(--polis-muted);
    font-family: var(--mono);
    font-size: var(--type-data);
  }

  .queue-grid :global(.queue-bucket[aria-pressed='true'] .queue-bucket-count) {
    color: var(--polis-trace);
  }

  @media (min-width: 56.25rem) {
    .queue-grid :global(.queue-bucket) {
      border: 0;
      border-bottom: 1px solid var(--polis-border);
      border-left: 0.1875rem solid transparent;
      border-radius: 0;
      background: transparent;
    }

    .queue-grid :global(.queue-bucket[aria-pressed='true']) {
      border-left-color: var(--polis-trace);
      background: var(--polis-surface-tint);
    }
  }

  .queue-grid :global(.queue-empty) {
    max-width: 68ch;
    margin: 0;
    padding: var(--space-sm) 0;
    color: var(--polis-muted);
    font-size: var(--type-data);
    line-height: 1.5;
  }

  .queue-grid :global(.queue-empty a) {
    color: var(--polis-trace);
  }

  .queue-grid :global(.queue-detail-card) {
    display: grid;
    gap: var(--space-sm);
    min-width: 0;
  }

  @media (max-width: 56.24rem) {
    .queue-grid :global(.queue-detail-card) {
      margin: 0 0 var(--space-sm) var(--space-sm);
    }
  }

  .queue-grid :global(.queue-detail-id) {
    color: var(--polis-muted);
    font-family: var(--mono);
    font-size: var(--type-data);
    overflow-wrap: anywhere;
  }

  .queue-grid :global(.queue-detail-subject) {
    margin: 0;
    font-family: var(--display);
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.2;
  }

  .queue-grid :global(.queue-detail-head) {
    display: grid;
    gap: 0.2rem;
    min-width: 0;
  }

  .queue-grid :global(.queue-detail-stamps) {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    min-width: 0;
    margin-top: 0.2rem;
  }

  .queue-grid :global(.queue-fields) {
    display: grid;
    grid-template-columns: minmax(0, 9rem) minmax(0, 1fr);
    gap: 0.2rem var(--space-sm);
    min-width: 0;
    margin: 0;
    font-size: var(--type-data);
    line-height: 1.5;
  }

  .queue-grid :global(.queue-fields dt) {
    color: var(--polis-muted);
    font-weight: 600;
  }

  .queue-grid :global(.queue-fields dd) {
    min-width: 0;
    margin: 0;
    overflow-wrap: anywhere;
  }

  .queue-grid :global(.queue-note) {
    margin: 0;
    color: var(--polis-muted);
    font-size: var(--type-data);
    line-height: 1.5;
  }

  .queue-grid :global(.queue-returned) {
    display: grid;
    gap: 0.2rem;
    min-width: 0;
    padding: var(--space-sm);
    background: var(--polis-surface-tint);
    border-radius: var(--radius-sm);
    font-size: var(--type-data);
    line-height: 1.5;
  }

  .queue-grid :global(.queue-returned-label) {
    color: var(--polis-warning);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .queue-grid :global(.queue-form) {
    display: grid;
    gap: var(--space-sm);
    min-width: 0;
    margin: 0;
    padding-top: var(--space-sm);
    border-top: 1px solid var(--polis-border);
  }

  .queue-grid :global(.queue-form-title) {
    margin: 0;
    font-family: var(--body);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.4;
  }

  .queue-grid :global(.queue-field) {
    display: grid;
    gap: 0.25rem;
    min-width: 0;
  }

  .queue-grid :global(.queue-field label) {
    font-size: var(--type-data);
    font-weight: 600;
  }

  .queue-grid :global(.queue-hint) {
    color: var(--polis-muted);
    font-size: var(--type-meta);
    line-height: 1.45;
  }

  .queue-grid :global(.queue-field input),
  .queue-grid :global(.queue-field textarea) {
    box-sizing: border-box;
    width: 100%;
    min-width: 0;
    min-height: var(--tap-target);
    padding: 0.5rem 0.6rem;
    border: 1px solid var(--polis-border-strong);
    border-radius: var(--radius-sm);
    background: var(--polis-surface);
    color: var(--polis-text);
    font-family: var(--body);
    font-size: 1rem;
    line-height: 1.45;
  }

  .queue-grid :global(.queue-field textarea) {
    min-height: 5.5rem;
    resize: vertical;
  }

  /* Flat buttons: solid trace fill or hairline outline. No gloss, no gradient. */
  .queue-grid :global(.queue-submit),
  .queue-grid :global(.queue-link-action) {
    min-width: 0;
    min-height: var(--tap-target);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-xs) var(--space-md);
    border: 1px solid var(--polis-trace);
    border-radius: var(--radius-sm);
    background: var(--polis-trace);
    color: var(--polis-on-primary);
    font-family: var(--body);
    font-size: 0.9375rem;
    font-weight: 600;
    text-align: center;
    text-decoration: none;
    cursor: pointer;
  }

  .queue-grid :global(.queue-link-action) {
    background: var(--polis-surface);
    color: var(--polis-trace);
  }

  .queue-grid :global(.queue-link-action:hover) {
    background: var(--polis-surface-tint);
  }

  .queue-grid :global(.queue-error) {
    margin: 0;
    color: var(--polis-danger);
    font-size: var(--type-data);
    line-height: 1.5;
  }

  @media (max-width: 40rem) {
    .queue-grid :global(.queue-fields) {
      grid-template-columns: minmax(0, 1fr);
    }

    .queue-grid :global(.queue-fields dd) {
      margin-bottom: var(--space-xs);
    }
  }
</style>

<script>
  import {
    DEMO_STAGES,
    assignResponsibility,
    fileCommitment,
    getState,
    subscribe,
  } from '../../lib/demo-store.mjs';
  import {
    compactQuery,
    currentValue,
    el,
    fieldKey,
    formatDate,
    matchesBucket,
    messageOf,
    renderBuckets,
    renderRow,
    renderTrace,
    stamp,
    text,
    wireQueue,
  } from '../../lib/demo-queue.mjs';
  import {
    categoryLabels,
    institutionAnchor,
    originLabels,
    stageLabels,
    stampLabels,
    statusLabels,
  } from '../../content/demo-strings.mjs';
  import { seedRecords } from '../../content/demo-fixtures.mjs';

  type Lang = 'en' | 'hr';
  type Localized = { en: string; hr: string };
  type DisplayValue = string | Localized | null | undefined;
  type DemoRecord = ReturnType<typeof getState>['records'][number];
  type Status = DemoRecord['status'];

  const copy = {
    buckets: {
      all: { en: 'All', hr: 'Sve' },
      open: { en: 'New', hr: 'Novo' },
      assigned: { en: 'Assigned', hr: 'Dodijeljeno' },
      pending: { en: 'Pending review', hr: 'Čeka neovisnu provjeru' },
      returned: { en: 'Returned', hr: 'Vraćeno' },
      published: { en: 'Published', hr: 'Objavljeno' },
    },
    /* Short ink-stamp words, shared with every other demo surface. The sentence form for a
       returned record is `returnedLabel`, in the return block below the trace. */
    stamps: {
      open: stampLabels.open,
      assigned: stampLabels.assigned,
      pending: stampLabels['commitment-pending-review'],
      returned: stampLabels.returned,
      published: stampLabels.published,
    },
    stageNotes: {
      responsibility: { en: 'No responsible office yet', hr: 'Još nema nadležnog ureda' },
      response: { en: 'No commitment filed', hr: 'Obveza nije podnesena' },
      check: {
        en: 'Independent review has not decided',
        hr: 'Neovisna provjera nije odlučila',
      },
      receipt: { en: 'Nothing published', hr: 'Ništa nije objavljeno' },
    },
    officeLabel: { en: 'Responsible office', hr: 'Nadležni ured' },
    roleLabel: { en: 'Responsible role', hr: 'Nadležna funkcija' },
    commitmentLabel: { en: 'Commitment', hr: 'Obveza' },
    dueLabel: { en: 'Due date', hr: 'Rok' },
    filedByLabel: { en: 'Filed by', hr: 'Podnositelj' },
    categoryLabel: { en: 'Category', hr: 'Kategorija' },
    filedOnLabel: { en: 'Filed', hr: 'Podneseno' },
    acceptTitle: { en: 'Accept responsibility', hr: 'Preuzmi odgovornost' },
    assignAction: { en: 'Accept responsibility', hr: 'Preuzmi odgovornost' },
    assignHint: {
      en: 'Naming the office is a public event. It does not answer the report yet.',
      hr: 'Imenovanje ureda javni je događaj. Time na prijavu još nije odgovoreno.',
    },
    assignedNotice: {
      en: 'Responsibility accepted on {id}. File a commitment next.',
      hr: 'Odgovornost je preuzeta za {id}. Sljedeći je korak podnošenje obveze.',
    },
    fileTitle: { en: 'File a commitment', hr: 'Podnesi obvezu' },
    refileTitle: { en: 'File a corrected commitment', hr: 'Podnesi ispravljenu obvezu' },
    commitmentHint: {
      en: 'State what this office will do and what will be published when it is done.',
      hr: 'Navedite što će ovaj ured učiniti i što će biti objavljeno kada to bude gotovo.',
    },
    dueHint: { en: 'Filed as YYYY-MM-DD.', hr: 'Podnosi se kao GGGG-MM-DD.' },
    fileAction: { en: 'File commitment', hr: 'Podnesi obvezu' },
    gateLine: {
      en: 'A filed commitment starts PENDING REVIEW. Publication needs independent review; this office cannot publish it.',
      hr: 'Podnesena obveza kreće kao ČEKA NEOVISNU PROVJERU. Objava traži neovisnu provjeru; ovaj ured ne može objaviti.',
    },
    filedNotice: {
      en: 'Commitment filed on {id}. Publication needs independent review.',
      hr: 'Obveza je podnesena za {id}. Objava traži neovisnu provjeru.',
    },
    withReviewer: {
      en: 'No action here: the record is with the independent reviewer. This office cannot publish it or set a terminal status.',
      hr: 'Ovdje nema radnje: zapis je kod neovisnog provjeritelja. Ovaj ured ne može objaviti niti odrediti konačni status.',
    },
    publishedLine: {
      en: 'Terminal status was set by independent review, not by this office.',
      hr: 'Konačni status odredila je neovisna provjera, a ne ovaj ured.',
    },
    returnedLabel: {
      en: 'Returned by independent review',
      hr: 'Vraćeno s neovisne provjere',
    },
    returnedLine: {
      en: 'Read the return note, then file a corrected commitment.',
      hr: 'Pročitajte bilješku o vraćanju, zatim podnesite ispravljenu obvezu.',
    },
    reviewerField: { en: 'Reviewer', hr: 'Provjeritelj' },
    openRecord: { en: 'View full record', hr: 'Otvori cijeli zapis' },
    emptyBucket: {
      en: 'No record in this bucket.',
      hr: 'U ovoj skupini nema zapisa.',
    },
    emptyAll: {
      en: 'No records yet. File one on the citizen surface:',
      hr: 'Još nema zapisa. Podnesite prvi na prikazu za građane:',
    },
    emptyLink: { en: 'Citizen surface', hr: 'Prikaz za građane' },
    nothingSelected: {
      en: 'Select a record to see its trace and the actions this office may take.',
      hr: 'Odaberite zapis kako biste vidjeli njegov trag i radnje koje ovaj ured može poduzeti.',
    },
  } as const;

  /** Bucket → store status. The store's status field is the only source of truth. */
  const bucketDefs = [
    { id: 'all', statuses: null as Status[] | null, label: copy.buckets.all, always: true },
    { id: 'open', statuses: ['open'] as Status[], label: copy.buckets.open, always: true },
    {
      id: 'assigned',
      statuses: ['assigned'] as Status[],
      label: copy.buckets.assigned,
      always: true,
    },
    {
      id: 'pending',
      statuses: ['commitment-pending-review'] as Status[],
      label: copy.buckets.pending,
      always: true,
    },
    {
      id: 'returned',
      statuses: ['returned'] as Status[],
      label: copy.buckets.returned,
      always: false,
    },
    {
      id: 'published',
      statuses: ['published'] as Status[],
      label: copy.buckets.published,
      always: true,
    },
  ];

  const stampFor: Record<Status, { text: Localized; mod: string }> = {
    open: { text: copy.stamps.open, mod: 'new' },
    assigned: { text: copy.stamps.assigned, mod: 'assigned' },
    'commitment-pending-review': { text: copy.stamps.pending, mod: 'pending' },
    returned: { text: copy.stamps.returned, mod: 'returned' },
    published: { text: copy.stamps.published, mod: 'published' },
  };

  /** This surface lists every status, so the stamp map is total and needs no fallback. */
  const renderStamp = (status: string, lang: Lang): HTMLSpanElement =>
    stamp(stampFor, status, lang);

  const traceOptions = {
    stages: DEMO_STAGES,
    stageLabels,
    stageNotes: copy.stageNotes,
    pendingLabel: statusLabels.pendingReview,
  };

  const seedResponsibility =
    seedRecords.find((entry) => entry.id === 'POLIS-D-0001')?.responsibility ?? null;
  const defaultOffice: DisplayValue = seedResponsibility ? seedResponsibility.office : '';
  const defaultRole: DisplayValue = seedResponsibility ? seedResponsibility.role : '';

  const rail = document.querySelector('[data-rail]');
  const bucketList = document.querySelector('[data-buckets]');
  const ledger = document.querySelector('[data-ledger]');
  const detailColumn = document.querySelector('[data-detail-column]');
  const detailSlot = document.querySelector('[data-detail]');
  const loading = document.querySelector('[data-loading]');
  const statusRegion = document.querySelector('[data-status]');

  /** Which bucket filters the ledger. Local to this tab; the store holds records, not view state. */
  let bucket = 'all';
  /** Which record the detail panel shows. Local to this tab. */
  let selectedId: string | null = null;
  /** Values the visitor typed, kept across re-renders (a cross-tab update must not wipe a form). */
  const formValues = new Map<string, string>();
  /** Store errors, by record id. */
  const errors = new Map<string, Localized>();
  /** The last completed action, announced above the ledger. */
  let notice: { id: string; text: Localized } | null = null;

  const compact = compactQuery();

  function field(
    recordId: string,
    name: string,
    labelText: string,
    kind: 'text' | 'date' | 'textarea',
    value: string,
    hint?: string,
  ): { wrap: HTMLDivElement; control: HTMLInputElement | HTMLTextAreaElement } {
    const wrap = el('div', 'queue-field');
    const id = `${recordId}-${name}`.toLowerCase();
    const label = el('label', undefined, labelText);
    label.htmlFor = id;
    const control =
      kind === 'textarea' ? document.createElement('textarea') : document.createElement('input');
    if (control instanceof HTMLInputElement) control.type = kind === 'date' ? 'date' : 'text';
    control.id = id;
    control.name = name;
    control.value = value;
    control.required = true;
    control.setAttribute('data-focus-key', fieldKey(recordId, name));
    control.addEventListener('input', () => {
      formValues.set(fieldKey(recordId, name), control.value);
    });
    wrap.append(label, control);
    if (hint) {
      const hintId = `${id}-hint`;
      const hintNode = el('span', 'queue-hint', hint);
      hintNode.id = hintId;
      control.setAttribute('aria-describedby', hintId);
      wrap.append(hintNode);
    }
    return { wrap, control };
  }

  /* --------------------------------------------------------------- detail -- */

  function detailFields(record: DemoRecord, lang: Lang): HTMLDListElement {
    const fields = el('dl', 'queue-fields');
    fields.append(
      el('dt', undefined, text(copy.categoryLabel, lang)),
      el('dd', undefined, text(categoryLabels[record.category], lang)),
      el('dt', undefined, text(copy.filedOnLabel, lang)),
      el('dd', undefined, formatDate(record.createdAt, lang)),
    );
    if (record.responsibility) {
      fields.append(
        el('dt', undefined, text(copy.officeLabel, lang)),
        el('dd', undefined, text(record.responsibility.office, lang)),
        el('dt', undefined, text(copy.roleLabel, lang)),
        el('dd', undefined, text(record.responsibility.role, lang)),
      );
    }
    if (record.commitment) {
      fields.append(
        el('dt', undefined, text(copy.commitmentLabel, lang)),
        el('dd', undefined, text(record.commitment.text, lang)),
        el('dt', undefined, text(copy.dueLabel, lang)),
        el('dd', undefined, formatDate(record.commitment.due, lang)),
        el('dt', undefined, text(copy.filedByLabel, lang)),
        el('dd', undefined, text(record.commitment.filedBy, lang)),
      );
    }
    return fields;
  }

  function assignForm(record: DemoRecord, lang: Lang): HTMLFormElement {
    const form = el('form', 'queue-form');
    form.append(el('h3', 'queue-form-title', text(copy.acceptTitle, lang)));
    const office = field(
      record.id,
      'office',
      text(copy.officeLabel, lang),
      'text',
      currentValue(formValues, record.id, 'office', text(defaultOffice, lang)),
    );
    const role = field(
      record.id,
      'role',
      text(copy.roleLabel, lang),
      'text',
      currentValue(formValues, record.id, 'role', text(defaultRole, lang)),
      text(copy.assignHint, lang),
    );
    const submit = el('button', 'queue-submit', text(copy.assignAction, lang));
    submit.type = 'submit';
    submit.setAttribute('data-focus-key', fieldKey(record.id, 'submit'));
    form.append(office.wrap, role.wrap, submit);

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      try {
        errors.delete(record.id);
        assignResponsibility(record.id, {
          office: office.control.value,
          role: role.control.value,
        });
        formValues.delete(fieldKey(record.id, 'office'));
        formValues.delete(fieldKey(record.id, 'role'));
        notice = { id: record.id, text: copy.assignedNotice };
      } catch (error) {
        errors.set(record.id, messageOf(error));
      }
      render();
    });
    return form;
  }

  function commitmentForm(record: DemoRecord, lang: Lang): HTMLFormElement {
    const form = el('form', 'queue-form');
    form.append(
      el(
        'h3',
        'queue-form-title',
        text(record.status === 'returned' ? copy.refileTitle : copy.fileTitle, lang),
      ),
    );
    const commitment = field(
      record.id,
      'commitment',
      text(copy.commitmentLabel, lang),
      'textarea',
      currentValue(formValues, record.id, 'commitment', ''),
      text(copy.commitmentHint, lang),
    );
    const due = field(
      record.id,
      'due',
      text(copy.dueLabel, lang),
      'date',
      currentValue(formValues, record.id, 'due', ''),
      text(copy.dueHint, lang),
    );
    const filedBy = field(
      record.id,
      'filedby',
      text(copy.filedByLabel, lang),
      'text',
      currentValue(
        formValues,
        record.id,
        'filedby',
        text(record.responsibility ? record.responsibility.role : defaultRole, lang),
      ),
    );
    const gate = el('p', 'queue-note', text(copy.gateLine, lang));
    const submit = el('button', 'queue-submit', text(copy.fileAction, lang));
    submit.type = 'submit';
    submit.setAttribute('data-focus-key', fieldKey(record.id, 'submit'));
    form.append(commitment.wrap, due.wrap, filedBy.wrap, gate, submit);

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      try {
        errors.delete(record.id);
        fileCommitment(record.id, {
          text: commitment.control.value,
          due: due.control.value,
          filedBy: filedBy.control.value,
        });
        formValues.delete(fieldKey(record.id, 'commitment'));
        formValues.delete(fieldKey(record.id, 'due'));
        formValues.delete(fieldKey(record.id, 'filedby'));
        notice = { id: record.id, text: copy.filedNotice };
      } catch (error) {
        errors.set(record.id, messageOf(error));
      }
      render();
    });
    return form;
  }

  function renderDetail(record: DemoRecord, lang: Lang): HTMLDivElement {
    const card = el('div', 'demo-panel queue-detail-card');
    card.setAttribute('data-detail-card', record.id);

    const head = el('div', 'queue-detail-head');
    head.append(el('span', 'queue-detail-id', record.id));
    head.append(el('h3', 'queue-detail-subject', text(record.subject, lang)));
    head.append(
      el(
        'p',
        'demo-anchor',
        `${text(institutionAnchor, lang)} · ${text(originLabels[record.origin], lang)}`,
      ),
    );
    const stamps = el('div', 'queue-detail-stamps');
    stamps.append(renderStamp(record.status, lang));
    head.append(stamps);
    card.append(head);

    card.append(detailFields(record, lang));
    card.append(renderTrace(record, lang, traceOptions));

    if (record.status === 'returned' && record.review) {
      const returned = el('div', 'queue-returned');
      returned.append(
        el('span', 'queue-returned-label', text(copy.returnedLabel, lang)),
        el('span', undefined, text(record.review.note, lang)),
        el(
          'span',
          undefined,
          `${text(copy.reviewerField, lang)}: ${text(record.review.reviewer, lang)}`,
        ),
        el('span', undefined, text(copy.returnedLine, lang)),
      );
      card.append(returned);
    }

    /* Only the legal actions for this role. Pending review and published carry none. */
    if (record.status === 'open') card.append(assignForm(record, lang));
    if (record.status === 'assigned' || record.status === 'returned') {
      card.append(commitmentForm(record, lang));
    }
    if (record.status === 'commitment-pending-review') {
      card.append(el('p', 'queue-note', text(copy.withReviewer, lang)));
    }
    if (record.status === 'published') {
      card.append(el('p', 'queue-note', text(copy.publishedLine, lang)));
    }

    const error = errors.get(record.id);
    if (error) {
      const node = el('p', 'queue-error', text(error, lang));
      node.setAttribute('role', 'alert');
      card.append(node);
    }

    const open = el('a', 'queue-link-action', text(copy.openRecord, lang));
    open.href = `/demo/record?id=${encodeURIComponent(record.id)}`;
    open.setAttribute('data-focus-key', fieldKey(record.id, 'open'));
    card.append(open);

    return card;
  }

  /* --------------------------------------------------------------- render -- */

  function renderNotice(lang: Lang): void {
    if (!(statusRegion instanceof HTMLElement)) return;
    if (!notice) {
      statusRegion.replaceChildren();
      return;
    }
    statusRegion.textContent = text(notice.text, lang).replace('{id}', notice.id);
  }

  function render(): void {
    if (!(ledger instanceof HTMLElement)) return;
    const state = getState();
    const lang: Lang = state.lang === 'hr' ? 'hr' : 'en';

    const active = document.activeElement;
    const focusKey = active instanceof HTMLElement ? active.getAttribute('data-focus-key') : null;
    const selectionStart =
      active instanceof HTMLInputElement || active instanceof HTMLTextAreaElement
        ? active.selectionStart
        : null;

    const records = [...state.records].sort(
      (a, b) => b.createdAt.localeCompare(a.createdAt) || b.id.localeCompare(a.id),
    );

    renderBuckets(bucketList, records, lang, {
      bucketDefs,
      activeBucket: bucket,
      onSelect: (id) => {
        bucket = id;
        render();
      },
    });

    const visible = records.filter((record) => matchesBucket(record, bucket, bucketDefs));
    if (selectedId && !visible.some((record) => record.id === selectedId)) selectedId = null;
    if (!selectedId && visible.length > 0) selectedId = visible[0].id;

    const selected = visible.find((record) => record.id === selectedId) ?? null;
    const narrow = compact ? compact.matches : false;
    const card = selected ? renderDetail(selected, lang) : null;

    if (visible.length === 0) {
      const empty = el('li');
      const line = el('p', 'queue-empty');
      if (records.length === 0) {
        const link = el('a', undefined, text(copy.emptyLink, lang));
        link.href = '/demo/citizen';
        line.append(`${text(copy.emptyAll, lang)} `, link);
      } else {
        line.textContent = text(copy.emptyBucket, lang);
      }
      empty.append(line);
      ledger.replaceChildren(empty);
    } else {
      ledger.replaceChildren(
        ...visible.map((record) => {
          const row = renderRow(record, lang, {
            selected: record.id === selectedId,
            categoryLabels,
            stamp: renderStamp,
            onSelect: (picked) => {
              selectedId = picked.id;
              render();
            },
          });
          if (narrow && card && record.id === selectedId) row.append(card);
          return row;
        }),
      );
    }

    if (detailSlot instanceof HTMLElement) {
      if (narrow) detailSlot.replaceChildren();
      else if (card) detailSlot.replaceChildren(card);
      else detailSlot.replaceChildren(el('p', 'queue-empty', text(copy.nothingSelected, lang)));
    }
    if (detailColumn instanceof HTMLElement) detailColumn.hidden = narrow;
    if (rail instanceof HTMLElement) {
      rail.setAttribute(
        'aria-label',
        lang === 'hr' ? 'Filtriraj po statusu' : 'Filter by status',
      );
    }

    renderNotice(lang);
    if (loading instanceof HTMLElement) loading.hidden = true;

    if (focusKey) {
      const restored = document.querySelector(
        `.queue-grid [data-focus-key="${CSS.escape(focusKey)}"]`,
      );
      if (restored instanceof HTMLElement) {
        restored.focus({ preventScroll: true });
        if (
          selectionStart !== null &&
          (restored instanceof HTMLInputElement || restored instanceof HTMLTextAreaElement)
        ) {
          try {
            restored.setSelectionRange(selectionStart, selectionStart);
          } catch {
            /* number and date inputs refuse selection ranges */
          }
        }
      }
    }
  }

  wireQueue({ subscribe, compact, render });
</script>
