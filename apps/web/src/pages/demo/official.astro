      statuses: ['returned'] as Status[],
      label: copy.buckets.returned,
      always: false,
    },
    {
      id: 'published',
      statuses: ['published'] as Status[],
      label: copy.buckets.published,
      always: true,
    },
  ];

  const stampFor: Record<Status, { text: Localized; mod: string }> = {
    open: { text: copy.stamps.open, mod: 'new' },
    assigned: { text: copy.stamps.assigned, mod: 'assigned' },
    'commitment-pending-review': { text: copy.stamps.pending, mod: 'pending' },
    returned: { text: copy.stamps.returned, mod: 'returned' },
    published: { text: copy.stamps.published, mod: 'published' },
  };

  /** This surface lists every status, so the stamp map is total and needs no fallback. */
  const renderStamp = (status: string, lang: Lang): HTMLSpanElement =>
    stamp(stampFor, status, lang);

  const traceOptions = {
    stages: DEMO_STAGES,
    stageLabels,
    stageNotes: copy.stageNotes,
    pendingLabel: statusLabels.pendingReview,
  };

  const seedResponsibility =
    seedRecords.find((entry) => entry.id === 'POLIS-D-0001')?.responsibility ?? null;
  const defaultOffice: DisplayValue = seedResponsibility ? seedResponsibility.office : '';
  const defaultRole: DisplayValue = seedResponsibility ? seedResponsibility.role : '';

  const rail = document.querySelector('[data-rail]');
  const bucketList = document.querySelector('[data-buckets]');
  const ledger = document.querySelector('[data-ledger]');
  const detailColumn = document.querySelector('[data-detail-column]');
  const detailSlot = document.querySelector('[data-detail]');
  const loading = document.querySelector('[data-loading]');
  const statusRegion = document.querySelector('[data-status]');

  /** Which bucket filters the ledger. Local to this tab; the store holds records, not view state. */
  let bucket = 'all';
  /** Which record the detail panel shows. Local to this tab. */
  let selectedId: string | null = null;
  /** Values the visitor typed, kept across re-renders (a cross-tab update must not wipe a form). */
  const formValues = new Map<string, string>();
  /** Store errors, by record id. */
  const errors = new Map<string, Localized>();
  /** Inline field errors, by `fieldKey(recordId, name)`. */
  const fieldErrors = new Map<string, Localized>();
  /** The last completed action, announced above the ledger with its state word. */
  let notice: { id: string; text: Localized; label: Localized; tone: string } | null = null;

  const compact = compactQuery();

  /**
   * One field on the shared `.field` recipe: label, hint, control, inline error.
   * The error text sits under the control it belongs to (rules I5, I6, S2).
   */
  function field(
    recordId: string,
    name: string,
    labelText: string,
    kind: 'text' | 'date' | 'textarea',
    value: string,
    hint?: string,
  ): { wrap: HTMLDivElement; control: HTMLInputElement | HTMLTextAreaElement } {
    const wrap = el('div', 'field');
    const id = `${recordId}-${name}`.toLowerCase();
    const key = fieldKey(recordId, name);
    const label = el('label', undefined, labelText);
    label.htmlFor = id;
    const control =
      kind === 'textarea' ? document.createElement('textarea') : document.createElement('input');
    if (control instanceof HTMLInputElement) control.type = kind === 'date' ? 'date' : 'text';
    control.id = id;
    control.name = name;
    control.value = value;
    control.required = true;
    control.setAttribute('data-focus-key', key);
    control.addEventListener('input', () => {
      formValues.set(key, control.value);
    });
    wrap.append(label);
    const described: string[] = [];
    if (hint) {
      const hintId = `${id}-hint`;
      const hintNode = el('p', 'field-hint', hint);
      hintNode.id = hintId;
      described.push(hintId);
      wrap.append(hintNode);
    }
    wrap.append(control);
    const problem = fieldErrors.get(key);
    const errorId = `${id}-error`;
    const errorNode = el('p', 'field-error', problem ? text(problem, lang0()) : '');
    errorNode.id = errorId;
    if (problem) {
      control.setAttribute('aria-invalid', 'true');
      described.push(errorId);
    }
    wrap.append(errorNode);
    if (described.length > 0) control.setAttribute('aria-describedby', described.join(' '));
    return { wrap, control };
  }

  /** The language the store holds right now; `field()` reads it while building. */
  function lang0(): Lang {
    return getState().lang === 'hr' ? 'hr' : 'en';
  }

  /** Record an inline problem against one control. */
  function setFieldError(recordId: string, name: string, message: Localized | null): void {
    const key = fieldKey(recordId, name);
    if (message) fieldErrors.set(key, message);
    else fieldErrors.delete(key);
  }

  /** A store refusal keeps its sentence and gains the next step (rule S2). */
  function withNextStep(message: Localized): Localized {
    return {
      en: `${message.en} ${copy.storeNext.en}`,
      hr: `${message.hr} ${copy.storeNext.hr}`,
    };
  }

  /** Move focus to the first control that failed, after the card re-rendered. */
  function focusField(recordId: string, name: string): void {
    const node = document.querySelector(
      `.queue-grid [data-focus-key="${CSS.escape(fieldKey(recordId, name))}"]`,
    );
    if (node instanceof HTMLElement) node.focus();
  }

  /* --------------------------------------------------------------- detail -- */

  /**
   * Reader priority, not storage order (finding F9, rules H1, H3, H5): the
   * commitment text and its due date first — the commitment at body size, the
   * due date as the loudest datum — then the responsible office, then the
   * category and the filing date.
   */
  function detailFields(record: DemoRecord, lang: Lang): HTMLDListElement {
    const fields = el('dl', 'queue-fields');
    if (record.commitment) {
      fields.append(
        fieldRow(text(copy.commitmentLabel, lang), text(record.commitment.text, lang), 'lead'),
        fieldRow(text(copy.dueLabel, lang), formatDate(record.commitment.due, lang), 'loud'),
      );
    }
    if (record.responsibility) {
      fields.append(
        fieldRow(text(copy.officeLabel, lang), text(record.responsibility.office, lang)),
        fieldRow(text(copy.roleLabel, lang), text(record.responsibility.role, lang)),
      );
    }
    if (record.commitment) {
      fields.append(fieldRow(text(copy.filedByLabel, lang), text(record.commitment.filedBy, lang)));
    }
    fields.append(
      fieldRow(text(copy.categoryLabel, lang), text(categoryLabels[record.category], lang)),
      fieldRow(text(copy.filedOnLabel, lang), formatDate(record.createdAt, lang)),
    );
    return fields;
  }

  function assignForm(record: DemoRecord, lang: Lang): HTMLFormElement {
    const form = el('form', 'queue-form');
    form.append(
      el('h3', 'queue-form-title', text(copy.acceptTitle, lang)),
      /* The sentence describes the whole step, so it sits under the form title
         rather than under one control (rule H6). */
      el('p', 'queue-form-note', text(copy.assignHint, lang)),
    );
    const office = field(
      record.id,
      'office',
      text(copy.officeLabel, lang),
      'text',
      currentValue(formValues, record.id, 'office', text(defaultOffice, lang)),
    );
    const role = field(
      record.id,
      'role',
      text(copy.roleLabel, lang),
      'text',
      currentValue(formValues, record.id, 'role', text(defaultRole, lang)),
    );
    const submit = el('button', 'queue-submit', text(copy.assignAction, lang));
    submit.type = 'submit';
    submit.setAttribute('data-focus-key', fieldKey(record.id, 'submit'));
    form.append(office.wrap, role.wrap, submit);

    /* The page validates: its messages name the office to fill in, which the
       browser's generic bubble does not. */
    form.noValidate = true;

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const officeValue = office.control.value.trim();
      const roleValue = role.control.value.trim();
      setFieldError(record.id, 'office', officeValue ? null : copy.officeRequired);
      setFieldError(record.id, 'role', roleValue ? null : copy.roleRequired);
      const firstInvalid = !officeValue ? 'office' : !roleValue ? 'role' : null;
      if (firstInvalid) {
        errors.delete(record.id);
        render();
        focusField(record.id, firstInvalid);
        return;
      }
      try {
        errors.delete(record.id);
        assignResponsibility(record.id, { office: officeValue, role: roleValue });
        formValues.delete(fieldKey(record.id, 'office'));
        formValues.delete(fieldKey(record.id, 'role'));
        notice = {
          id: record.id,
          text: copy.assignedNotice,
          label: copy.stamps.assigned,
          tone: 'trace',
        };
      } catch (error) {
        errors.set(record.id, withNextStep(messageOf(error)));
      }
      render();
      focusNotice();
    });
    return form;
  }

  function commitmentForm(record: DemoRecord, lang: Lang): HTMLFormElement {
    const form = el('form', 'queue-form');
    form.append(
      el(
        'h3',
        'queue-form-title',
        text(record.status === 'returned' ? copy.refileTitle : copy.fileTitle, lang),
      ),
    );
    const commitment = field(
      record.id,
      'commitment',
      text(copy.commitmentLabel, lang),
      'textarea',
      currentValue(formValues, record.id, 'commitment', ''),
      text(copy.commitmentHint, lang),
    );
    const due = field(
      record.id,
      'due',
      text(copy.dueLabel, lang),
      'date',
      currentValue(formValues, record.id, 'due', ''),
      text(copy.dueHint, lang),
    );
    const filedBy = field(
      record.id,
      'filedby',
      text(copy.filedByLabel, lang),
      'text',
      currentValue(
        formValues,
        record.id,
        'filedby',
        text(record.responsibility ? record.responsibility.role : defaultRole, lang),
      ),
    );
    const gate = el('p', 'queue-note', text(copy.gateLine, lang));
    const submit = el('button', 'queue-submit', text(copy.fileAction, lang));
    submit.type = 'submit';
    submit.setAttribute('data-focus-key', fieldKey(record.id, 'submit'));
    form.append(commitment.wrap, due.wrap, filedBy.wrap, gate, submit);

    form.noValidate = true;

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const commitmentValue = commitment.control.value.trim();
      const dueValue = due.control.value.trim();
      const filedByValue = filedBy.control.value.trim();
      const dueProblem = !dueValue
        ? copy.dueRequired
        : /^\d{4}-\d{2}-\d{2}$/.test(dueValue)
          ? null
          : copy.dueFormat;
      setFieldError(record.id, 'commitment', commitmentValue ? null : copy.commitmentRequired);
      setFieldError(record.id, 'due', dueProblem);
      setFieldError(record.id, 'filedby', filedByValue ? null : copy.filedByRequired);
      const firstInvalid = !commitmentValue
        ? 'commitment'
        : dueProblem
          ? 'due'
          : !filedByValue
            ? 'filedby'
            : null;
      if (firstInvalid) {
        errors.delete(record.id);
        render();
        focusField(record.id, firstInvalid);
        return;
      }
      try {
        errors.delete(record.id);
        fileCommitment(record.id, {
          text: commitmentValue,
          due: dueValue,
          filedBy: filedByValue,
        });
        formValues.delete(fieldKey(record.id, 'commitment'));
        formValues.delete(fieldKey(record.id, 'due'));
        formValues.delete(fieldKey(record.id, 'filedby'));
        notice = {
          id: record.id,
          text: copy.filedNotice,
          label: copy.stamps.pending,
          tone: 'warning',
        };
      } catch (error) {
        errors.set(record.id, withNextStep(messageOf(error)));
      }
      render();
      focusNotice();
    });
    return form;
  }

  /**
   * The detail panel, in three groups: what the record says, its trace, and the
   * one action this office may take next. Whitespace and a hairline separate
   * them; nothing is a bordered panel inside a bordered panel (rules H7, D5).
   */
  function renderDetail(record: DemoRecord, lang: Lang): HTMLDivElement {
    const card = el('div', 'demo-panel queue-detail-card');
    card.setAttribute('data-detail-card', record.id);

    const head = el('div', 'queue-detail-head');
    head.append(el('span', 'queue-detail-id', record.id));
    head.append(el('h3', 'queue-detail-subject', text(record.subject, lang)));
    head.append(
      el(
        'p',
        'demo-anchor',
        `${text(institutionAnchor, lang)} · ${text(originLabels[record.origin], lang)}`,
      ),
    );
    const stamps = el('div', 'queue-detail-stamps');
    stamps.append(renderStamp(record.status, lang));
    head.append(stamps);
    card.append(head);

    card.append(group(text(copy.groupRecord, lang), detailFields(record, lang)));
    card.append(group(text(copy.groupTrace, lang), renderTrace(record, lang, traceOptions)));

    const action = el('section', 'demo-group');
    action.append(el('h4', 'demo-group-title', text(copy.groupAction, lang)));

    if (record.status === 'returned' && record.review) {
      const returned = el('div', 'queue-returned');
      returned.append(
        el('span', 'queue-returned-label', text(copy.returnedLabel, lang)),
        el('span', undefined, text(record.review.note, lang)),
        el(
          'span',
          undefined,
          `${text(copy.reviewerField, lang)}: ${text(record.review.reviewer, lang)}`,
        ),
        el('span', undefined, text(copy.returnedLine, lang)),
      );
      action.append(returned);
    }

    /* Only the legal actions for this role. Pending review and published carry none. */
    if (record.status === 'open') action.append(assignForm(record, lang));
    if (record.status === 'assigned' || record.status === 'returned') {
      action.append(commitmentForm(record, lang));
    }
    if (record.status === 'commitment-pending-review') {
      action.append(el('p', 'queue-note', text(copy.withReviewer, lang)));
    }
    if (record.status === 'published') {
      action.append(el('p', 'queue-note', text(copy.publishedLine, lang)));
    }

    const error = errors.get(record.id);
    if (error) {
      const node = el('p', 'queue-error', text(error, lang));
      node.setAttribute('role', 'alert');
      action.append(node);
    }

    const open = el('a', 'btn queue-link-action', text(copy.openRecord, lang));
    open.setAttribute('data-variant', 'secondary');
    open.href = `/demo/record?id=${encodeURIComponent(record.id)}`;
    open.setAttribute('data-focus-key', fieldKey(record.id, 'open'));
    action.append(open);

    card.append(action);

    return card;
  }

  /* --------------------------------------------------------------- render -- */

  /**
   * The empty state of one bucket: what the bucket is for, up to two tips, and
   * the action that fills it where a legal one exists (rule S1).
   */
  function bucketEmptyState(bucketId: string, lang: Lang): HTMLDivElement {
    const specs: Record<string, EmptyStateSpec> = copy.empty;
    const spec = specs[bucketId] ?? specs.all;
    const action = spec.action ?? null;
    return emptyState({
      title: text(spec.title, lang),
      purpose: text(spec.purpose, lang),
      tips: spec.tips.map((tip) => text(tip, lang)),
      action: action
        ? {
            label: text(action.label, lang),
            href: action.href,
            variant: spec.primary ? 'primary' : 'tertiary',
          }
        : undefined,
    });
  }

  /**
   * A completed action destroys the form that held focus, so the outcome takes
   * it: the reader lands on the sentence saying what happened (rule S2).
   */
  function focusNotice(): void {
    if (statusRegion instanceof HTMLElement && statusRegion.textContent) statusRegion.focus();
  }

  /** The state word carries the state without colour; the sentence says what happened. */
  function renderNotice(lang: Lang): void {
    if (!(statusRegion instanceof HTMLElement)) return;
    if (!notice) {
      statusLine(statusRegion, { label: '', tone: 'trace', text: '' });
      return;
    }
    statusLine(statusRegion, {
      label: text(notice.label, lang),
      tone: notice.tone,
      text: text(notice.text, lang).replace('{id}', notice.id),
    });
  }

  function render(): void {
    if (!(ledger instanceof HTMLElement)) return;
    const state = getState();
    const lang: Lang = state.lang === 'hr' ? 'hr' : 'en';

    const active = document.activeElement;
    const focusKey = active instanceof HTMLElement ? active.getAttribute('data-focus-key') : null;
    const selectionStart =
      active instanceof HTMLInputElement || active instanceof HTMLTextAreaElement
        ? active.selectionStart
        : null;

    const records = [...state.records].sort(
      (a, b) => b.createdAt.localeCompare(a.createdAt) || b.id.localeCompare(a.id),
    );

    renderBuckets(bucketList, records, lang, {
      bucketDefs,
      activeBucket: bucket,
      onSelect: (id) => {
        bucket = id;
        render();
      },
    });

    const visible = records.filter((record) => matchesBucket(record, bucket, bucketDefs));
    if (selectedId && !visible.some((record) => record.id === selectedId)) selectedId = null;
    if (!selectedId && visible.length > 0) selectedId = visible[0].id;

    const selected = visible.find((record) => record.id === selectedId) ?? null;
    const narrow = compact ? compact.matches : false;
    const card = selected ? renderDetail(selected, lang) : null;

    if (visible.length === 0) {
      const empty = el('li');
      empty.append(bucketEmptyState(records.length === 0 ? 'all' : bucket, lang));
      ledger.replaceChildren(empty);
    } else {
      ledger.replaceChildren(
        ...visible.map((record) => {
          const row = renderRow(record, lang, {
            selected: record.id === selectedId,
            categoryLabels,
            stamp: renderStamp,
            onSelect: (picked) => {
              selectedId = picked.id;
              render();
            },
          });
          if (narrow && card && record.id === selectedId) row.append(card);
          return row;
        }),
      );
    }

    if (detailSlot instanceof HTMLElement) {
      if (narrow) detailSlot.replaceChildren();
      else if (card) detailSlot.replaceChildren(card);
      else {
        detailSlot.replaceChildren(
          emptyState({
            title: text(copy.nothingSelected.title, lang),
            purpose: text(copy.nothingSelected.purpose, lang),
          }),
        );
      }
    }
    if (detailColumn instanceof HTMLElement) detailColumn.hidden = narrow;
    if (rail instanceof HTMLElement) {
      rail.setAttribute(
        'aria-label',
        lang === 'hr' ? 'Filtriraj po statusu' : 'Filter by status',
      );
    }

    renderNotice(lang);
    if (loading instanceof HTMLElement) loading.hidden = true;

    if (focusKey) {
      const restored = document.querySelector(
        `.queue-grid [data-focus-key="${CSS.escape(focusKey)}"]`,
      );
      if (restored instanceof HTMLElement) {
        restored.focus({ preventScroll: true });
        if (
          selectionStart !== null &&
          (restored instanceof HTMLInputElement || restored instanceof HTMLTextAreaElement)
        ) {
          try {
            restored.setSelectionRange(selectionStart, selectionStart);
          } catch {
            /* number and date inputs refuse selection ranges */
          }
        }
      }
    }
  }

  wireQueue({ subscribe, compact, render });
</script>
