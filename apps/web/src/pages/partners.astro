import Base from '../layouts/Base.astro';
import EmptyState from '@polis/ui/astro/EmptyState.astro';
import '../styles/tasks.css';

type Charter = {
  partner: string;
  jurisdiction: string;
  jurisdictionName: string;
  purpose: string;
  scope: string;
  sunsetDate: string;
  successMetrics: string[];
  redactionPolicy: string;
  implementationStatus: { mocked: string[]; live: string[] };
  exitPlan: string;
};

const API = import.meta.env.PUBLIC_API_URL ?? 'http://localhost:8080';
async function fetchJson(path: string) {
  try {
    const r = await fetch(API + path);
    if (!r.ok) return null;
    return await r.json();
  } catch { return null; }
}

const charter = (await fetchJson('/api/v1/pilot/charter')) as Charter | null;
const unavailableField = 'Demonstrator data are unavailable for this field.';
---

<Base title="Simulated charter">
  <div class="task-page task-page--column">
    <header class="page-header">
      <h1>Simulated charter</h1>
      <p class="page-header-lede">
        {charter?.purpose ?? 'Demonstrator charter data are unavailable in this local run.'}
      </p>
    </header>

    <aside class="material-note" aria-labelledby="demonstrator-title">
      <h2 id="demonstrator-title">How to read this charter</h2>
      <p class="prose">
        This is a <strong>simulated complaints-process demonstrator</strong>. Its charter content is{' '}
        <strong>development trust material</strong> built from <strong>synthetic fixtures</strong>; there is{' '}
        <strong>no government integration</strong>.
      </p>
      <dl class="record-facts">
        <div>
          <dt>implemented locally</dt>
          <dd>The interface and local development flow shown on this site.</dd>
        </div>
        <div>
          <dt>mocked</dt>
          <dd>The charter entries and complaints-process content shown below.</dd>
        </div>
        <div>
          <dt>operationally accepted</dt>
          <dd>No part of this demonstrator is operationally accepted.</dd>
        </div>
      </dl>
    </aside>

    {charter && (
      <section class="task-section" aria-label="Charter development trust material">
        <p class="status-label" data-tone="warning">development trust material</p>
        <dl class="detail-list">
          <div>
            <dt>Scope</dt>
            <dd>{charter.scope}</dd>
          </div>
          <div>
            <dt>Jurisdiction</dt>
            <dd>{charter.jurisdictionName}</dd>
          </div>
          <div>
            <dt>Sunset</dt>
            <dd>{new Date(charter.sunsetDate).toLocaleDateString()}</dd>
          </div>
          <div>
            <dt>Redaction policy</dt>
            <dd>{charter.redactionPolicy}</dd>
          </div>
          <div>
            <dt>Exit plan</dt>
            <dd>{charter.exitPlan}</dd>
          </div>
        </dl>
      </section>
    )}

    {charter && (
      <section class="material-section" aria-labelledby="metrics-title">
        <h2 id="metrics-title">Success metrics</h2>
        <p class="status-label" data-tone="warning">synthetic fixtures</p>
        <ul>{charter.successMetrics.map((m) => <li>{m}</li>)}</ul>
      </section>
    )}

    {charter && (
      <section class="material-section" aria-labelledby="status-title">
        <h2 id="status-title">Implementation status</h2>
        <dl class="detail-list">
          <div>
            <dt>implemented locally</dt>
            <dd>{charter.implementationStatus.live.join(', ') || unavailableField}</dd>
          </div>
          <div>
            <dt>mocked</dt>
            <dd>{charter.implementationStatus.mocked.join(', ') || unavailableField}</dd>
          </div>
          <div>
            <dt>operationally accepted</dt>
            <dd>Not represented by this demonstrator.</dd>
          </div>
        </dl>
      </section>
    )}

    {!charter && (
      <div aria-live="polite">
        <EmptyState
          title="Demonstrator charter data are unavailable"
          purpose="This page reads the charter fixture from the local platform API, which is not answering. No charter exists anywhere else — nothing was withheld."
          tips={[
            'Start the backend from the repository root: bun run dev:services.',
            'Load the fixtures once the services are up: bun run db:seed.',
            'The charter is synthetic in every case; no partner has authorised anything.',
          ]}
          actionLabel="Return to the process map"
          actionHref="/governance/jur-croatia-local"
        />
      </div>
    )}

    <nav class="resource-links" aria-label="Demonstrator resources">
      <a href="/governance/jur-croatia-local">Process map</a>
      <a href="/transparency">Transparency</a>
      <a href="/verify">Verify</a>
      <a href="/partners">Charter</a>
      <a href="/pilot/results">Results</a>
    </nav>
  </div>
</Base>
