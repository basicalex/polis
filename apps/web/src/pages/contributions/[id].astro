---
import Base from '../../layouts/Base.astro';
import EmptyState from '@polis/ui/astro/EmptyState.astro';
import '../../styles/tasks.css';

const API = import.meta.env.PUBLIC_API_URL ?? 'http://localhost:8080';

type Review = {
  decision: string;
  reviewerId: string | null;
  notes: string | null;
  decidedAt: string;
} | null;

type Proposal = {
  id: string;
  targetTable: string;
  op: string;
  appliedAt: string | null;
  proposedPayload: unknown;
} | null;

type Submission = {
  id: string;
  contributorId: string;
  type: string;
  payload: unknown;
  status: string;
  contributionClass: string;
  submittedAt: string;
  decidedAt: string | null;
  review: Review;
  proposal: Proposal;
};

const id = Astro.params.id;
let submission: Submission | null = null;
let notFound = false;

if (id) {
  try {
    const r = await fetch(`${API}/api/v1/contributions/${id}`);
    if (r.ok) submission = (await r.json()) as Submission;
    else if (r.status === 404) notFound = true;
  } catch {
    notFound = true;
  }
}

const statusTone = (s: string) => (s === 'approved' ? 'valid' : s === 'rejected' ? 'danger' : 'warning');
---

<Base title={submission ? `Submission ${submission.id.slice(0, 8)}` : 'Submission'}>
  <div class="task-page">
    {submission ? (
      <Fragment>
        <header class="page-header record-head">
          <h1>Submission</h1>
          <p class="record-id">{submission.id}</p>
        </header>

        <dl class="record-facts">
          <div>
            <dt>Status</dt>
            <dd><span class="status-label" data-tone={statusTone(submission.status)}>{submission.status}</span></dd>
          </div>
          <div>
            <dt>Type</dt>
            <dd>{submission.type}</dd>
          </div>
          <div>
            <dt>Submitted</dt>
            <dd>{submission.submittedAt}</dd>
          </div>
          <div>
            <dt>Decided</dt>
            <dd>{submission.decidedAt ?? 'not decided'}</dd>
          </div>
        </dl>

        <dl class="detail-list">
          <div>
            <dt>Contribution class</dt>
            <dd>{submission.contributionClass}</dd>
          </div>
          <div>
            <dt>Contributor</dt>
            <dd>
              <a href={`/contributors/${submission.contributorId}`}>
                {submission.contributorId.slice(0, 12)}
              </a>
            </dd>
          </div>
        </dl>

        <section class="task-section">
          <h2>Payload</h2>
          <pre>{JSON.stringify(submission.payload, null, 2)}</pre>
        </section>

        <section class="task-section">
          <h2>Review</h2>
          {submission.review ? (
            <dl class="detail-list">
              <div>
                <dt>Decision</dt>
                <dd>
                  <span class="status-label" data-tone={statusTone(submission.review.decision)}>
                    {submission.review.decision}
                  </span>
                </dd>
              </div>
              <div>
                <dt>Reviewer</dt>
                <dd>{submission.review.reviewerId ?? 'not recorded'}</dd>
              </div>
              <div>
                <dt>Decided</dt>
                <dd>{submission.review.decidedAt}</dd>
              </div>
              {submission.review.notes && (
                <div>
                  <dt>Notes</dt>
                  <dd>{submission.review.notes}</dd>
                </div>
              )}
            </dl>
          ) : (
            <EmptyState
              headingLevel={3}
              title="Not reviewed yet"
              purpose="This submission is waiting for an independent reviewer. Nothing has been published from it."
              tips={[
                'A reviewer must be a different person from the contributor.',
                'The decision and its notes appear here once it is made.',
              ]}
            />
          )}
        </section>

        {submission.proposal && (
          <section class="task-section">
            <h2>Graph proposal</h2>
            <dl class="detail-list">
              <div>
                <dt>Target</dt>
                <dd>{submission.proposal.targetTable} · {submission.proposal.op}</dd>
              </div>
              <div>
                <dt>Applied</dt>
                <dd>{submission.proposal.appliedAt ?? 'not applied'}</dd>
              </div>
            </dl>
          </section>
        )}
      </Fragment>
    ) : (
      <Fragment>
        <header class="page-header record-head">
          <h1>Submission not found</h1>
          <p class="record-id">{id}</p>
        </header>
        <EmptyState
          title="No contribution matches this id"
          purpose={notFound
            ? 'The contribution service answered, and it holds no submission under this reference.'
            : 'The contribution service did not answer, so the submission could not be read.'}
          tips={[
            'Check the id in the address bar against the link you followed.',
            'Start the backend from the repository root: bun run dev:services.',
            'A submission link is shown right after you submit a contribution.',
          ]}
          actionLabel="Contribute evidence"
          actionHref="/contribute/evidence"
          actionVariant="primary"
        />
      </Fragment>
    )}
  </div>
</Base>
