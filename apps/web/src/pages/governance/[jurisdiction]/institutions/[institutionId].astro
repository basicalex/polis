import Base from '../../../../layouts/Base.astro';
import EmptyState from '@polis/ui/astro/EmptyState.astro';
import '../../../../styles/tasks.css';

type Role = { id: string; name: string; description: string | null; confidenceState: string; reviewState: string };
type Institution = { id: string; name: string; description: string | null; confidenceState: string; reviewState: string; roles?: Role[] };
type Evidence = { sourceId: string; quote: string | null; sourceHash: string | null; retrievedAt: string | null };
type Source = { id: string; title: string; url: string | null; publisher: string | null };
type Claim = { id: string; text: string; confidenceState: string; reviewState: string; evidence: Evidence[]; sources: Source[] };

const API = import.meta.env.PUBLIC_API_URL ?? 'http://localhost:8080';
async function fetchJson(path: string) {
  try {
    const r = await fetch(API + path);
    if (!r.ok) return null;
    return await r.json();
  } catch {
    return null;
  }
}

const slug = Astro.params.jurisdiction ?? 'jur-croatia-local';
const institutionId = Astro.params.institutionId ?? '';
const institution = (await fetchJson(`/api/v1/institutions/${encodeURIComponent(institutionId)}`)) as Institution | null;
const claims = (await fetchJson(`/api/v1/claims?subject_id=${encodeURIComponent(institutionId)}`)) as { items: Claim[] } | null;

const setupTips = [
  'Start the backend from the repository root: bun run dev:services.',
  'Load the fixtures once the services are up: bun run db:seed.',
  'Institutions, roles, and claims come from the governance graph.',
];
---

<Base title={`Institution · ${institution?.name ?? institutionId}`}>
  <div class="task-page">
    <header class="page-header record-head">
      <p class="page-header-eyebrow status-label">Institution</p>
      <h1>{institution?.name ?? 'Institution unavailable'}</h1>
      <p class="record-id">{institutionId}</p>
      {institution?.description && <p class="page-header-lede">{institution.description}</p>}
    </header>

    {institution ? (
      <dl class="record-facts">
        <div>
          <dt>Confidence</dt>
          <dd><span class="status-label" data-tone="unknown">{institution.confidenceState}</span></dd>
        </div>
        <div>
          <dt>Review state</dt>
          <dd><span class="status-label" data-tone="unknown">{institution.reviewState}</span></dd>
        </div>
        <div>
          <dt>Roles</dt>
          <dd>{institution.roles?.length ?? 0}</dd>
        </div>
      </dl>
    ) : (
      <EmptyState
        title="Institution data is unavailable"
        purpose="This record is read from the local services, which are not answering right now. No field was withheld."
        tips={setupTips}
        actionLabel="Back to the governance map"
        actionHref={`/governance/${slug}`}
      />
    )}

    {institution && (
    <section class="task-section">
      <h2>Roles</h2>
      {institution?.roles?.length ? (
        <ul class="ledger">
          {institution.roles.map((role) => (
            <li>
              <h3 class="ledger-title">
                <a href={`/governance/${slug}/roles/${role.id}`}>{role.name}</a>
              </h3>
              <p class="ledger-summary">{role.description ?? 'No description recorded.'}</p>
              <p class="ledger-meta">
                <span class="status-label" data-tone="unknown">{role.confidenceState}</span>
                <span class="status-label" data-tone="unknown">{role.reviewState}</span>
              </p>
            </li>
          ))}
        </ul>
      ) : (
        <EmptyState
          headingLevel={3}
          title="No roles recorded"
          purpose="A role names who inside this institution may decide, and under which mandate. None are recorded here yet."
          tips={[
            'A role carries a mandate and its legal basis; both are read from the graph.',
            'Contribute a role with its source so a reviewer can publish it.',
          ]}
          actionLabel="Contribute evidence"
          actionHref="/contribute/evidence"
        />
      )}
    </section>
    )}

    {institution && (
    <section class="task-section">
      <h2>Claims</h2>
      {claims === null ? (
        <EmptyState
          headingLevel={3}
          title="Claims are unavailable"
          purpose="Source-linked claims are read from the local services, which are not answering right now."
          tips={setupTips}
          actionLabel="Read the local setup steps"
          actionHref="/docs"
        />
      ) : claims.items.length ? (
        <ul class="ledger">
          {claims.items.map((claim) => (
            <li>
              <p class="record-statement">{claim.text}</p>
              <p class="ledger-meta">
                <span class="status-label" data-tone={claim.confidenceState === 'unsupported_draft' ? 'warning' : 'unknown'}>
                  {claim.confidenceState}
                </span>
                <span class="status-label" data-tone="unknown">{claim.reviewState}</span>
                <a href={`/claims/${encodeURIComponent(claim.id)}`}>Details</a>
              </p>
              {claim.evidence.length > 0 ? (
                <ul class="citations">
                  {claim.evidence.map((evidence) => {
                    const source = claim.sources.find((item) => item.id === evidence.sourceId);
                    return (
                      <li>
                        {source?.url ? <a href={source.url}>{source.title}</a> : <span>{source?.title ?? evidence.sourceId}</span>}
                        {evidence.quote && <blockquote>{evidence.quote}</blockquote>}
                        <p class="ledger-meta">
                          <span class="hash-value">hash {evidence.sourceHash ?? 'not recorded'}</span>
                          <span>retrieved {evidence.retrievedAt ?? 'not recorded'}</span>
                        </p>
                      </li>
                    );
                  })}
                </ul>
              ) : (
                <p class="ledger-meta">
                  <span class="status-label" data-tone="warning">no evidence attached</span>
                </p>
              )}
            </li>
          ))}
        </ul>
      ) : (
        <EmptyState
          headingLevel={3}
          title="No claims recorded for this institution"
          purpose="Claims attach to process steps, failure modes, and controls rather than to the institution itself, so this list is often empty."
          tips={[
            'Open a process to read the claims on its steps.',
            'Anyone can contribute a source-linked claim for review.',
          ]}
          actionLabel="Contribute evidence"
          actionHref="/contribute/evidence"
        />
      )}
    </section>
    )}
  </div>
</Base>
