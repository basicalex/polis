import GraphExplorer from '../../../../components/GraphExplorer';
import Base from '../../../../layouts/Base.astro';
import EmptyState from '@polis/ui/astro/EmptyState.astro';
import '../../../../styles/tasks.css';

type Relationship = {
  id: string;
  relationshipType: string;
  fromEntityType: string;
  fromEntityId: string;
  toEntityType: string;
  toEntityId: string;
};

type GraphNode = { id: string; label: string; type: string };
type GraphEdge = { id: string; relationshipType: string; fromEntityId: string; toEntityId: string };

const API = import.meta.env.PUBLIC_API_URL ?? 'http://localhost:8080';
async function fetchJson(path: string) {
  try {
    const r = await fetch(API + path);
    if (!r.ok) return null;
    return await r.json();
  } catch {
    return null;
  }
}

const slug = Astro.params.jurisdiction ?? 'jur-croatia-local';
const domain = Astro.params.domain ?? 'document-requirements';
const relationships = (await fetchJson('/api/v1/relationships')) as { items: Relationship[] } | null;
const nodeById: Record<string, GraphNode> = {};
const edges: GraphEdge[] = [];
for (const rel of relationships?.items ?? []) {
  nodeById[rel.fromEntityId] = { id: rel.fromEntityId, label: rel.fromEntityId, type: rel.fromEntityType };
  nodeById[rel.toEntityId] = { id: rel.toEntityId, label: rel.toEntityId, type: rel.toEntityType };
  edges.push({ id: rel.id, relationshipType: rel.relationshipType, fromEntityId: rel.fromEntityId, toEntityId: rel.toEntityId });
}
const nodes = Object.values(nodeById);
---

<Base title={`Governance domain · ${domain}`}>
  <div class="task-page">
    <header class="page-header">
      <p class="page-header-eyebrow status-label">Typed relationships</p>
      <h1>{domain.replaceAll('-', ' ')}</h1>
      <p class="page-header-institution">Jurisdiction <span class="hash-value">{slug}</span></p>
      <p class="page-header-lede">
        Static-first domain overview. Nodes are governance entities; arrows are explicit
        relationship_type values, never processes-as-edges.
      </p>
    </header>

    <section class="task-section">
      <h2>Graph explorer</h2>
      {relationships ? (
        <GraphExplorer client:load nodes={nodes} edges={edges} jurisdiction={slug} />
      ) : (
        <EmptyState
          headingLevel={3}
          title="Relationship data is unavailable"
          purpose="The graph reads typed relationships from the local services, which are not answering right now. No edge was hidden."
          tips={[
            'Start the backend from the repository root: bun run dev:services.',
            'Load the fixtures once the services are up: bun run db:seed.',
            'Every edge names its relationship type; nothing is inferred.',
          ]}
          actionLabel="Back to the governance map"
          actionHref={`/governance/${slug}`}
        />
      )}
    </section>
  </div>
</Base>
