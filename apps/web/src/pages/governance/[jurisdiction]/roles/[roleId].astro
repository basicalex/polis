import Base from '../../../../layouts/Base.astro';
import EmptyState from '@polis/ui/astro/EmptyState.astro';
import '../../../../styles/tasks.css';

type Role = {
  id: string;
  name: string;
  institutionId: string | null;
  mandate: { id: string; name: string; description: string | null; legalBasis: string | null } | null;
  authorizedByLaw: string | null;
  decisionRights: string[];
  description: string | null;
  confidenceState: string;
  reviewState: string;
  visibility: string;
};

const API = import.meta.env.PUBLIC_API_URL ?? 'http://localhost:8080';
async function fetchJson(path: string) {
  try {
    const r = await fetch(API + path);
    if (!r.ok) return null;
    return await r.json();
  } catch {
    return null;
  }
}

const slug = Astro.params.jurisdiction ?? 'jur-croatia-local';
const roleId = Astro.params.roleId ?? '';
const role = (await fetchJson(`/api/v1/roles/${encodeURIComponent(roleId)}`)) as Role | null;
---

<Base title={`Role · ${role?.name ?? roleId}`}>
  <div class="task-page">
    <header class="page-header record-head">
      <p class="page-header-eyebrow status-label">§11.3 role</p>
      <h1>{role?.name ?? 'Role unavailable'}</h1>
      <p class="record-id">{roleId}</p>
      {role?.description && <p class="page-header-lede">{role.description}</p>}
    </header>

    {role ? (
      <Fragment>
        <dl class="record-facts">
          <div>
            <dt>Decision rights</dt>
            <dd>{role.decisionRights.length ? role.decisionRights.join(', ') : 'none recorded'}</dd>
          </div>
          <div>
            <dt>Review state</dt>
            <dd><span class="status-label" data-tone="unknown">{role.reviewState}</span></dd>
          </div>
          <div>
            <dt>Confidence</dt>
            <dd><span class="status-label" data-tone="unknown">{role.confidenceState}</span></dd>
          </div>
        </dl>

        <dl class="detail-list">
          <div>
            <dt>Mandate</dt>
            <dd>{role.mandate ? `${role.mandate.name} — ${role.mandate.description ?? 'no description'}` : 'Not recorded'}</dd>
          </div>
          <div>
            <dt>Mandate legal basis</dt>
            <dd>{role.mandate?.legalBasis ?? 'Not recorded'}</dd>
          </div>
          <div>
            <dt>Authorized by law</dt>
            <dd>{role.authorizedByLaw ?? 'Not recorded'}</dd>
          </div>
          <div>
            <dt>Institution</dt>
            <dd>
              {role.institutionId ? (
                <a href={`/governance/${slug}/institutions/${role.institutionId}`}>{role.institutionId}</a>
              ) : (
                'Not recorded'
              )}
            </dd>
          </div>
          <div>
            <dt>Visibility</dt>
            <dd>{role.visibility}</dd>
          </div>
        </dl>
        <p class="task-lede">All role fields are shown; unavailable values are stated as such.</p>
      </Fragment>
    ) : (
      <EmptyState
        title="Role data is unavailable"
        purpose="This record is read from the local services, which are not answering right now. No field was withheld."
        tips={[
          'Start the backend from the repository root: bun run dev:services.',
          'Load the fixtures once the services are up: bun run db:seed.',
          'Roles are listed on the institution that holds them.',
        ]}
        actionLabel="Back to the governance map"
        actionHref={`/governance/${slug}`}
        actionVariant="primary"
      />
    )}
  </div>
</Base>
