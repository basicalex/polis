import Base from '../../layouts/Base.astro';
import ConfidenceBadge from '@polis/ui/astro/ConfidenceBadge.astro';
import ReviewStateBadge from '@polis/ui/astro/ReviewStateBadge.astro';
import SourcePanel from '@polis/ui/astro/SourcePanel.astro';
import AuditTrail from '@polis/ui/astro/AuditTrail.astro';
import AiLabel from '@polis/ui/astro/AiLabel.astro';
import EmptyState from '@polis/ui/astro/EmptyState.astro';
import '../../styles/tasks.css';
import type { AuditEvent, ConfidenceState, EvidenceLink, ReviewState } from '@polis/domain';

type ClaimWire = {
  id: string;
  text: string;
  claimType: string;
  subjectType: string;
  subjectId: string;
  confidenceState?: ConfidenceState;
  reviewState: ReviewState;
  evidence: EvidenceLink[];
  sources?: Array<{ id: string; title?: string; url?: string; publisher?: string }>;
  aiTraceId?: string;
  createdAt?: string;
};

const apiUrl = import.meta.env.PUBLIC_API_URL ?? 'http://localhost:8080';
const { id } = Astro.params;

let claim: ClaimWire | null = null;
let auditEvents: AuditEvent[] = [];

try {
  const res = await fetch(`${apiUrl}/api/v1/claims/${encodeURIComponent(id ?? '')}`);
  if (res.ok) claim = (await res.json()) as ClaimWire;
} catch {
  claim = null;
}

if (claim) {
  try {
    const res = await fetch(`${apiUrl}/api/v1/audit/claim/${encodeURIComponent(claim.id)}`);
    if (res.ok) {
      const body = (await res.json()) as {
        items?: Array<{ eventType?: string; action?: string; createdAt: string }>;
      };
      auditEvents = (body.items ?? []).map((item, index) => ({
        id: `${claim!.id}-audit-${index}`,
        service: item.eventType ?? 'audit',
        action: item.action ?? 'event',
        subjectId: claim!.id,
        visibility: 'public' as const,
        createdAt: item.createdAt,
        redacted: false,
      }));
    }
  } catch {
    auditEvents = [];
  }
}

if (!claim) Astro.response.status = 404;
---

<Base title={claim ? `Claim ${claim.id} — Polis Interface` : 'Claim not found — Polis Interface'}>
  <div class="task-page">
    {
      claim ? (
        <>
          <header class="page-header record-head">
            <h1>Claim</h1>
            <p class="record-id">{claim.id}</p>
            <p class="record-statement">{claim.text}</p>
          </header>

          <dl class="record-facts">
            <div>
              <dt>Review state</dt>
              <dd><ReviewStateBadge state={claim.reviewState} /></dd>
            </div>
            {claim.confidenceState && (
              <div>
                <dt>Confidence</dt>
                <dd><ConfidenceBadge state={claim.confidenceState} /></dd>
              </div>
            )}
            <div>
              <dt>Subject</dt>
              <dd>{claim.subjectType}/{claim.subjectId}</dd>
            </div>
            <div>
              <dt>Claim type</dt>
              <dd>{claim.claimType}</dd>
            </div>
            {claim.createdAt && (
              <div>
                <dt>Recorded</dt>
                <dd><time datetime={claim.createdAt}>{claim.createdAt}</time></dd>
              </div>
            )}
          </dl>

          {claim.aiTraceId && (
            <p class="link-row"><AiLabel traceId={claim.aiTraceId} /></p>
          )}

          <SourcePanel
            evidence={claim.evidence}
            sources={claim.sources ?? []}
            emptyActionLabel="Contribute a source"
            emptyActionHref="/contribute/evidence"
          />
          <AuditTrail events={auditEvents} />
        </>
      ) : (
        <>
          <header class="page-header record-head">
            <h1>Claim not found</h1>
            <p class="record-id">{id}</p>
          </header>
          <EmptyState
            title="No claim carries this id"
            purpose="Either the claim was never published under this reference, or the local services that hold the governance graph are not running."
            tips={[
              'Check the id in the address bar against the link you followed.',
              'Start the backend from the repository root: bun run dev:services.',
              'Claims attach to process steps, failure modes, and controls on the map.',
            ]}
            actionLabel="Browse the governance map"
            actionHref="/governance/jur-croatia-local"
            actionVariant="primary"
          />
        </>
      )
    }
  </div>
</Base>
