---
import Base from '../layouts/Base.astro';
import DemoBadge from '@polis/ui/astro/DemoBadge.astro';
import EmptyState from '@polis/ui/astro/EmptyState.astro';
import '../styles/tasks.css';

const API = import.meta.env.PUBLIC_API_URL ?? 'http://localhost:8080';

type Citation = {
  index: number;
  claimId: string;
  sourceId: string;
  evidenceLinkId: string;
  sourceTitle: string | null;
  sourceUrl: string | null;
  quote: string | null;
};

type AssistantAnswer = {
  answer: string;
  citations: Citation[];
  confidenceState: string;
  lowConfidence: boolean;
  published: boolean;
  injectionBlocked: boolean;
  traceId: string;
  outputId: string;
  reviewState: string;
};

const q = Astro.url.searchParams.get('q');
let answer: AssistantAnswer | null = null;
let unavailable = false;

if (q) {
  try {
    const r = await fetch(API + '/api/v1/assistant/ask', {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ question: q }),
    });
    if (r.ok) {
      answer = (await r.json()) as AssistantAnswer;
    } else {
      unavailable = true;
    }
  } catch {
    unavailable = true;
  }
}
---

<Base title="Assistant">
  <div class="task-page task-page--column">
    <header class="page-header">
      <h1>Citizen assistant</h1>
      <p class="page-header-lede">
        Ask a question about local governance. Answers are grounded in approved public sources with
        citations.
      </p>
      <DemoBadge />
    </header>

    <form class="assistant-form" method="get">
      <div class="field">
        <label class="field-label" for="q">Your question</label>
        <input
          type="text"
          id="q"
          name="q"
          value={q ?? ''}
          placeholder="e.g. What does the complaints office require?"
        />
        <p class="field-hint">
          The answer quotes approved public sources. It is not legal advice and it does not decide
          anything.
        </p>
      </div>
      <div class="form-actions">
        <button type="submit" class="btn" data-variant="primary">Ask</button>
      </div>
    </form>

    {unavailable && (
      <EmptyState
        title="The assistant is unavailable"
        purpose="Your question was not answered because the local assistant service did not respond. Nothing was recorded."
        tips={[
          'Start the backend from the repository root: bun run dev:services.',
          'The assistant needs the AI gateway as well as the platform API.',
          'Public sources stay readable on the governance map without it.',
        ]}
        actionLabel="Open the governance map"
        actionHref="/governance/jur-croatia-local"
      />
    )}

    {answer && (
      <section class="task-section" aria-label="Answer">
        {answer.injectionBlocked && (
          <p class="notice" data-tone="warning" role="status">
            <span class="status-label" data-tone="warning">blocked</span>
            <span>This request was blocked as a potential prompt injection. Nothing was answered.</span>
          </p>
        )}
        {answer.lowConfidence && !answer.injectionBlocked && (
          <p class="notice" data-tone="warning" role="status">
            <span class="status-label" data-tone="warning">low confidence</span>
            <span>No approved public sources were found for this question.</span>
          </p>
        )}
        <div class="answer-body prose">
          <p>{answer.answer}</p>
        </div>
        {answer.citations.length > 0 ? (
          <div class="citations task-section">
            <h2>Sources</h2>
            <ol>
              {answer.citations.map((c) => (
                <li>
                  {c.sourceUrl ? (
                    <a href={c.sourceUrl} rel="nofollow noopener" target="_blank">
                      {c.sourceTitle ?? c.sourceId}
                    </a>
                  ) : (
                    <span>{c.sourceTitle ?? c.sourceId}</span>
                  )}
                  {c.quote && <blockquote>{c.quote}</blockquote>}
                </li>
              ))}
            </ol>
          </div>
        ) : (
          <EmptyState
            headingLevel={2}
            title="No sources cited"
            purpose="This answer carries no approved public source, so treat it as unsupported until one is attached."
            tips={[
              'Approved sources come from the governance graph, not from the model.',
              'Contribute a source through the evidence form so future answers can cite it.',
            ]}
            actionLabel="Contribute evidence"
            actionHref="/contribute/evidence"
          />
        )}
        <p class="trace-id">Trace <code class="hash-value">{answer.traceId.slice(0, 12)}</code></p>
      </section>
    )}
  </div>
</Base>
