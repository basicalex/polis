---
import Base from '../../layouts/Base.astro';
import EmptyState from '@polis/ui/astro/EmptyState.astro';
import '../../styles/tasks.css';

const API = import.meta.env.PUBLIC_API_URL ?? 'http://localhost:8080';

type Submission = {
  id: string;
  type: string;
  status: string;
  contributionClass: string;
  submittedAt: string;
};

type Contributor = {
  id: string;
  identityLevel: string;
  displayName: string;
  createdAt: string;
  submissions: Submission[];
};

const id = Astro.params.id;
let contributor: Contributor | null = null;
let notFound = false;

if (id) {
  try {
    const r = await fetch(`${API}/api/v1/contributors/${id}`);
    if (r.ok) contributor = (await r.json()) as Contributor;
    else if (r.status === 404) notFound = true;
  } catch {
    notFound = true;
  }
}

const statusTone = (s: string) => (s === 'approved' ? 'valid' : s === 'rejected' ? 'danger' : 'warning');
---

<Base title={contributor ? contributor.displayName : 'Contributor'}>
  <div class="task-page">
    {contributor ? (
      <Fragment>
        <header class="page-header record-head">
          <h1>{contributor.displayName}</h1>
          <p class="record-id">{contributor.id}</p>
        </header>

        <dl class="record-facts">
          <div>
            <dt>Identity level</dt>
            <dd><span class="status-label" data-tone="unknown">{contributor.identityLevel}</span></dd>
          </div>
          <div>
            <dt>Submissions</dt>
            <dd>{contributor.submissions.length}</dd>
          </div>
          <div>
            <dt>Joined</dt>
            <dd>{contributor.createdAt}</dd>
          </div>
        </dl>

        <section class="task-section">
          <h2>Submissions</h2>
          {contributor.submissions.length > 0 ? (
            <ul class="ledger">
              {contributor.submissions.map((s) => (
                <li>
                  <h3 class="ledger-title">
                    <a href={`/contributions/${s.id}`}>{s.type}</a>
                  </h3>
                  <p class="ledger-meta">
                    <span class="status-label" data-tone={statusTone(s.status)}>{s.status}</span>
                    <span>{s.contributionClass}</span>
                    <time datetime={s.submittedAt}>{s.submittedAt}</time>
                  </p>
                  <p class="ledger-meta">
                    <span class="hash-value">{s.id}</span>
                  </p>
                </li>
              ))}
            </ul>
          ) : (
            <EmptyState
              headingLevel={3}
              title="No submissions yet"
              purpose="Contributions appear here as soon as they are submitted, whether or not a reviewer has decided them."
              tips={[
                'Evidence can be contributed against any subject on the governance map.',
                'Graph edits are insert-only in v0 and always go through review.',
              ]}
              actionLabel="Contribute evidence"
              actionHref="/contribute/evidence"
            />
          )}
        </section>
      </Fragment>
    ) : (
      <Fragment>
        <header class="page-header record-head">
          <h1>Contributor not found</h1>
          <p class="record-id">{id}</p>
        </header>
        <EmptyState
          title="No contributor matches this id"
          purpose={notFound
            ? 'The contribution service answered, and it holds no contributor under this reference.'
            : 'The contribution service did not answer, so the contributor could not be read.'}
          tips={[
            'Check the id in the address bar against the link you followed.',
            'Start the backend from the repository root: bun run dev:services.',
            'A contributor record is created with the first submission.',
          ]}
          actionLabel="Contribute evidence"
          actionHref="/contribute/evidence"
          actionVariant="primary"
        />
      </Fragment>
    )}
  </div>
</Base>
