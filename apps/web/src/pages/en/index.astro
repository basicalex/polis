/*
 * The English root. It opens on "What is Polis?" (`/en/about`); the place map
 * moved to `/en/karta`, and an old `/en/?zupanija=` link follows it there.
 */

import { rootRedirect } from '../../lib/entry/root-redirect';

if (Astro.url.searchParams.get('present') === '1') {
  return Astro.redirect('/en/presentation?present=1', 302);
}

const { location, status } = rootRedirect(Astro.url, 'en');
return Astro.redirect(location, status);
---
