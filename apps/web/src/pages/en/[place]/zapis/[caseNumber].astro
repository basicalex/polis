/*
 * One public case under its place. The report text is public from the moment it
 * was filed, unless the compliance pass held it, and the shell is readable in
 * every state. An unreadable case number answers the same as an unknown one, so
 * the page never says which of the two it is.
 */

import Base from '../../../../layouts/Base.astro';
import IntentScreen from '../../../../components/entry/IntentScreen.astro';
import PlaceCase from '../../../../components/entry/PlaceCase.astro';
import { entryMeta, entryStrings } from '../../../../content/entry';
import { text } from '../../../../content/chrome';
import { findPilotPlace, findPlace } from '../../../../content/places';
import { caseNumberRegExp } from '../../../../content/pilot/vrsar-public-case';

const lang = 'en' as const;
const slug = Astro.params.place ?? '';
const place = findPlace(slug);
if (!place) return new Response(null, { status: 404 });
const caseNumber = (Astro.params.caseNumber ?? '').toUpperCase();
if (!caseNumberRegExp.test(caseNumber)) return new Response(null, { status: 404 });
const pilot = findPilotPlace(slug);
const name = place.name[lang];
---

<Base
  lang={lang}
  chrome="entry"
  alternates={{
    hr: `/${place.slug}/zapis/${caseNumber}`,
    en: `/en/${place.slug}/zapis/${caseNumber}`,
  }}
  title={pilot ? `${caseNumber} — ${text(entryStrings.ledgerTitle, lang)}` : `Polis — ${name}`}
  description={
    pilot ? text(entryMeta.caseDescription, lang) : `${name} — ${text(entryStrings.notHereYet, lang)}`
  }
>
  {pilot ? <PlaceCase lang={lang} place={pilot} /> : <IntentScreen lang={lang} place={place} />}
</Base>
