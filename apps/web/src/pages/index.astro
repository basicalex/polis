/*
 * The Croatian root. It opens on "What is Polis?" (`/about`); the place map
 * moved to `/karta`, and an old `/?zupanija=` link follows it there. Croatian
 * is the default language of the site (revision decision R1), English lives
 * under `/en/`, and `/hr/` keeps working as a 301.
 */

import { rootRedirect } from '../lib/entry/root-redirect';

if (Astro.url.searchParams.get('present') === '1') {
  return Astro.redirect('/presentation?present=1', 302);
}

const { location, status } = rootRedirect(Astro.url, 'hr');
return Astro.redirect(location, status);
---
