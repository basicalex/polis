---
import Base from '../../layouts/Base.astro';
import DemoBadge from '@polis/ui/astro/DemoBadge.astro';

type ClaimWire = {
  id: string;
  text: string;
  claimType: string;
  reviewState: string;
  visibility: string;
} | null;

type Commitment = {
  id: string;
  claimId: string;
  successCriterion: string;
  dueAt: string | null;
  effectiveStatus: string;
  claim: ClaimWire;
};

type MandateHolderDetail = {
  id: string;
  citizenId: string;
  displayName: string;
  jurisdictionId: string | null;
  startsAt: string;
  endsAt: string | null;
  status: string;
  charterAccepted: boolean;
  commitments: Commitment[];
} | null;

type ScorecardTotals = {
  delivered: number;
  partial: number;
  notDelivered: number;
  inProgress: number;
  proposed: number;
  overdue: number;
};

type Scorecard = {
  mandateHolderId: string;
  totals: ScorecardTotals;
} | null;

const API = import.meta.env.PUBLIC_API_URL ?? 'http://localhost:8080';
async function fetchJson(path: string) {
  try {
    const r = await fetch(API + path);
    if (!r.ok) return null;
    return await r.json();
  } catch {
    return null;
  }
}

const id = Astro.params.id ?? '';
const holder = (await fetchJson(`/api/v1/mandate-holders/${encodeURIComponent(id)}`)) as MandateHolderDetail | null;
const scorecard = (await fetchJson(
  `/api/v1/mandate-holders/${encodeURIComponent(id)}/scorecard`,
)) as Scorecard | null;
const linkedClaims = holder?.commitments.map((c) => c.claim).filter((c): c is NonNullable<ClaimWire> => c !== null) ?? [];
const statusFilter = Astro.url.searchParams.get('status');
const filteredCommitments = statusFilter
  ? holder?.commitments.filter((c) => c.effectiveStatus === statusFilter) ?? []
  : holder?.commitments ?? [];
const statusAnchor = (status: string) => `commitments-${status.replaceAll('_', '-')}`;
---

<Base title={`Mandate-holder · ${holder?.displayName ?? id}`}>
  {holder ? (
    <Fragment>
      <section class="stack">
        <DemoBadge label="accountability, not endorsement" />
        <h1>{holder.displayName}</h1>
        <p class="muted">Jurisdiction: {holder.jurisdictionId ?? 'not recorded'}</p>
        <p>
          <span class="badge">{holder.status}</span>
          {holder.charterAccepted && <span class="badge">charter accepted</span>}
        </p>
        <p><span class="badge">public-read</span> <span class="badge">verifiable</span></p>
      </section>

      {scorecard && (
        <section class="stack">
          <h2>Commitment counts</h2>
          <p class="muted">
            Counts of commitments by effective status. This page reports accountability evidence only.
          </p>
          <div class="panel stack">
            <table class="data-table">
              <tbody>
                <tr><th scope="row">delivered</th><td><a href={`?status=delivered#${statusAnchor('delivered')}`} aria-label="delivered commitments evidence and audit details">{scorecard.totals.delivered}</a></td><th scope="row">in progress</th><td><a href={`?status=in_progress#${statusAnchor('in_progress')}`} aria-label="in progress commitments evidence and audit details">{scorecard.totals.inProgress}</a></td></tr>
                <tr><th scope="row">proposed</th><td><a href={`?status=proposed#${statusAnchor('proposed')}`} aria-label="proposed commitments evidence and audit details">{scorecard.totals.proposed}</a></td><th scope="row">partial</th><td><a href={`?status=partial#${statusAnchor('partial')}`} aria-label="partial commitments evidence and audit details">{scorecard.totals.partial}</a></td></tr>
                <tr><th scope="row">not delivered</th><td><a href={`?status=not_delivered#${statusAnchor('not_delivered')}`} aria-label="not delivered commitments evidence and audit details">{scorecard.totals.notDelivered}</a></td><th scope="row">overdue</th><td><a href={`?status=overdue#${statusAnchor('overdue')}`} aria-label="overdue commitments evidence and audit details">{scorecard.totals.overdue}</a></td></tr>
              </tbody>
            </table>
          </div>
        </section>
      )}

      <section class="stack" id={statusFilter ? statusAnchor(statusFilter) : 'commitments'}>
        <h2>Commitments{statusFilter && <span> (filtered: {statusFilter}) · <a href={Astro.url.pathname}>clear filter</a></span>}</h2>
        {filteredCommitments.length > 0 ? (
          <table class="data-table">
            <thead>
              <tr><th>Success criterion</th><th>Effective status</th><th>Due</th><th></th></tr>
            </thead>
            <tbody>
              {filteredCommitments.map((c) => (
                <tr id={`commitment-${c.effectiveStatus}-${c.id}`}>
                  <td>{c.successCriterion}</td>
                  <td><span class="badge">{c.effectiveStatus}</span></td>
                  <td>{c.dueAt ?? '—'}</td>
                  <td><a href={`/commitments/${c.id}`}>details</a></td>
                </tr>
              ))}
            </tbody>
          </table>
        ) : (
          <p class="panel muted">No commitments{statusFilter ? ' with status ' + statusFilter : ''} published.</p>
        )}
      </section>

      <section class="stack">
        <h2>Published claims</h2>
        {linkedClaims.length > 0 ? (
          <ul>
            {linkedClaims.map((claim) => (
              <li>{claim.text} <span class="badge">{claim.reviewState}</span></li>
            ))}
          </ul>
        ) : (
          <p class="panel muted">No claims linked to commitments.</p>
        )}
      </section>

      <section class="stack">
        <p class="muted">
          <a href="/audit">audit trail</a> · <a href="/proofs">proofs</a> · <a href="/verify">verify</a> · <a href="/methodology">methodology</a>
        </p>
      </section>
    </Fragment>
  ) : (
    <section class="stack">
      <h1>Mandate-holder not found</h1>
      <p class="panel muted">
        No mandate-holder record for <code>{id}</code>. Start the services and seed the database.
      </p>
      <p><a href="/mandate-holders">← back to mandate-holders</a></p>
    </section>
  )}
</Base>
