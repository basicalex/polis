---
import Base from '../../layouts/Base.astro';
import '../../styles/tasks.css';
---
<Base title="Polis Interface — Signing in…">
<div class="task-page form-narrow">
  <header class="page-header">
    <h1>Signing in…</h1>
    <p id="status" class="page-header-lede">Completing sign-in.</p>
  </header>
  <p id="error" class="field-error" role="alert" hidden></p>
  <p id="retry" class="link-row" hidden><a href="/login">Back to sign in</a></p>
</div>
<script is:inline>
const API = window.__API_URL;
const params = new URLSearchParams(location.search);
const code = params.get('code');
const state = params.get('state');
const status = document.getElementById('status');
const errorEl = document.getElementById('error');
const retryEl = document.getElementById('retry');
function fail(message) {
  status.hidden = true;
  errorEl.textContent = message + ' Start again from the sign-in page.';
  errorEl.hidden = false;
  retryEl.hidden = false;
}
if (!code || !state) {
  fail('This sign-in link is missing its parameters.');
} else {
  (async () => {
    try {
      const r = await fetch(API + '/api/v1/identity/callback', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({
          code,
          state,
          redirectUri: location.origin + '/login/callback',
        }),
      });
      const body = await r.json().catch(() => ({}));
      if (!r.ok) throw new Error(body.error || 'Sign-in failed (' + r.status + ').');
      sessionStorage.setItem('web_session', JSON.stringify({
        token: body.sessionToken,
        email: body.citizen?.email,
        citizenId: body.citizen?.id,
        identityLevel: body.citizen?.identityLevel,
      }));
      location.href = '/mandate-holders';
    } catch (e) {
      fail(e.message);
    }
  })();
}
</script>
</Base>
