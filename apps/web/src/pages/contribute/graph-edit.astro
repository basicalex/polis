import Base from '../../layouts/Base.astro';
import DemoBadge from '@polis/ui/astro/DemoBadge.astro';
import '../../styles/tasks.css';

const API = import.meta.env.PUBLIC_API_URL ?? 'http://localhost:8080';
---

<Base title="Propose a graph edit">
  <div class="task-page form-narrow">
    <header class="page-header">
      <h1>Propose a graph edit</h1>
      <p class="page-header-lede">
        Propose an addition to the governance graph (spec §11/§19). Insert-only in v0 — a reviewer
        approves the proposal before it is applied.
      </p>
      <DemoBadge />
    </header>

    <form id="graph-edit-form" class="task-page">
      <section class="task-section">
        <h2>What you are proposing</h2>
        <div class="form-row">
          <div class="field">
            <label class="field-label" for="targetTable">Target table</label>
            <select id="targetTable" name="targetTable">
              <option value="sources">sources</option>
              <option value="claims">claims</option>
            </select>
          </div>
          <div class="field">
            <label class="field-label" for="op">Operation</label>
            <select id="op" name="op">
              <option value="insert">insert</option>
            </select>
          </div>
        </div>
        <div class="field">
          <label class="field-label" for="proposedPayload">Proposed payload (JSON)</label>
          <textarea
            id="proposedPayload"
            name="proposedPayload"
            rows="6"
            placeholder='{"title":"…","url":"https://…","sourceType":"official"}'
            required></textarea>
          <p class="field-hint">One JSON object with the row to insert. Invalid JSON is rejected here, before it reaches the reviewer.</p>
        </div>
      </section>

      <section class="task-section">
        <h2>Who is proposing</h2>
        <div class="form-row">
          <div class="field">
            <label class="field-label" for="displayName">Display name</label>
            <input id="displayName" name="displayName" required />
          </div>
          <div class="field">
            <label class="field-label" for="identityLevel">Identity level</label>
            <select id="identityLevel" name="identityLevel">
              <option value="casual">Casual</option>
              <option value="verified">Verified</option>
            </select>
          </div>
        </div>
      </section>

      <div class="form-actions">
        <button type="submit" class="btn" data-variant="primary">Submit proposal</button>
        <a class="btn" data-variant="tertiary" href="/governance/jur-croatia-local">
          Open the governance map
        </a>
      </div>
    </form>
    <div id="result" class="contribute-result" aria-live="polite"></div>
  </div>
</Base>

<script is:inline define:vars={{ API }}>
  const form = document.getElementById('graph-edit-form');
  const result = document.getElementById('result');
  function fail(message) {
    result.replaceChildren();
    result.className = 'contribute-result notice';
    result.dataset.tone = 'warning';
    result.textContent = message;
  }
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const fd = new FormData(form);
    let payload;
    try {
      payload = JSON.parse(fd.get('proposedPayload'));
    } catch {
      fail('The proposed payload is not valid JSON. Fix the object and submit again.');
      return;
    }
    const body = {
      contributor: {
        displayName: fd.get('displayName'),
        identityLevel: fd.get('identityLevel'),
      },
      payload: {
        targetTable: fd.get('targetTable'),
        op: fd.get('op'),
        proposedPayload: payload,
      },
    };
    result.replaceChildren();
    result.className = 'contribute-result';
    delete result.dataset.tone;
    result.textContent = 'Submitting…';
    try {
      const r = await fetch(API + '/api/v1/contribute/graph-edit', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify(body),
      });
      const data = await r.json();
      if (r.ok) {
        result.replaceChildren();
        result.className = 'contribute-result notice';
        delete result.dataset.tone;
        const status = document.createElement('p');
        status.append(document.createTextNode('Submitted for review. Status: '));
        const strong = document.createElement('strong');
        strong.textContent = String(data.status);
        status.append(strong, document.createTextNode('.'));
        const link = document.createElement('a');
        link.href = '/contributions/' + data.id;
        link.textContent = 'View submission';
        const linkLine = document.createElement('p');
        linkLine.append(link);
        result.append(status, linkLine);
      } else {
        fail('The proposal was not accepted: ' + (data.error || r.status) + '. Nothing was recorded — fix the field and send it again.');
      }
    } catch (err) {
      fail('The proposal could not be sent: ' + err.message + '. Check that the services are running, then try again.');
    }
  });
</script>
