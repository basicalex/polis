---
import Base from '../../layouts/Base.astro';

const API = import.meta.env.PUBLIC_API_URL ?? 'http://localhost:8080';
---

<Base title="Propose a graph edit">
  <section class="page-hero">
    <h1>Propose a graph edit</h1>
    <p class="lede">
      Propose an addition to the governance graph (spec §11/§19). Insert-only in
      v0 — a reviewer approves the proposal before it is applied.
    </p>
  </section>

  <section class="contribute-form">
    <form id="graph-edit-form">
      <div class="form-row">
        <label>
          Display name
          <input name="displayName" required />
        </label>
        <label>
          Identity level
          <select name="identityLevel">
            <option value="casual">Casual</option>
            <option value="verified">Verified</option>
          </select>
        </label>
      </div>
      <div class="form-row">
        <label>
          Target table
          <select name="targetTable">
            <option value="sources">sources</option>
            <option value="claims">claims</option>
          </select>
        </label>
        <label>
          Operation
          <select name="op">
            <option value="insert">insert</option>
          </select>
        </label>
      </div>
      <label>
        Proposed payload (JSON)
        <textarea name="proposedPayload" rows="6" placeholder='{"title":"…","url":"https://…","sourceType":"official"}' required></textarea>
      </label>
      <button type="submit">Submit proposal</button>
    </form>
    <div id="result" class="contribute-result" aria-live="polite"></div>
  </section>
</Base>

<script is:inline define:vars={{ API }}>
  const form = document.getElementById('graph-edit-form');
  const result = document.getElementById('result');
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const fd = new FormData(form);
    let payload;
    try {
      payload = JSON.parse(fd.get('proposedPayload'));
    } catch {
      result.textContent = 'Error: proposed payload is not valid JSON.';
      return;
    }
    const body = {
      contributor: {
        displayName: fd.get('displayName'),
        identityLevel: fd.get('identityLevel'),
      },
      payload: {
        targetTable: fd.get('targetTable'),
        op: fd.get('op'),
        proposedPayload: payload,
      },
    };
    result.textContent = 'Submitting…';
    try {
      const r = await fetch(API + '/api/v1/contribute/graph-edit', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify(body),
      });
      const data = await r.json();
      if (r.ok) {
        result.innerHTML =
          '<p>Submitted. Status: <strong>' +
          data.status +
          '</strong>.</p><p><a href="/contributions/' +
          data.id +
          '">View submission →</a></p>';
      } else {
        result.textContent = 'Error: ' + (data.error || r.status);
      }
    } catch (err) {
      result.textContent = 'Error: ' + err.message;
    }
  });
</script>

<style>
  .contribute-form form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin: 1.5rem 0;
  }
  .contribute-form label {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    font-size: 0.9rem;
  }
  .form-row {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .form-row label {
    flex: 1;
    min-width: 12rem;
  }
  .contribute-form input,
  .contribute-form select,
  .contribute-form textarea {
    padding: 0.6rem;
    font-size: 1rem;
    border: 1px solid var(--border, #ccc);
    border-radius: 4px;
  }
  .contribute-form button {
    align-self: flex-start;
    padding: 0.6rem 1.4rem;
    font-size: 1rem;
    cursor: pointer;
  }
  .contribute-result {
    margin-top: 1rem;
  }
</style>
