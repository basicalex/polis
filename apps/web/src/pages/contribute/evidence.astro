---
import Base from '../../layouts/Base.astro';
import DemoBadge from '../../components/DemoBadge.astro';

const API = import.meta.env.PUBLIC_API_URL ?? 'http://localhost:8080';
---

<Base title="Contribute evidence">
  <section class="page-hero">
    <DemoBadge />
    <h1>Contribute evidence</h1>
    <p class="lede">
      Submit evidence for human review (spec §19). Approved evidence is published
      to the public governance graph with a full audit trail.
    </p>
  </section>

  <section class="contribute-form">
    <form id="evidence-form">
      <div class="form-row">
        <label>
          Display name
          <input name="displayName" required />
        </label>
        <label>
          Identity level
          <select name="identityLevel">
            <option value="casual">Casual</option>
            <option value="verified">Verified</option>
          </select>
        </label>
      </div>
      <label>
        Claim type
        <select name="claimType">
          <option value="legal_mandate">Legal mandate</option>
          <option value="budget_amount">Budget amount</option>
          <option value="role_responsibility">Role responsibility</option>
          <option value="process_step">Process step</option>
          <option value="document_requirement">Document requirement</option>
          <option value="risk_assessment">Risk assessment</option>
          <option value="proposal_assertion">Proposal assertion</option>
          <option value="public_statement">Public statement</option>
          <option value="other">Other</option>
        </select>
      </label>
      <div class="form-row">
        <label>
          Subject type
          <input name="subjectType" placeholder="e.g. process_step" required />
        </label>
        <label>
          Subject id
          <input name="subjectId" placeholder="e.g. step-registry-validation" required />
        </label>
        <label>
          Confidence (0–1)
          <input name="confidence" type="number" min="0" max="1" step="0.1" value="0.5" required />
        </label>
      </div>
      <label>
        Evidence text
        <textarea name="text" rows="4" required></textarea>
      </label>
      <button type="submit">Submit evidence</button>
    </form>
    <div id="result" class="contribute-result" aria-live="polite"></div>
  </section>
</Base>

<script is:inline define:vars={{ API }}>
  const form = document.getElementById('evidence-form');
  const result = document.getElementById('result');
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const fd = new FormData(form);
    const body = {
      contributor: {
        displayName: fd.get('displayName'),
        identityLevel: fd.get('identityLevel'),
      },
      payload: {
        text: fd.get('text'),
        claimType: fd.get('claimType'),
        subjectType: fd.get('subjectType'),
        subjectId: fd.get('subjectId'),
        confidence: Number(fd.get('confidence')),
      },
    };
    result.textContent = 'Submitting…';
    try {
      const r = await fetch(API + '/api/v1/contribute/evidence', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify(body),
      });
      const data = await r.json();
      if (r.ok) {
        result.innerHTML =
          '<p>Submitted. Status: <strong>' +
          data.status +
          '</strong>.</p><p><a href="/contributions/' +
          data.id +
          '">View submission →</a></p>';
      } else {
        result.textContent = 'Error: ' + (data.error || r.status);
      }
    } catch (err) {
      result.textContent = 'Error: ' + err.message;
    }
  });
</script>

<style>
  .contribute-form form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin: 1.5rem 0;
  }
  .contribute-form label {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    font-size: 0.9rem;
  }
  .form-row {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .form-row label {
    flex: 1;
    min-width: 12rem;
  }
  .contribute-form input,
  .contribute-form select,
  .contribute-form textarea {
    padding: 0.6rem;
    font-size: 1rem;
    border: 1px solid var(--border, #ccc);
    border-radius: 4px;
  }
  .contribute-form button {
    align-self: flex-start;
    padding: 0.6rem 1.4rem;
    font-size: 1rem;
    cursor: pointer;
  }
  .contribute-result {
    margin-top: 1rem;
  }
</style>
