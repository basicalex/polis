---
import Base from '../../layouts/Base.astro';
import {
  landing,
  landingEntryIds,
  stageLabels,
  stages,
  type LandingEntryId,
} from '../../content/public-release';

if (Astro.url.searchParams.get('present') === '1') {
  return Astro.redirect('/hr/presentation?present=1', 302);
}

const lang = 'hr' as const;
const text = landing[lang];
const loopStages = stages.map((stage) => stage.stage);
const entryHrefs: Record<LandingEntryId, string> = {
  citizen: '/demo/citizen',
  official: '/demo/official',
  review: '/demo/review',
  record: '/demo/record',
  embed: '/demo/embed',
  presentation: '/hr/presentation',
};
---

<Base
  lang={lang}
  title="Polis — Sloj javnog odgovora"
  description="Pratite jedan javni odgovor od prve prijave do neovisno provjerene javne potvrde, pa otvorite demonstraciju kao stanovnik, dužnosnik ili provjeritelj."
>
  <article class="landing" id="public-record">
    <header class="landing-lead">
      <h1>{text.headline}</h1>
      <p class="landing-lede">{text.lede}</p>
    </header>

    <section class="landing-loop" aria-labelledby="landing-loop-title">
      <h2 class="landing-section-title" id="landing-loop-title">{text.loopTitle}</h2>
      <ol class="landing-loop-list">
        {
          loopStages.map((stage, index) => (
            <li>
              <span class="landing-loop-index">{index + 1}</span>
              <span class="landing-loop-name">{stageLabels[stage][lang]}</span>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="landing-open" aria-labelledby="landing-open-title">
      <h2 class="landing-section-title" id="landing-open-title">{text.entriesTitle}</h2>
      <ul class="landing-entries">
        {
          landingEntryIds.map((id) => (
            <li>
              <a href={entryHrefs[id]}>
                <span class="landing-entry-label">{text.entries[id].label}</span>
                <span class="landing-entry-note">{text.entries[id].note}</span>
                <span class="landing-entry-arrow" aria-hidden="true">
                  →
                </span>
              </a>
            </li>
          ))
        }
      </ul>
      <p class="landing-note">{text.demoNote}</p>
    </section>
  </article>
</Base>

<style>
  .landing {
    display: grid;
    gap: var(--space-xl);
    max-width: 74rem;
    margin-inline: auto;
  }

  .landing-lead {
    display: grid;
    gap: var(--space-sm);
  }

  .landing-lede {
    max-width: 62ch;
    margin: 0;
    color: var(--polis-text);
    font-size: var(--type-body-lg);
    line-height: 1.5;
  }

  .landing-section-title {
    max-width: none;
    margin: 0 0 var(--space-md);
    padding-bottom: var(--space-xs);
    border-bottom: 1px solid var(--polis-border);
    color: var(--polis-muted);
    font-family: var(--body);
    font-size: var(--type-label);
    font-weight: 600;
    letter-spacing: 0.06em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .landing-loop-list {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: var(--space-md);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .landing-loop-list li {
    display: grid;
    gap: 0.2rem;
    align-content: start;
  }

  .landing-loop-index {
    color: var(--polis-muted);
    font-size: var(--type-meta);
    font-variant-numeric: tabular-nums;
  }

  .landing-loop-name {
    font-size: var(--type-body-lg);
    font-weight: 600;
    line-height: 1.25;
  }

  .landing-entries {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .landing-entries li + li a {
    border-top: 1px solid var(--polis-border);
  }

  .landing-entries a {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 0.2rem var(--space-md);
    min-height: var(--tap-target);
    padding: var(--space-sm) 0;
    color: inherit;
    text-decoration: none;
  }

  .landing-entry-label {
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .landing-entry-note {
    grid-column: 1;
    max-width: 62ch;
    color: var(--polis-muted);
  }

  .landing-entry-arrow {
    grid-column: 2;
    grid-row: 1 / span 2;
    align-self: center;
    color: var(--polis-trace);
  }

  .landing-entries a:hover .landing-entry-label,
  .landing-entries a:focus-visible .landing-entry-label {
    color: var(--polis-trace);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .landing-note {
    margin: var(--space-md) 0 0;
    max-width: 62ch;
    color: var(--polis-muted);
    font-size: var(--type-data);
  }

  @media (max-width: 56.25rem) {
    .landing-loop-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 40rem) {
    .landing {
      gap: var(--space-lg);
    }

    .landing-loop-list {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-sm);
    }

    .landing-loop-list li {
      grid-template-columns: auto minmax(0, 1fr);
      gap: 0 var(--space-sm);
      align-items: baseline;
    }

    .landing-entries a {
      grid-template-columns: minmax(0, 1fr);
    }

    .landing-entry-arrow {
      display: none;
    }
  }

  @media print {
    .landing-entry-arrow {
      display: none;
    }
  }
</style>
