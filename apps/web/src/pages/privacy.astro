// SPDX-License-Identifier: AGPL-3.0-or-later

/*
 * The platform notice. Intrface runs the site and processes reports on behalf
 * of each municipality; the municipality is the controller, so the notice that
 * names a controller, a retention period and a data protection officer lives
 * under the place. This page covers what Intrface itself does, and the one
 * third party a page talks to: the OpenStreetMap tile server.
 */

import '../styles/public.css';
import Base from '../layouts/Base.astro';
import { text } from '../content/chrome';
import { entryStrings } from '../content/entry';
import { livePlaces } from '../content/places';
---

<Base title="Privacy">
  <article class="reading-page" id="public-record">
    <header class="page-header">
      <h1>Privacy</h1>
      <p class="page-header-lede">
        Intrface j.d.o.o. operates this site and runs Polis as a processor for each municipality
        that uses it. The municipality is the controller of the reports it receives.
      </p>
    </header>

    <section class="reading-section">
      <h2>The notice for your municipality</h2>
      <p>
        Who processes your report, what becomes public and when, how long it is kept, and how you
        use your rights are set by the municipality. Its notice says so:
      </p>
      <ul>
        {
          livePlaces.map((place) => (
            <li>
              <a href={`/${place.slug}/privatnost`}>{place.name.en}</a>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="reading-section">
      <h2>What Intrface does</h2>
      <p>
        Intrface stores and serves the reports, the public record and the office's answers on the
        municipality's instructions. It does not decide what is published, does not review a report
        and does not sell or share the data.
      </p>
      <p>
        Private casework, identity documents, resident files, and internal notes stay on the
        restricted rail. They are not fetched, serialized into page data, placed in the DOM, or
        printed by any surface in this build.
      </p>
    </section>

    <section class="reading-section">
      <h2>Map tiles</h2>
      <p>{text(entryStrings.reportMapPrivacy, 'en')}</p>
    </section>
  </article>
</Base>
