import VrsarChannelHelp from '../../../components/pilot/vrsar/VrsarChannelHelp.astro';
import VrsarPilotShell from '../../../components/pilot/vrsar/VrsarPilotShell.astro';
import VrsarTraceSummary from '../../../components/pilot/vrsar/VrsarTraceSummary.astro';
import { parsePilotLang, pilotCopy } from '../../../content/pilot/vrsar';
import { CASE_NUMBER_PATTERN, publicCaseCopy } from '../../../content/pilot/vrsar-public-case';
import { worklistCopy } from '../../../content/pilot/vrsar-worklist';

const lang = parsePilotLang(Astro.url);
const lookup = publicCaseCopy.lookup;
---

<VrsarPilotShell
  lang={lang}
  page="home"
  title={`${pilotCopy.appTitle[lang]} — Polis`}
  description={pilotCopy.entry.intro[lang]}
>
  <article class="pilot-page" data-entry-page>
    <header class="pilot-page-header">
      <h1 data-entry-heading>{pilotCopy.entry.heading[lang]}</h1>
      <p class="pilot-lead" data-entry-lead>{pilotCopy.entry.intro[lang]}</p>
    </header>

    <section
      class="pilot-section"
      aria-labelledby="pilot-counts-title"
      data-entry-counts
      hidden
    >
      <h2 class="visually-hidden" id="pilot-counts-title">
        {worklistCopy.overviewHeading[lang]}
      </h2>
      <div class="pilot-stats" data-entry-stats></div>
    </section>

    <section class="pilot-section panel" aria-labelledby="pilot-lookup-title" data-entry-lookup>
      <h2 id="pilot-lookup-title">{lookup.heading[lang]}</h2>
      <form class="pilot-form" data-case-lookup novalidate>
        <div class="field" data-width="code">
          <label for="pilot-case-number">{lookup.label[lang]}</label>
          <input
            id="pilot-case-number"
            name="caseNumber"
            type="text"
            inputmode="text"
            autocomplete="off"
            autocapitalize="characters"
            spellcheck="false"
            pattern={CASE_NUMBER_PATTERN}
            placeholder="VRS-1842"
            aria-describedby="pilot-case-number-hint pilot-case-number-error"
          />
        </div>
        <p class="field-hint" id="pilot-case-number-hint">{lookup.hint[lang]}</p>
        <p class="field-error" id="pilot-case-number-error" data-case-lookup-error></p>
        <div class="pilot-actions">
          <button class="btn" data-variant="secondary" type="submit">{lookup.submit[lang]}</button>
        </div>
      </form>
    </section>

    <section class="pilot-section" aria-labelledby="pilot-config-title" data-entry-scope>
      <h2 id="pilot-config-title">{pilotCopy.entry.contextHeading[lang]}</h2>
      <p class="pilot-state" tabindex="-1" data-config-state>{pilotCopy.common.loading[lang]}</p>
      <dl class="pilot-meta" data-config-details hidden>
        <div><dt data-config-municipality-label></dt><dd data-config-municipality></dd></div>
        <div><dt>{pilotCopy.common.category[lang]}</dt><dd data-config-category></dd></div>
        <div><dt>{pilotCopy.common.office[lang]}</dt><dd data-config-office></dd></div>
      </dl>
      <p class="pilot-state" data-intake-state></p>
      <ul class="pilot-source-list" data-config-sources></ul>

      <div class="pilot-alert" role="alert" tabindex="-1" data-runtime-alert hidden>
        <h3>{pilotCopy.entry.runtimeDownTitle[lang]}</h3>
        <p class="pilot-alert-detail" data-runtime-alert-detail>{pilotCopy.common.connectionError[lang]}</p>
        <p class="field-hint">{pilotCopy.entry.runtimeDownFix[lang]}</p>
        <div class="pilot-actions">
          <button class="btn" data-variant="primary" type="button" data-config-retry>{pilotCopy.common.retry[lang]}</button>
        </div>
      </div>
    </section>

    <div class="pilot-entry-aside" data-entry-aside>
      <section class="pilot-section" aria-labelledby="pilot-path-title">
        <h2 id="pilot-path-title">{pilotCopy.receipts.events[lang]}</h2>
        <VrsarTraceSummary lang={lang} />
        <p>{pilotCopy.entry.publicationRule[lang]}</p>
      </section>

      <VrsarChannelHelp lang={lang} />
    </div>

    <section class="pilot-section panel" aria-labelledby="pilot-session-title" data-entry-role>
      <h2 id="pilot-session-title">{pilotCopy.common.role[lang]}</h2>
      <p class="pilot-state" tabindex="-1" data-page-state>{pilotCopy.entry.sessionChecking[lang]}</p>
      <div class="pilot-actions" data-entry-actions></div>
    </section>
  </article>

  <script>
    import { initVrsarEntry } from '../../../scripts/pilot/vrsar/index';
    import { initVrsarCaseLookup } from '../../../scripts/pilot/vrsar/public-case';
    initVrsarEntry();
    initVrsarCaseLookup();
  </script>
</VrsarPilotShell>
