import EmptyState from '@polis/ui/astro/EmptyState.astro';
import VrsarPilotShell from '../../../../components/pilot/vrsar/VrsarPilotShell.astro';
import { parsePilotLang, pilotCopy, pilotHref } from '../../../../content/pilot/vrsar';
import { CASE_NUMBER_PATTERN, publicCaseCopy } from '../../../../content/pilot/vrsar-public-case';

const lang = parsePilotLang(Astro.url);
const lookup = publicCaseCopy.lookup;
---

<VrsarPilotShell lang={lang} page="receipts" title={`${pilotCopy.receipts.heading[lang]} — Polis`} description={pilotCopy.receipts.intro[lang]}>
  <article class="pilot-page">
    <header class="pilot-page-header">
      <h1>{pilotCopy.receipts.heading[lang]}</h1>
      <p class="pilot-lead">{pilotCopy.receipts.intro[lang]}</p>
    </header>
    <section class="pilot-section" aria-labelledby="receipts-lookup-title" data-lookup="compact">
      <h2 id="receipts-lookup-title">{lookup.heading[lang]}</h2>
      <form class="pilot-form" data-case-lookup novalidate>
        <div class="field" data-width="code">
          <label for="receipts-case-number">{lookup.label[lang]}</label>
          <input
            id="receipts-case-number"
            name="caseNumber"
            type="text"
            inputmode="text"
            autocomplete="off"
            autocapitalize="characters"
            spellcheck="false"
            pattern={CASE_NUMBER_PATTERN}
            placeholder="VRS-1842"
            aria-describedby="receipts-case-number-hint receipts-case-number-error"
          />
        </div>
        <p class="field-hint" id="receipts-case-number-hint">{lookup.hint[lang]}</p>
        <p class="field-error" id="receipts-case-number-error" data-case-lookup-error></p>
        <div class="pilot-actions">
          <button class="btn" data-variant="secondary" type="submit">{lookup.submit[lang]}</button>
        </div>
      </form>
    </section>

    <p class="pilot-state" tabindex="-1" role="status" aria-live="polite" data-page-state>{pilotCopy.common.loading[lang]}</p>
    <ul class="pilot-ledger" data-list="receipts" data-public-list></ul>
    <div data-empty-state hidden>
      <EmptyState
        title={pilotCopy.receipts.emptyTitle[lang]}
        purpose={pilotCopy.receipts.empty[lang]}
        tips={[pilotCopy.receipts.emptyTipOne[lang], pilotCopy.receipts.emptyTipTwo[lang]]}
        actionLabel={pilotCopy.nav.home[lang]}
        actionHref={pilotHref('/pilot/vrsar', lang)}
        actionVariant="tertiary"
        lang={lang}
      />
    </div>
    <div class="pilot-state-actions"><button class="btn" data-variant="secondary" type="button" data-retry hidden>{pilotCopy.common.retry[lang]}</button></div>
  </article>
  <script>
    import { initVrsarReceipts } from '../../../../scripts/pilot/vrsar/receipts';
    import { initVrsarCaseLookup } from '../../../../scripts/pilot/vrsar/public-case';
    initVrsarReceipts();
    initVrsarCaseLookup();
  </script>
</VrsarPilotShell>
