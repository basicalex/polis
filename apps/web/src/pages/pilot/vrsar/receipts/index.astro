import EmptyState from '@polis/ui/astro/EmptyState.astro';
import VrsarPilotShell from '../../../../components/pilot/vrsar/VrsarPilotShell.astro';
import { parsePilotLang, pilotCopy, pilotHref } from '../../../../content/pilot/vrsar';

const lang = parsePilotLang(Astro.url);
---

<VrsarPilotShell lang={lang} page="receipts" title={`${pilotCopy.receipts.heading[lang]} — Polis`} description={pilotCopy.receipts.intro[lang]}>
  <article class="pilot-page">
    <header class="pilot-page-header">
      <h1>{pilotCopy.receipts.heading[lang]}</h1>
      <p class="pilot-lead">{pilotCopy.receipts.intro[lang]}</p>
    </header>
    <p class="pilot-state" tabindex="-1" role="status" aria-live="polite" data-page-state>{pilotCopy.common.loading[lang]}</p>
    <ul class="pilot-ledger" data-public-list></ul>
    <div data-empty-state hidden>
      <EmptyState
        title={pilotCopy.receipts.emptyTitle[lang]}
        purpose={pilotCopy.receipts.empty[lang]}
        tips={[pilotCopy.receipts.emptyTipOne[lang], pilotCopy.receipts.emptyTipTwo[lang]]}
        actionLabel={pilotCopy.nav.home[lang]}
        actionHref={pilotHref('/pilot/vrsar', lang)}
        actionVariant="tertiary"
        lang={lang}
      />
    </div>
    <div class="pilot-state-actions"><button class="btn" data-variant="secondary" type="button" data-retry hidden>{pilotCopy.common.retry[lang]}</button></div>
  </article>
  <script>
    import { initVrsarReceipts } from '../../../../scripts/pilot/vrsar/receipts';
    initVrsarReceipts();
  </script>
</VrsarPilotShell>
