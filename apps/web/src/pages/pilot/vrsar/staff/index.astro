import VrsarPilotShell from '../../../../components/pilot/vrsar/VrsarPilotShell.astro';
import { parsePilotLang, pilotCopy } from '../../../../content/pilot/vrsar';
import { worklistCopy } from '../../../../content/pilot/vrsar-worklist';
import '../../../../styles/pilot/vrsar-worklist.css';

const lang = parsePilotLang(Astro.url);
---

<VrsarPilotShell
  lang={lang}
  page="staff"
  title={`${pilotCopy.staff.heading[lang]} — Polis`}
  description={worklistCopy.lead[lang]}
>
  <article class="pilot-page">
    <header class="pilot-page-header">
      <h1>{pilotCopy.staff.heading[lang]}</h1>
      <p class="pilot-lead">{worklistCopy.lead[lang]}</p>
    </header>
    <p class="pilot-state" tabindex="-1" role="status" aria-live="polite" data-page-state>
      {pilotCopy.common.loading[lang]}
    </p>
    <div class="pilot-state-actions">
      <button class="btn" data-variant="secondary" type="button" data-retry hidden>
        {pilotCopy.common.retry[lang]}
      </button>
    </div>
    <div class="worklist" data-staff-workspace hidden>
      <section class="worklist-overview" aria-labelledby="worklist-overview-title">
        <h2 class="visually-hidden" id="worklist-overview-title">
          {worklistCopy.overviewHeading[lang]}
        </h2>
        <div class="worklist-stats" data-worklist-stats></div>
        <button class="btn" data-variant="tertiary" type="button" aria-pressed="false" data-closed-toggle hidden></button>
      </section>
      <section aria-labelledby="worklist-queue-title">
        <h2 class="visually-hidden" id="worklist-queue-title">{worklistCopy.queueHeading[lang]}</h2>
        <div class="worklist-groups" data-worklist-groups></div>
        <p class="pilot-state" data-worklist-empty hidden></p>
      </section>
    </div>
  </article>
  <script>
    import { initVrsarStaff } from '../../../../scripts/pilot/vrsar/staff';
    initVrsarStaff();
  </script>
</VrsarPilotShell>
