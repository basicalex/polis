---
import Base from '../../layouts/Base.astro';
import EmptyState from '@polis/ui/astro/EmptyState.astro';
import '../../styles/tasks.css';

type Results = {
  pilotId: string;
  period: string;
  publishedAt: string;
  metrics: Record<string, number>;
  outcomes: string[];
  methodology: string;
};

const API = import.meta.env.PUBLIC_API_URL ?? 'http://localhost:8080';
async function fetchJson(path: string) {
  try {
    const r = await fetch(API + path);
    if (!r.ok) return null;
    return await r.json();
  } catch { return null; }
}

const results = (await fetchJson('/api/v1/pilot/results')) as Results | null;
---

<Base title="Demonstrator fixture results">
  <div class="task-page task-page--column">
    <header class="page-header">
      <h1>Demonstrator fixture results</h1>
      <p class="page-header-lede">
        Measures and outcomes from the seeded complaints scenario, kept so the demonstrator can be
        read and challenged like a real report.
      </p>
    </header>

    {results && (
      <dl class="record-facts">
        <div>
          <dt>Fixture period</dt>
          <dd>{results.period}</dd>
        </div>
        <div>
          <dt>Published</dt>
          <dd>{new Date(results.publishedAt).toLocaleDateString()}</dd>
        </div>
        <div>
          <dt>Standing</dt>
          <dd><span class="status-label" data-tone="warning">synthetic fixtures</span></dd>
        </div>
      </dl>
    )}

    <aside class="material-note" aria-labelledby="demonstrator-title">
      <h2 id="demonstrator-title">Results are demonstration material</h2>
      <p class="prose">
        This is a <strong>simulated complaints-process demonstrator</strong>. Metrics and outcomes are{' '}
        <strong>synthetic fixtures</strong> and <strong>development trust material</strong>; there is{' '}
        <strong>no government integration</strong>.
      </p>
      <dl class="record-facts">
        <div>
          <dt>implemented locally</dt>
          <dd>The interface and local development flow shown on this site.</dd>
        </div>
        <div>
          <dt>mocked</dt>
          <dd>The reported metrics, outcomes, and complaints-process entries.</dd>
        </div>
        <div>
          <dt>operationally accepted</dt>
          <dd>No part of this demonstrator is operationally accepted.</dd>
        </div>
      </dl>
    </aside>

    {results && (
      <>
        <section class="material-section" aria-labelledby="measures-title">
          <h2 id="measures-title">Seeded scenario measures</h2>
          <p class="status-label" data-tone="warning">synthetic fixtures · development trust material · no government integration</p>
          <div class="table-scroll">
            <table class="data-table">
              <caption>Seeded scenario measures — synthetic fixtures</caption>
              <thead>
                <tr><th scope="col">Measure</th><th scope="col">Value</th></tr>
              </thead>
              <tbody>
                {Object.entries(results.metrics).map(([key, val]) => (
                  <tr><th scope="row">{key}</th><td class="ledger-value">{val}</td></tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
        <section class="material-section" aria-labelledby="outputs-title">
          <h2 id="outputs-title">Illustrated outputs</h2>
          <p class="status-label" data-tone="warning">synthetic fixtures · development trust material · no government integration</p>
          <ul>{results.outcomes.map((o) => <li>{o}</li>)}</ul>
        </section>
        <section class="material-section" aria-labelledby="methodology-title">
          <h2 id="methodology-title">Methodology</h2>
          <p class="status-label" data-tone="warning">development trust material</p>
          <p class="prose">{results.methodology}</p>
        </section>
      </>
    )}

    {!results && (
      <div aria-live="polite">
        <EmptyState
          title="Demonstration result data are unavailable"
          purpose="This page reads the fixture results from the local platform API, which is not answering. The measures are synthetic in every case; none are withheld."
          tips={[
            'Start the backend from the repository root: bun run dev:services.',
            'Load the fixtures once the services are up: bun run db:seed.',
            'The simulated charter explains what this demonstrator does and does not claim.',
          ]}
          actionLabel="Return to the simulated charter"
          actionHref="/partners"
        />
      </div>
    )}

    <nav class="resource-links" aria-label="Demonstrator resources">
      <a href="/governance/jur-croatia-local">Process map</a>
      <a href="/transparency">Transparency</a>
      <a href="/verify">Verify</a>
      <a href="/partners">Charter</a>
      <a href="/pilot/results">Results</a>
    </nav>
  </div>
</Base>
