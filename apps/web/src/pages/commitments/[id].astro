---
import Base from '../../layouts/Base.astro';
import DemoBadge from '@polis/ui/astro/DemoBadge.astro';

type StatusEvent = {
  id: string;
  status: string;
  decidedBy: string | null;
  decidedAt: string;
};

type ResolutionClaim = {
  id: string;
  text: string;
  reviewState: string;
};

type Resolution = {
  claim: ResolutionClaim;
  evidence: { id: string; quote?: string; paraphrase?: string }[];
} | null;

type Answer = {
  mandateHolderId: string;
  body: string;
  decidedAt: string | null;
};

type Question = {
  id: string;
  askedByCitizenId: string;
  body: string;
  createdAt: string;
  answer: Answer | null;
};

type CommitmentDetail = {
  id: string;
  successCriterion: string;
  dueAt: string | null;
  effectiveStatus: string;
  statusTimeline: StatusEvent[];
  resolution: Resolution;
  questions: Question[];
} | null;

const API = import.meta.env.PUBLIC_API_URL ?? 'http://localhost:8080';
async function fetchJson(path: string) {
  try {
    const r = await fetch(API + path);
    if (!r.ok) return null;
    return await r.json();
  } catch {
    return null;
  }
}

const id = Astro.params.id ?? '';
const commitment = (await fetchJson(`/api/v1/commitments/${encodeURIComponent(id)}`)) as CommitmentDetail | null;
---

<Base title={`Commitment · ${commitment?.id ?? id}`}>
  {commitment ? (
    <Fragment>
      <section class="stack">
        <DemoBadge label="accountability, not endorsement" />
        <h1>Commitment</h1>
        <p>{commitment.successCriterion}</p>
        <p>
          <span class="badge">{commitment.effectiveStatus}</span>
          {commitment.dueAt && <span class="muted"> · due {commitment.dueAt}</span>}
        </p>
        <p><span class="badge">public-read</span> <span class="badge">verifiable</span></p>
      </section>

      <section class="stack">
        <h2>Status timeline</h2>
        {commitment.statusTimeline.length > 0 ? (
          <table class="data-table">
            <thead>
              <tr><th>Status</th><th>Decided by</th><th>Decided at</th></tr>
            </thead>
            <tbody>
              {commitment.statusTimeline.map((event) => (
                <tr>
                  <td><span class="badge">{event.status}</span></td>
                  <td>{event.decidedBy ?? '—'}</td>
                  <td>{event.decidedAt}</td>
                </tr>
              ))}
            </tbody>
          </table>
        ) : (
          <p class="panel muted">No status events recorded.</p>
        )}
      </section>

      <section class="stack">
        <h2>Resolution evidence</h2>
        {commitment.resolution ? (
          <div class="card stack">
            <p>{commitment.resolution.claim.text}</p>
            <p><span class="badge">{commitment.resolution.claim.reviewState}</span></p>
            {commitment.resolution.evidence.length > 0 && (
              <ul>
                {commitment.resolution.evidence.map((e) => (
                  <li class="muted">{e.quote ?? e.paraphrase ?? e.id}</li>
                ))}
              </ul>
            )}
          </div>
        ) : (
          <p class="panel muted">No resolution evidence published (commitment not yet resolved).</p>
        )}
      </section>

      <section class="stack">
        <h2>Questions</h2>
        <p class="muted">Citizens ask; the mandate-holder answers; answers are adjudicated before publication.</p>
        {commitment.questions.length > 0 ? (
          <ul class="stack">
            {commitment.questions.map((q) => (
              <li class="card stack">
                <p>{q.body}</p>
                <p class="muted">asked by <code>{q.askedByCitizenId}</code> · {q.createdAt}</p>
                {q.answer ? (
                  <blockquote>
                    <p>{q.answer.body}</p>
                    <p class="muted">answered · decided {q.answer.decidedAt ?? '—'}</p>
                  </blockquote>
                ) : (
                  <p class="panel muted">Not yet answered.</p>
                )}
              </li>
            ))}
          </ul>
        ) : (
          <p class="panel muted">No questions asked yet.</p>
        )}
        <DemoBadge label="demonstration" />
        <div id="ask-logged-out" style="display:none">
          <p class="muted"><a href="/login">Log in</a> to ask a question.</p>
        </div>
        <form id="ask-form" class="stack" style="display:none">
          <label>Ask a question <textarea name="body" rows="2" style="width:100%"></textarea></label>
          <button type="submit">Submit question</button>
          <p class="muted" id="ask-msg"></p>
        </form>
      </section>
      <script is:inline define:vars={{ API, id }}>
        (function () {
          var form = document.getElementById('ask-form');
          var loggedOut = document.getElementById('ask-logged-out');
          if (!form) return;
          var raw = sessionStorage.getItem('web_session');
          var session = raw ? JSON.parse(raw) : null;
          if (!session || !session.token) {
            loggedOut.style.display = 'block';
            return;
          }
          form.style.display = 'block';
          form.addEventListener('submit', async function (e) {
            e.preventDefault();
            var msg = document.getElementById('ask-msg');
            var body = form.body.value.trim();
            if (!body) { msg.textContent = 'Question text required.'; return; }
            try {
              var r = await fetch(API + '/api/v1/commitments/' + id + '/questions', {
                method: 'POST',
                headers: { 'content-type': 'application/json', authorization: 'Bearer ' + session.token },
                body: JSON.stringify({ body: body }),
              });
              var b = await r.json();
              if (r.status === 401) { location.href = '/login'; return; }
              if (!r.ok) { msg.textContent = (b && b.error) || 'submit failed'; return; }
              location.reload();
            } catch (err) { msg.textContent = String(err); }
          });
        })();
      </script>

      <section class="stack">
        <p class="muted">
          <a href="/audit">audit trail</a> · <a href="/proofs">proofs</a> · <a href="/verify">verify</a> · <a href="/methodology">methodology</a>
        </p>
      </section>
    </Fragment>
  ) : (
    <section class="stack">
      <h1>Commitment not found</h1>
      <p class="panel muted">No commitment record for <code>{id}</code>.</p>
      <p><a href="/mandate-holders">← mandate-holders</a></p>
    </section>
  )}
</Base>
