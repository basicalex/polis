---
import Base from '../../layouts/Base.astro';
import '../../styles/tasks.css';
---

<Base title="Private development case">
  <div class="task-page">
    <p class="link-row"><a href="/complaints">Back to my cases</a></p>

    <header class="page-header record-head">
      <p class="page-header-eyebrow status-label" data-tone="warning">Private development case</p>
      <h1 id="case-heading">Loading case…</h1>
      <p id="case-number" class="record-id"></p>
      <p class="page-header-lede">
        This private development case workflow is not a live government service. Case details stay
        private to your signed-in session and authorised case workers.
      </p>
    </header>

    <div id="complaint-auth" class="task-note" role="status">Checking your session…</div>
    <div id="complaint-state" class="task-note" role="status" aria-live="polite">Loading case…</div>

    <div id="complaint-detail" class="task-page" hidden>
      <dl id="case-status" class="record-facts"></dl>

      <section class="task-section" aria-labelledby="narrative-heading">
        <h2 id="narrative-heading">Your complaint</h2>
        <div id="case-narrative" class="prose"></div>
      </section>

      <section class="task-section" aria-labelledby="requests-heading">
        <h2 id="requests-heading">Information requests</h2>
        <div id="information-requests"></div>
      </section>

      <section class="task-section" aria-labelledby="decisions-heading">
        <h2 id="decisions-heading">Decisions</h2>
        <div id="decisions"></div>
      </section>

      <section class="task-section" aria-labelledby="appeal-heading">
        <h2 id="appeal-heading">Appeal</h2>
        <div id="appeal"></div>
      </section>

      <section class="task-section" aria-labelledby="actions-heading">
        <h2 id="actions-heading">Your actions</h2>
        <div id="owner-actions"></div>
      </section>

      <section class="task-section" aria-labelledby="timeline-heading">
        <h2 id="timeline-heading">Case timeline</h2>
        <div id="case-timeline"></div>
      </section>
    </div>

    <p id="complaint-announcement" class="visually-hidden" role="status" aria-live="polite"></p>
  </div>

  <script is:inline>
    window.addEventListener('DOMContentLoaded', function () {
      var API = window.__API_URL;
      var auth = document.getElementById('complaint-auth');
      var detail = document.getElementById('complaint-detail');
      var state = document.getElementById('complaint-state');
      var announcement = document.getElementById('complaint-announcement');
      var caseNumber = document.getElementById('case-number');
      var heading = document.getElementById('case-heading');
      var caseStatus = document.getElementById('case-status');
      var narrative = document.getElementById('case-narrative');
      var requests = document.getElementById('information-requests');
      var decisions = document.getElementById('decisions');
      var appeal = document.getElementById('appeal');
      var actions = document.getElementById('owner-actions');
      var timeline = document.getElementById('case-timeline');
      var session;
      var id = '';

      try {
        id = decodeURIComponent(location.pathname.split('/').filter(Boolean).pop() || '');
      } catch (_error) {
        id = '';
      }

      function textElement(tag, value, className) {
        var element = document.createElement(tag);
        if (className) element.className = className;
        element.textContent = String(value == null ? '' : value);
        return element;
      }

      function fact(label, valueNode) {
        var pair = document.createElement('div');
        pair.append(textElement('dt', label));
        var value = document.createElement('dd');
        value.append(valueNode);
        pair.append(value);
        return pair;
      }

      function emptyState(title, purpose, tips, actionLabel, actionHref, actionVariant) {
        var block = document.createElement('div');
        block.className = 'empty-state';
        block.append(textElement('h3', title, 'empty-state-title'));
        block.append(textElement('p', purpose, 'empty-state-purpose'));
        var tipList = document.createElement('ul');
        tipList.className = 'empty-state-tips';
        tips.forEach(function (tip) {
          tipList.append(textElement('li', tip));
        });
        block.append(tipList);
        if (actionLabel && actionHref) {
          var action = document.createElement('a');
          action.className = 'btn empty-state-action';
          action.setAttribute('data-variant', actionVariant || 'tertiary');
          action.href = actionHref;
          action.textContent = actionLabel;
          block.append(action);
        }
        return block;
      }

      function ledger(tag) {
        var list = document.createElement(tag || 'ul');
        list.className = 'ledger';
        return list;
      }

      function friendlyDate(value) {
        var date = new Date(value);
        return Number.isNaN(date.getTime()) ? String(value == null ? 'Date unavailable' : value) : date.toLocaleString();
      }

      function showState(value) {
        detail.hidden = true;
        state.hidden = false;
        state.className = 'task-note';
        state.textContent = value;
      }

      function showEmptyState(node) {
        detail.hidden = true;
        state.hidden = false;
        state.className = '';
        state.replaceChildren(node);
      }

      function apiError(response, fallback) {
        return response
          .json()
          .then(function (body) {
            return body && typeof body.error === 'string' ? body.error : fallback;
          })
          .catch(function () {
            return fallback;
          });
      }

      function actionMessage(container, value, isError) {
        var message = container.querySelector('[data-action-message]');
        if (!message) {
          message = document.createElement('p');
          message.setAttribute('data-action-message', '');
          message.setAttribute('role', 'status');
          message.setAttribute('aria-live', 'polite');
          container.append(message);
        }
        message.className = isError ? 'field-error' : 'field-hint';
        message.textContent = value;
      }

      function actionForm(labelText, hintText, textareaId, buttonText) {
        var form = document.createElement('form');
        form.className = 'form-narrow';
        var field = document.createElement('div');
        field.className = 'field';
        var label = document.createElement('label');
        label.className = 'field-label';
        label.htmlFor = textareaId;
        label.setAttribute('for', textareaId);
        label.textContent = labelText;
        var textarea = document.createElement('textarea');
        textarea.id = textareaId;
        textarea.rows = 6;
        textarea.maxLength = 10000;
        textarea.required = true;
        field.append(label, textarea, textElement('p', hintText, 'field-hint'));
        var row = document.createElement('div');
        row.className = 'form-actions';
        var button = document.createElement('button');
        button.type = 'submit';
        button.className = 'btn';
        button.setAttribute('data-variant', 'primary');
        button.textContent = buttonText;
        row.append(button);
        form.append(field, row);
        return { form: form, textarea: textarea, button: button };
      }

      function renderRequests(items) {
        if (!items.length) {
          requests.replaceChildren(
            emptyState(
              'No information requests yet',
              'A case worker uses this to ask you for something specific, with a due date you can see.',
              [
                'You are told here when a request needs your answer.',
                'Answers you send are recorded on the case timeline.',
              ],
            ),
          );
          return;
        }
        var list = ledger('ul');
        items.forEach(function (item) {
          var row = document.createElement('li');
          row.append(textElement('h3', 'Request', 'ledger-title'));
          row.append(textElement('p', item.question == null ? 'Question unavailable.' : item.question, 'ledger-summary'));
          var meta = document.createElement('p');
          meta.className = 'ledger-meta';
          meta.append(textElement('span', 'requested ' + friendlyDate(item.createdAt)));
          if (item.dueAt) meta.append(textElement('span', 'due ' + friendlyDate(item.dueAt)));
          row.append(meta);
          if (item.response != null) {
            row.append(textElement('h4', 'Your response', 'ledger-title'));
            row.append(textElement('p', item.response, 'ledger-summary'));
            row.append(textElement('p', 'sent ' + friendlyDate(item.respondedAt), 'ledger-meta'));
          } else {
            var pending = document.createElement('p');
            pending.className = 'ledger-meta';
            pending.append(textElement('span', 'awaiting your response', 'status-label'));
            row.append(pending);
          }
          list.append(row);
        });
        requests.replaceChildren(list);
      }

      function renderDecisions(items) {
        if (!items.length) {
          decisions.replaceChildren(
            emptyState(
              'No decision recorded yet',
              'A decision states the outcome and the reason behind it, so it can be appealed on its own terms.',
              [
                'You may file one appeal once a decision is recorded.',
                'Decisions appear on the case timeline as they are made.',
              ],
            ),
          );
          return;
        }
        var list = ledger('ul');
        items.forEach(function (item) {
          var row = document.createElement('li');
          row.append(textElement('h3', item.kind == null ? 'Decision' : item.kind + ' decision', 'ledger-title'));
          row.append(textElement('p', item.outcome == null ? 'Outcome unavailable.' : item.outcome, 'ledger-summary'));
          row.append(textElement('h4', 'Reason', 'ledger-title'));
          row.append(textElement('p', item.reason == null ? 'Reason unavailable.' : item.reason, 'ledger-summary'));
          row.append(textElement('p', 'recorded ' + friendlyDate(item.decidedAt), 'ledger-meta'));
          list.append(row);
        });
        decisions.replaceChildren(list);
      }

      function renderAppeal(item) {
        if (!item) {
          appeal.replaceChildren(
            emptyState(
              'No appeal filed',
              'One appeal per case can be filed against a recorded decision, stating the grounds.',
              [
                'The appeal form appears here once a decision is recorded.',
                'Grounds you file are kept with the case.',
              ],
            ),
          );
          return;
        }
        var list = ledger('ul');
        var row = document.createElement('li');
        row.append(textElement('h3', item.status == null ? 'Appeal' : item.status + ' appeal', 'ledger-title'));
        row.append(textElement('h4', 'Grounds', 'ledger-title'));
        row.append(textElement('p', item.grounds == null ? 'Grounds unavailable.' : item.grounds, 'ledger-summary'));
        var meta = document.createElement('p');
        meta.className = 'ledger-meta';
        meta.append(textElement('span', 'filed ' + friendlyDate(item.filedAt)));
        if (item.decidedAt) meta.append(textElement('span', 'decided ' + friendlyDate(item.decidedAt)));
        row.append(meta);
        list.append(row);
        appeal.replaceChildren(list);
      }

      function renderTimeline(items) {
        if (!items.length) {
          timeline.replaceChildren(
            emptyState(
              'No timeline events recorded',
              'Every status change on this case is listed here in order, with the time it happened.',
              [
                'Filing, requests, responses, and decisions each add an entry.',
                'Nothing is removed from the timeline once written.',
              ],
            ),
          );
          return;
        }
        var list = document.createElement('ol');
        list.className = 'audit-trail';
        items.forEach(function (item) {
          var row = document.createElement('li');
          row.className = 'audit-event';
          row.append(textElement('strong', item.eventType == null ? 'Case updated' : item.eventType));
          var statusText = item.fromStatus ? String(item.fromStatus) + ' → ' + String(item.toStatus == null ? '' : item.toStatus) : String(item.toStatus == null ? 'status unavailable' : item.toStatus);
          row.append(textElement('span', statusText));
          row.append(textElement('span', friendlyDate(item.occurredAt), 'audit-meta'));
          list.append(row);
        });
        timeline.replaceChildren(list);
      }

      function renderActions(data) {
        var pending = (data.informationRequests || []).find(function (request) {
          return request && request.respondedAt == null;
        });
        if (data.status === 'closed') {
          actions.replaceChildren(
            emptyState(
              'This case is closed',
              'A closed case is read-only. The record above stays readable, and nothing further is expected from you.',
              [
                'File a new case if the matter comes back.',
                'The timeline keeps the full history of this case.',
              ],
              'File another complaint',
              '/complaints',
            ),
          );
          return;
        }
        if (data.status === 'awaiting_information' && pending) {
          var responseAction = document.createElement('section');
          responseAction.className = 'task-section';
          responseAction.append(textElement('p', pending.question == null ? 'Pending request question unavailable.' : pending.question, 'record-statement'));
          var responseForm = actionForm(
            'Response to this request',
            'Your response becomes part of this private development case.',
            'information-response',
            'Send response',
          );
          responseForm.form.addEventListener('submit', async function (event) {
            event.preventDefault();
            var value = responseForm.textarea.value.trim();
            if (!value) {
              actionMessage(responseAction, 'Add a response before sending.', true);
              return;
            }
            responseForm.button.disabled = true;
            actionMessage(responseAction, 'Sending your response…');
            try {
              var response = await fetch(API + '/api/v1/complaints/' + encodeURIComponent(data.id) + '/information-requests/' + encodeURIComponent(pending.id) + '/respond', {
                method: 'POST',
                headers: { 'content-type': 'application/json', authorization: 'Bearer ' + session.token },
                body: JSON.stringify({ response: value }),
              });
              if (response.status === 401) {
                location.href = '/login';
                return;
              }
              if (!response.ok) {
                actionMessage(responseAction, await apiError(response, 'The response could not be sent. Try again.'), true);
                return;
              }
              loadCase();
            } catch (_error) {
              actionMessage(responseAction, 'The response could not be sent. Check your connection and try again.', true);
            } finally {
              responseForm.button.disabled = false;
            }
          });
          responseAction.append(responseForm.form);
          actions.replaceChildren(responseAction);
          return;
        }
        if (data.status === 'decided' && !data.appeal) {
          var appealAction = document.createElement('section');
          appealAction.className = 'task-section';
          var appealForm = actionForm(
            'Grounds for appeal',
            'You may file one appeal against the recorded decision.',
            'appeal-grounds',
            'File appeal',
          );
          appealForm.form.addEventListener('submit', async function (event) {
            event.preventDefault();
            var value = appealForm.textarea.value.trim();
            if (!value) {
              actionMessage(appealAction, 'Add grounds before filing an appeal.', true);
              return;
            }
            appealForm.button.disabled = true;
            actionMessage(appealAction, 'Filing your appeal…');
            try {
              var response = await fetch(API + '/api/v1/complaints/' + encodeURIComponent(data.id) + '/appeals', {
                method: 'POST',
                headers: { 'content-type': 'application/json', authorization: 'Bearer ' + session.token },
                body: JSON.stringify({ grounds: value }),
              });
              if (response.status === 401) {
                location.href = '/login';
                return;
              }
              if (!response.ok) {
                actionMessage(appealAction, await apiError(response, 'The appeal could not be filed. Try again.'), true);
                return;
              }
              loadCase();
            } catch (_error) {
              actionMessage(appealAction, 'The appeal could not be filed. Check your connection and try again.', true);
            } finally {
              appealForm.button.disabled = false;
            }
          });
          appealAction.append(appealForm.form);
          actions.replaceChildren(appealAction);
          return;
        }
        actions.replaceChildren(
          emptyState(
            'Nothing to do right now',
            'This is where your next step appears: answering an information request, or filing an appeal against a decision.',
            [
              'The case worker moves the case on; you are told here when it is your turn.',
              'Watch the timeline below for the latest status change.',
            ],
          ),
        );
      }

      function renderCase(data) {
        caseNumber.textContent = String(data.caseNumber == null ? 'Case' : data.caseNumber);
        heading.textContent = String(data.subject == null ? 'Untitled case' : data.subject);
        caseStatus.replaceChildren(
          fact('Status', textElement('span', data.status == null ? 'unknown' : data.status, 'status-label')),
          fact('Last updated', textElement('span', friendlyDate(data.updatedAt))),
        );
        narrative.replaceChildren(textElement('p', data.narrative == null ? 'Narrative unavailable.' : data.narrative));
        renderRequests(Array.isArray(data.informationRequests) ? data.informationRequests : []);
        renderDecisions(Array.isArray(data.decisions) ? data.decisions : []);
        renderAppeal(data.appeal);
        renderActions(data);
        renderTimeline(Array.isArray(data.events) ? data.events : []);
        announcement.textContent = 'Case loaded.';
        state.hidden = true;
        state.replaceChildren();
        detail.hidden = false;
      }

      function loadCase() {
        showState('Loading case…');
        fetch(API + '/api/v1/complaints/' + encodeURIComponent(id), {
          headers: { authorization: 'Bearer ' + session.token },
        })
          .then(async function (response) {
            if (response.status === 401) {
              location.href = '/login';
              return null;
            }
            if (response.status === 404) throw new Error('This case was not found.');
            if (!response.ok) throw new Error(await apiError(response, 'The case could not be loaded.'));
            return response.json();
          })
          .then(function (data) {
            if (data) renderCase(data);
          })
          .catch(function (error) {
            heading.textContent = 'Case unavailable';
            caseNumber.textContent = id;
            showEmptyState(
              emptyState(
                'This case could not be loaded',
                error && error.message ? error.message : 'The case service did not answer, so nothing is shown here.',
                [
                  'Start the backend from the repository root: bun run dev:services.',
                  'Load the fixtures once the services are up: bun run db:seed.',
                  'Only the person who filed a case, and authorised case workers, can read it.',
                ],
                'Back to my cases',
                '/complaints',
                'primary',
              ),
            );
          });
      }

      try {
        var raw = sessionStorage.getItem('web_session');
        session = raw ? JSON.parse(raw) : null;
      } catch (_error) {
        session = null;
      }
      if (!session || typeof session.token !== 'string' || !session.token) {
        auth.hidden = true;
        heading.textContent = 'Case is private';
        caseNumber.textContent = id;
        showEmptyState(
          emptyState(
            'Sign in to read this case',
            'Cases are private to the person who filed them, so nothing is shown until you sign in.',
            [
              'Sign-in uses a development magic link; no real identity is checked.',
              'You are returned to your case list after signing in.',
            ],
            'Sign in',
            '/login',
            'primary',
          ),
        );
        return;
      }
      if (!id) {
        auth.hidden = true;
        heading.textContent = 'Case link is invalid';
        showEmptyState(
          emptyState(
            'No case id in this link',
            'A case link carries the case id in its path, and this one carries none, so there is nothing to load.',
            [
              'Open the case from your case list instead of typing the link.',
              'Case ids are shown under the case title.',
            ],
            'Back to my cases',
            '/complaints',
            'primary',
          ),
        );
        return;
      }
      auth.hidden = true;
      loadCase();
    });
  </script>
</Base>
