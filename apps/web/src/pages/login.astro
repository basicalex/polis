---
import Base from '../layouts/Base.astro';
import '../styles/tasks.css';
---
<Base title="Polis Interface — Sign in">
<div class="task-page form-narrow">
  <header class="page-header">
    <h1>Sign in</h1>
    <p class="page-header-lede">
      Sign in to ask questions on commitments. Public reads stay open without signing in.
    </p>
  </header>

  <div id="logged-in" class="task-section" hidden>
    <p class="record-statement">Signed in as <strong id="user-email"></strong>.</p>
    <p class="link-row"><a href="/mandate-holders">Browse mandate-holders</a></p>
  </div>

  <form id="login-form" class="task-section">
    <div class="field">
      <label class="field-label" for="email">Email</label>
      <input type="email" id="email" name="email" autocomplete="email" placeholder="you@example.com" />
      <p class="field-hint">
        We send a magic link to this address. In local development the token is shown here instead
        of being emailed.
      </p>
    </div>
    <p id="error" class="field-error" role="alert" hidden></p>
    <div class="form-actions">
      <button id="send-btn" type="submit" class="btn" data-variant="primary">Send magic link</button>
    </div>
    <div id="token-section" class="task-section" hidden>
      <p class="notice">
        <span>Development token — in production this arrives by email.</span>
        <code id="dev-token" class="hash-value"></code>
      </p>
      <div class="form-actions">
        <button id="exchange-btn" type="button" class="btn" data-variant="primary">
          Exchange for session
        </button>
      </div>
    </div>
    <div id="oidc-section" class="form-actions" hidden>
      <button id="keycloak-btn" type="button" class="btn" data-variant="secondary">
        Sign in with Keycloak
      </button>
    </div>
  </form>
</div>
<script is:inline>
const API = window.__API_URL;
const session = sessionStorage.getItem('web_session');
if (session) {
  document.getElementById('logged-in').hidden = false;
  document.getElementById('login-form').hidden = true;
  try { document.getElementById('user-email').textContent = JSON.parse(session).email || 'citizen'; } catch {}
}
document.getElementById('login-form').addEventListener('submit', async (event) => {
  event.preventDefault();
  const email = document.getElementById('email').value.trim();
  if (!email) return;
  document.getElementById('error').hidden = true;
  try {
    const r = await fetch(API + '/api/v1/identity/magic-link', {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ email }),
    });
    if (!r.ok) throw new Error('Failed to send magic link');
    const dr = await fetch(API + '/api/v1/identity/dev-tokens');
    if (dr.ok) {
      const db = await dr.json();
      const token = db.tokens?.[email];
      if (token) {
        document.getElementById('dev-token').textContent = token;
        document.getElementById('token-section').hidden = false;
        // One primary action at a time: exchanging the token is now the step.
        document.getElementById('send-btn').dataset.variant = 'secondary';
        window._exchangeEmail = email;
        window._exchangeToken = token;
      }
    }
  } catch (e) {
    document.getElementById('error').textContent = e.message;
    document.getElementById('error').hidden = false;
  }
});
document.getElementById('exchange-btn').onclick = async () => {
  const email = window._exchangeEmail;
  const token = window._exchangeToken;
  if (!email || !token) return;
  try {
    const r = await fetch(API + '/api/v1/identity/exchange', {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ email, token }),
    });
    if (!r.ok) throw new Error('Exchange failed');
    const body = await r.json();
    sessionStorage.setItem('web_session', JSON.stringify({
      token: body.sessionToken,
      email,
      citizenId: body.citizen?.id,
      identityLevel: body.citizen?.identityLevel,
    }));
    location.href = '/mandate-holders';
  } catch (e) {
    document.getElementById('error').textContent = e.message;
    document.getElementById('error').hidden = false;
  }
};
// M10 OIDC: show the Keycloak button only when the identity seam is OIDC-enabled
// (GET /authorize → 200). In stub dev mode it 404s and this stays hidden, so the
// magic-link flow remains the only option (byte-identical to before).
(async () => {
  try {
    const r = await fetch(API + '/api/v1/identity/authorize?redirect_uri=' + encodeURIComponent(location.origin + '/login/callback'));
    if (r.ok) document.getElementById('oidc-section').hidden = false;
  } catch {}
})();
document.getElementById('keycloak-btn').onclick = async () => {
  document.getElementById('error').hidden = true;
  try {
    const r = await fetch(API + '/api/v1/identity/authorize?redirect_uri=' + encodeURIComponent(location.origin + '/login/callback'));
    if (!r.ok) throw new Error('OIDC not available');
    const body = await r.json();
    if (body.authorizationUrl) location.href = body.authorizationUrl;
  } catch (e) {
    document.getElementById('error').textContent = e.message;
    document.getElementById('error').hidden = false;
  }
};
</script>
</Base>
