---
import Base from '../layouts/Base.astro';
import MechanismTable from '@polis/ui/astro/MechanismTable.astro';
import ProofTruthNote from '@polis/ui/astro/ProofTruthNote.astro';
import { VerifierFlow } from '@polis/ui/react/VerifierFlow.tsx';

const apiUrl = import.meta.env.PUBLIC_API_URL ?? 'http://localhost:8080';
---

<Base title="Document verifier · Polis Verifier">
  <div class="stack">
    <section class="hero">
      <p class="badge">§15.2 Document proof verifier</p>
      <h1>Verify a document</h1>
      <p>
        Drop a file, paste its SHA-256 hash, or paste a proof link. Files are hashed on your
        device — they are never uploaded. Only the hash is sent to the public proof registry.
      </p>
      <ProofTruthNote />
    </section>

    <section class="panel">
      <VerifierFlow client:load apiUrl={apiUrl} proofBasePath="/proofs" />
    </section>

    <MechanismTable />
  </div>
</Base>
