---
import '../styles.css';
import DemoBadge from '@polis/ui/astro/DemoBadge.astro';

const {
  title = 'Polis Verifier',
  description = 'Independent verifier for Polis document proofs: client-side hashing, signature and timestamp checks against the public proof registry.',
} = Astro.props;
---

<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <div class="site-shell">
      <DemoBadge banner />
      <header class="site-header">
        <a class="site-brand" href="/">Polis Verifier</a>
        <nav class="site-nav" aria-label="Primary">
          <a href="/verify">Verify</a>
          <a href="/governance">Governance</a>
          <a href="/deliberate">Deliberate</a>
          <a href="/audit">Audit</a>
          <a href="/transparency">Transparency</a>
          <a href="/privacy">Privacy</a>
        </nav>
      </header>
      <main class="site-main"><slot /></main>
      <footer class="site-footer">
        Source: https://github.com/basicalex/polis · AGPL-3.0-or-later · v0.1.0-v1
      </footer>
    </div>
  </body>
</html>
