---
import Base from '../layouts/Base.astro';
import DemoBadge from '@polis/ui/astro/DemoBadge.astro';

const API = import.meta.env.PUBLIC_API_URL ?? 'http://localhost:8080';
const WEB = import.meta.env.PUBLIC_WEB_URL ?? 'http://localhost:4321';
---
<Base title="Reviewer Admin — Official drafting">
<section class="panel stack">
  <DemoBadge label="demonstration — post-pilot official onboarding identity, not production" />
  <h1>Official drafting</h1>
  <p class="muted">
    This demonstration surface lets a <strong>verified_official</strong> file accountability commitments,
    resolution claims, and answers after the pilot onboarding path exists. The signed-in identity is a
    demonstration identity only; submissions become public-read contributions only after review.
  </p>
  <p class="muted">
    Commitments and resolutions are <strong>accountability, not endorsement</strong>: public-read,
    verifiable records connected to <a href="/audit">/audit</a>, <a href="/proofs">/proofs</a>, and
    <a href="/verify">/verify</a>. You propose an outcome; review decides whether it publishes.
  </p>
  <p class="muted">
    Filing needs a signed charter. Sign the charter first, then the forms below open.
  </p>
  <div id="gate" style="display:none">
    <p id="gate-msg" class="panel"></p>
    <p><a href="/login">← back to login</a></p>
  </div>
  <div id="drafting" style="display:none">
    <p>Signed in as <strong id="who"></strong> (<code id="who-level"></code>).</p>
    <div id="mandates"></div>
    <p class="muted">Filed-but-pending submissions appear in the <a href="/review">review queue</a>.</p>
  </div>
</section>
<script is:inline define:vars={{ API, WEB }}>
function authHeader(session) { return { 'content-type': 'application/json', authorization: 'Bearer ' + session.token }; }
function el(html) { const d = document.createElement('div'); d.innerHTML = html; return d.firstElementChild; }
function esc(value) {
  return String(value ?? '').replace(/[&<>"']/g, (ch) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[ch]);
}
const SIGNING_STATE_TEXT = {
  created: 'Signing request created.',
  distributed: 'Charter sent for signature.',
  awaiting_signatures: 'Waiting for your signature.',
  completed: 'Signed. Polis is storing the document and registering the proof.',
  declined: 'Signing declined. Start a new request to try again.',
  expired: 'Signing request expired. Start a new request.',
  voided: 'Signing request cancelled. Start a new request.',
  failed: 'Signing failed. Start a new request.',
};
const SIGNING_IN_FLIGHT = { created: true, distributed: true, awaiting_signatures: true, completed: true };

function shortHash(value) {
  const hash = String(value ?? '');
  return hash.length > 20 ? hash.slice(0, 12) + '…' + hash.slice(-6) : hash;
}

function hashBlock(hash) {
  return '<code class="hash-value" title="' + esc(hash) + '">' + esc(shortHash(hash)) + '</code>' +
    '<details><summary class="muted">full hash</summary><p class="hash-value">' + esc(hash) + '</p></details>';
}

function charterScopeText(detail) {
  const doc = detail && typeof detail.charterDoc === 'object' ? detail.charterDoc : null;
  const scope = doc && typeof doc.scope === 'object' ? doc.scope : null;
  if (scope) {
    const jurisdictions = Array.isArray(scope.jurisdictions) ? scope.jurisdictions.join(', ') : '';
    const processes = Array.isArray(scope.processes) ? scope.processes.join(', ') : '';
    if (jurisdictions || processes) {
      return 'jurisdictions: ' + (jurisdictions || 'none') + ' · processes: ' + (processes || 'none');
    }
  }
  return 'jurisdiction ' + (detail && detail.jurisdictionId ? detail.jurisdictionId : 'not recorded');
}

function compactBody(entries) {
  const body = {};
  for (const [key, value] of Object.entries(entries)) {
    if (value !== undefined && value !== null && String(value).trim() !== '') body[key] = String(value).trim();
  }
  return body;
}

async function loadDrafting(session) {
  document.getElementById('who').textContent = session.email || session.citizenId;
  document.getElementById('who-level').textContent = session.identityLevel || 'unknown';
  if (session.identityLevel !== 'verified_official') {
    document.getElementById('gate').style.display = 'block';
    document.getElementById('gate-msg').textContent = 'Only a verified_official (mandate-holder) may draft. Your identity level is ' + (session.identityLevel || 'unknown') + '.';
    return;
  }
  // Claims for the commitment <select> (proposal_assertion | public_statement).
  const claimsResp = await fetch(API + '/api/v1/claims');
  const claimsBody = claimsResp.ok ? await claimsResp.json() : { items: [] };
  const claims = (claimsBody.items ?? []).filter((c) => c.claimType === 'proposal_assertion' || c.claimType === 'public_statement');

  const mhResp = await fetch(API + '/api/v1/mandate-holders');
  const mhBody = mhResp.ok ? await mhResp.json() : { items: [] };
  const mine = (mhBody.items ?? []).filter((h) => h.citizenId === session.citizenId && h.status === 'active');

  const root = document.getElementById('mandates');
  if (mine.length === 0) {
    root.innerHTML = '<p class="panel muted">No active mandates bound to your citizen identity.</p>';
    return;
  }
  for (const mh of mine) {
    const detailResp = await fetch(API + '/api/v1/mandate-holders/' + mh.id);
    const detail = detailResp.ok ? await detailResp.json() : { commitments: [] };
    const commitments = detail.commitments ?? [];
    const claimOptions = claims.map((c) => '<option value="' + esc(c.id) + '">' + esc(c.text).slice(0, 80) + ' (' + esc(c.claimType) + ')</option>').join('');
    const card = el('<section class="card stack"></section>');
    card.innerHTML = '<h2>' + esc(mh.displayName) + ' <span class="badge">' + esc(mh.status) + '</span></h2>' +
      '<p class="muted">Demonstration official drafting: public-read, verifiable accountability records only after review.</p>' +
      '<section class="panel stack charter-panel"><p class="muted">Loading charter…</p></section>' +
      '<div class="charter-gated stack">' +
      '<p class="trust-note gate-note">Filing is closed until this charter is signed and accepted.</p>' +
      '<h3>File a commitment</h3>' +
      '<form class="stack" data-commitment data-mh="' + esc(mh.id) + '">' +
        '<label>Commitment type <select name="sourceType"><option value="text">Typed text commitment</option><option value="claim">Existing claim</option></select></label>' +
        '<label>Commitment text <textarea name="text" rows="3" style="width:100%" placeholder="Plain-language commitment"></textarea></label>' +
        '<label>Promise claim <select name="claimId"><option value="">Select an existing claim…</option>' + claimOptions + '</select></label>' +
        '<label>Claim type <select name="claimType"><option value="">Default</option><option value="proposal_assertion">proposal_assertion</option><option value="public_statement">public_statement</option></select></label>' +
        '<label>Success criterion <textarea name="successCriterion" rows="2" style="width:100%"></textarea></label>' +
        '<label>Due at <input type="date" name="dueAt"/></label>' +
        '<label>Process id <input name="processId" autocomplete="off"/></label>' +
        '<label>Jurisdiction id <input name="jurisdictionId" autocomplete="off"/></label>' +
        '<button type="submit">File commitment</button>' +
        '<p class="muted">The request body contains text or claimId, successCriterion, and optional dueAt/processId/jurisdictionId only.</p>' +
        '<p class="muted form-msg"></p>' +
      '</form>' +
      '<h3>Commitment resolutions</h3>' +
      '<p class="muted">Propose an outcome and the claim that backs it. Review decides whether it publishes.</p>' +
      '<div class="commitment-resolutions"></div>' +
      '<h3>Unanswered questions</h3>' +
      '<div class="pending-questions">Loading…</div>' +
      '</div>';
    root.appendChild(card);
    applyCharterGate(card, false);

    card.querySelector('[data-commitment]').addEventListener('submit', async (e) => {
      e.preventDefault();
      const f = e.currentTarget;
      const msg = f.querySelector('.form-msg');
      const body = compactBody({
        successCriterion: f.successCriterion.value,
        dueAt: f.dueAt.value,
        processId: f.processId.value,
        jurisdictionId: f.jurisdictionId.value,
      });
      if (f.sourceType.value === 'claim') body.claimId = f.claimId.value;
      else body.text = f.text.value;
      if (f.claimType.value) body.claimType = f.claimType.value;
      if (!body.successCriterion || (!body.text && !body.claimId)) {
        msg.textContent = 'Commitment text or claim and success criterion are required.';
        return;
      }
      try {
        const r = await fetch(API + '/api/v1/mandate-holders/' + f.dataset.mh + '/commitments', {
          method: 'POST', headers: authHeader(session), body: JSON.stringify(body),
        });
        const b = await r.json();
        if (r.status === 401) { location.href = '/login'; return; }
        if (!r.ok) { msg.textContent = (b && b.error) || 'filing failed'; return; }
        msg.textContent = 'Filed — pending review. See /review.';
        f.reset();
      } catch (err) { msg.textContent = String(err); }
    });

    renderResolutionForms(card.querySelector('.commitment-resolutions'), commitments, session);
    await loadPendingQuestions(card.querySelector('.pending-questions'), commitments, session);
    await refreshCharter(card, mh.id, session, detail);
  }
}

function applyCharterGate(card, accepted) {
  const gated = card.querySelector('.charter-gated');
  for (const control of gated.querySelectorAll('input, textarea, select, button')) control.disabled = !accepted;
  gated.querySelector('.gate-note').style.display = accepted ? 'none' : 'block';
}

/** Reload the charter projection + latest signing request, then repaint the panel. */
async function refreshCharter(card, mandateHolderId, session, preloadedDetail) {
  const panel = card.querySelector('.charter-panel');
  let detail = preloadedDetail;
  if (!detail) {
    const r = await fetch(API + '/api/v1/mandate-holders/' + mandateHolderId);
    detail = r.ok ? await r.json() : {};
  }
  let signing = null;
  const sr = await fetch(API + '/api/v1/mandate-holders/' + mandateHolderId + '/charter-signing-status', {
    headers: authHeader(session),
  });
  if (sr.status === 401) { location.href = '/login'; return; }
  if (sr.ok) signing = await sr.json();
  renderCharterPanel(panel, card, mandateHolderId, session, detail, signing);
  applyCharterGate(card, detail.charterStatus === 'accepted');
}

function renderCharterPanel(panel, card, mandateHolderId, session, detail, signing) {
  const status = detail.charterStatus || 'none';
  const accepted = status === 'accepted';
  const inFlight = signing && SIGNING_IN_FLIGHT[signing.status] === true;
  const tone = accepted ? 'valid' : status === 'none' ? 'unknown' : 'warning';
  let html = '<h3>Charter</h3>' +
    '<p><span class="trust-badge" data-tone="' + tone + '">charter ' + esc(status) + '</span>' +
    (detail.charterVersion ? ' <span class="badge">version ' + esc(detail.charterVersion) + '</span>' : '') + '</p>' +
    '<p class="muted">Scope on file — ' + esc(charterScopeText(detail)) + '</p>';

  if (status === 'none') {
    html += '<p class="trust-note">No charter on file for this mandate. An administrator files one before you can sign.</p>';
  } else if (accepted) {
    html += '<dl class="kv">' +
      '<dt>Signed</dt><dd>' + esc(detail.charterSignedAt || 'not recorded') + '</dd>' +
      '<dt>Signed document hash</dt><dd>' + (detail.charterSignedDocumentHash ? hashBlock(detail.charterSignedDocumentHash) : 'not recorded') + '</dd>' +
      '</dl>' +
      (detail.charterProofId
        ? '<p><a href="' + esc(WEB) + '/proofs/' + encodeURIComponent(detail.charterProofId) + '">public proof for the signed charter →</a></p>'
        : '<p class="muted">No public proof registered yet.</p>') +
      '<p class="muted">Next: file commitments, resolutions, and answers below.</p>';
  } else if (inFlight) {
    html += '<p>' + esc(SIGNING_STATE_TEXT[signing.status] || signing.status) + '</p>' +
      '<p class="muted">Signing state: <code>' + esc(signing.status) + '</code></p>' +
      '<p><button type="button" data-charter-refresh>Refresh signing status</button>' +
      (signing.provider === 'stub'
        ? ' <button type="button" data-charter-stub>Complete signing (local stub)</button>'
        : '') + '</p>' +
      (signing.provider === 'stub'
        ? '<p class="trust-note trust-note--compact">Test only: the local stub provider signs on your behalf. A real provider never offers this.</p>'
        : '');
  } else {
    html += (signing ? '<p>' + esc(SIGNING_STATE_TEXT[signing.status] || signing.status) + '</p>' : '') +
      '<p class="muted">Next: start the signing ceremony. Polis stores the signed PDF and registers a proof over its bytes before the charter is accepted.</p>' +
      '<p><button type="button" data-charter-initiate>Initiate charter signing</button></p>';
  }
  html += '<p class="muted charter-msg"></p>';
  panel.innerHTML = html;

  const msg = panel.querySelector('.charter-msg');
  const initiate = panel.querySelector('[data-charter-initiate]');
  if (initiate) {
    initiate.addEventListener('click', async () => {
      initiate.disabled = true;
      msg.textContent = 'Starting signing…';
      try {
        const r = await fetch(API + '/api/v1/mandate-holders/' + mandateHolderId + '/charter-signing-requests', {
          method: 'POST',
          headers: Object.assign({ 'idempotency-key': crypto.randomUUID() }, authHeader(session)),
        });
        if (r.status === 401) { location.href = '/login'; return; }
        const b = await r.json().catch(() => null);
        if (!r.ok) { msg.textContent = (b && b.error) || 'signing request failed'; initiate.disabled = false; return; }
        await pollCharter(card, mandateHolderId, session);
      } catch (err) {
        msg.textContent = String(err);
        initiate.disabled = false;
      }
    });
  }
  const stub = panel.querySelector('[data-charter-stub]');
  if (stub && signing) {
    stub.addEventListener('click', async () => {
      stub.disabled = true;
      msg.textContent = 'Completing the stub signature…';
      try {
        const r = await fetch(API + '/api/v1/signing-requests/' + signing.id + '/stub-complete', {
          method: 'POST',
          headers: authHeader(session),
        });
        if (r.status === 401) { location.href = '/login'; return; }
        const b = await r.json().catch(() => null);
        if (!r.ok) { msg.textContent = (b && b.error) || 'stub completion failed'; stub.disabled = false; return; }
        await pollCharter(card, mandateHolderId, session);
      } catch (err) {
        msg.textContent = String(err);
        stub.disabled = false;
      }
    });
  }
  const refresh = panel.querySelector('[data-charter-refresh]');
  if (refresh) {
    refresh.addEventListener('click', async () => {
      refresh.disabled = true;
      await refreshCharter(card, mandateHolderId, session, null);
    });
  }
}

/** Reconciliation is asynchronous, so re-read the charter a few times before giving up. */
async function pollCharter(card, mandateHolderId, session) {
  for (let attempt = 0; attempt < 5; attempt += 1) {
    await refreshCharter(card, mandateHolderId, session, null);
    const badge = card.querySelector('.charter-panel .trust-badge');
    if (badge && badge.textContent.trim() === 'charter accepted') return;
    await new Promise((resolve) => setTimeout(resolve, 1500));
  }
  await refreshCharter(card, mandateHolderId, session, null);
}

function renderResolutionForms(container, commitments, session) {
  if (commitments.length === 0) {
    container.innerHTML = '<p class="muted">No official commitments loaded from /api/v1/mandate-holders/:id.</p>';
    return;
  }
  container.innerHTML = '';
  for (const commitment of commitments) {
    const item = el('<div class="card stack"></div>');
    item.innerHTML =
      '<p class="muted">Commitment: ' + esc(commitment.successCriterion || commitment.text || commitment.claimId || commitment.id) + '</p>' +
      '<form class="stack" data-resolution data-commitment="' + esc(commitment.id) + '">' +
        '<label>Outcome <select name="status">' +
          '<option value="">Select an outcome…</option>' +
          '<option value="delivered">delivered</option>' +
          '<option value="partial">partial</option>' +
          '<option value="not_delivered">not_delivered</option>' +
        '</select></label>' +
        '<label>Resolution claim <textarea name="text" rows="2" style="width:100%" placeholder="Evidence-backed resolution claim"></textarea></label>' +
        '<button type="submit">File resolution</button>' +
        '<p class="muted">Review adjudicates the outcome you propose before it publishes.</p>' +
        '<p class="muted form-msg"></p>' +
      '</form>';
    container.appendChild(item);
    item.querySelector('[data-resolution]').addEventListener('submit', async (e) => {
      e.preventDefault();
      const f = e.currentTarget;
      const msg = f.querySelector('.form-msg');
      const payload = compactBody({ status: f.elements.status.value, text: f.elements.text.value });
      if (!payload.status) { msg.textContent = 'Select an outcome.'; return; }
      if (!payload.text) { msg.textContent = 'Resolution claim required.'; return; }
      try {
        const r = await fetch(API + '/api/v1/commitments/' + f.dataset.commitment + '/resolutions', {
          method: 'POST', headers: authHeader(session), body: JSON.stringify(payload),
        });
        const b = await r.json();
        if (r.status === 401) { location.href = '/login'; return; }
        if (!r.ok) { msg.textContent = (b && b.error) || 'filing failed'; return; }
        msg.textContent = 'Resolution filed — pending review.';
        f.reset();
      } catch (err) { msg.textContent = String(err); }
    });
  }
}

async function loadPendingQuestions(container, commitments, session) {
  const pending = [];
  for (const c of commitments) {
    const qr = await fetch(API + '/api/v1/commitments/' + c.id + '/questions');
    const qb = qr.ok ? await qr.json() : { items: [] };
    for (const q of (qb.items ?? [])) {
      if (q.answer === null || q.answer === undefined) pending.push({ commitment: c, question: q });
    }
  }
  if (pending.length === 0) { container.innerHTML = '<p class="muted">No unanswered questions.</p>'; return; }
  container.innerHTML = '';
  for (const { commitment, question } of pending) {
    const item = el('<div class="card stack"></div>');
    item.innerHTML =
      '<p class="muted">Commitment: ' + esc(commitment.successCriterion || commitment.id) + '</p>' +
      '<blockquote>' + esc(question.body || question.text || question.question || '') + '</blockquote>' +
      '<form class="stack" data-answer data-commitment="' + esc(commitment.id) + '" data-question="' + esc(question.id) + '">' +
        '<label>Answer <textarea name="answer" rows="2" style="width:100%"></textarea></label>' +
        '<button type="submit">File answer</button>' +
        '<p class="muted form-msg"></p>' +
      '</form>';
    container.appendChild(item);
    item.querySelector('[data-answer]').addEventListener('submit', async (e) => {
      e.preventDefault();
      const f = e.currentTarget;
      const msg = f.querySelector('.form-msg');
      const body = compactBody({ body: f.answer.value });
      if (!body.body) { msg.textContent = 'Answer text required.'; return; }
      try {
        const r = await fetch(API + '/api/v1/commitment-questions/' + f.dataset.question + '/answers', {
          method: 'POST', headers: authHeader(session), body: JSON.stringify(body),
        });
        const b = await r.json();
        if (r.status === 401) { location.href = '/login'; return; }
        if (!r.ok) { msg.textContent = (b && b.error) || 'filing failed'; return; }
        msg.textContent = 'Answer filed — pending review.';
        f.reset();
      } catch (err) { msg.textContent = String(err); }
    });
  }
}

const raw = sessionStorage.getItem('admin_session');
if (!raw) { location.href = '/login'; }
else {
  let session;
  try { session = JSON.parse(raw); } catch { session = null; }
  if (!session || !session.token) { location.href = '/login'; }
  else {
    document.getElementById('drafting').style.display = 'block';
    loadDrafting(session).catch((err) => {
      const g = document.getElementById('gate');
      g.style.display = 'block';
      document.getElementById('gate-msg').textContent = 'Failed to load drafting: ' + String(err);
    });
  }
}
</script>
</Base>
