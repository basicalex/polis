---
import Base from '../layouts/Base.astro';

const API = import.meta.env.PUBLIC_API_URL ?? 'http://localhost:8080';
---

<Base title="AI traces">
  <h1>AI assistant traces</h1>
  <p class="muted">
    Read-only internal trace viewer (spec §17.5). Each row is one assistant
    request with its effective output state. Approve/reject decisions are made
    via the internal API and exercised by <code>scripts/phase5-acceptance.mjs</code>.
  </p>
  <section class="panel" aria-live="polite">
    <p id="trace-status" class="muted">Loading assistant traces…</p>
    <table id="trace-table" hidden>
      <thead>
        <tr>
          <th>Trace</th>
          <th>Confidence</th>
          <th>Published</th>
          <th>Review</th>
          <th>Risk flags</th>
          <th>Created</th>
        </tr>
      </thead>
      <tbody id="trace-rows"></tbody>
    </table>
  </section>

  <script is:inline define:vars={{ API }}>
    const status = document.getElementById('trace-status');
    const table = document.getElementById('trace-table');
    const rows = document.getElementById('trace-rows');

    const setStatus = (message) => {
      if (status) status.textContent = message;
      if (table) table.hidden = true;
    };

    const sessionJson = window.sessionStorage.getItem('admin_session');
    if (!sessionJson) {
      setStatus('Staff access required. Sign in with a staff account to view assistant traces.');
    } else {
      let token = '';
      try {
        token = JSON.parse(sessionJson)?.token ?? '';
      } catch {
        token = '';
      }

      if (!token) {
        setStatus('Staff access required. Sign in with a staff account to view assistant traces.');
      } else {
        fetch(API + '/api/v1/assistant/traces', {
          headers: { Authorization: 'Bearer ' + token },
        })
          .then((response) => {
            if (response.status === 401 || response.status === 403) {
              setStatus('Staff access required. Your session is not authorized to view assistant traces.');
              return null;
            }
            if (!response.ok) {
              setStatus('Assistant traces could not be loaded. Try again later.');
              return null;
            }
            return response.json();
          })
          .then((body) => {
            if (!body || !rows || !table || !status) return;
            const traces = Array.isArray(body.items) ? body.items : [];
            rows.replaceChildren();

            if (traces.length === 0) {
              setStatus('No traces yet.');
              return;
            }

            for (const trace of traces) {
              const output = Array.isArray(trace.outputs) ? trace.outputs[0] : null;
              const tr = document.createElement('tr');
              const cells = [
                (trace.traceId ?? '').slice(0, 8) || '—',
                output?.confidenceState ?? '—',
                output?.effectivePublished ? 'yes' : 'no',
                output?.effectiveReviewState ?? '—',
                Array.isArray(trace.riskFlags) && trace.riskFlags.length > 0 ? trace.riskFlags.join(', ') : '—',
                trace.createdAt ?? '—',
              ];

              for (const value of cells) {
                const td = document.createElement('td');
                td.textContent = value;
                tr.append(td);
              }

              rows.append(tr);
            }

            status.textContent = '';
            table.hidden = false;
          })
          .catch(() => {
            setStatus('Assistant traces could not be loaded. Try again later.');
          });
      }
    }
  </script>
</Base>
