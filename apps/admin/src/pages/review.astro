---
import Base from '../layouts/Base.astro';

const API = import.meta.env.PUBLIC_API_URL ?? 'http://localhost:8080';
---

<Base title="Review queue">
  <section class="panel">
  <h1>Contribution review queue</h1>
  <p class="muted">
    Pending submissions awaiting a reviewer decision (spec §19). Admin is
    static-hosted, so the queue is fetched live in the browser. The queue and
    every decision need a staff session; the signed-in reviewer is recorded
    server-side. Approve/reject decisions are exercised end-to-end by
    <code>scripts/phase6-acceptance.mjs</code>.
  </p>
  <p id="review-msg" class="trust-note" style="display:none"></p>
  <table class="data-table">
    <thead>
      <tr>
        <th>Submission</th>
        <th>Type</th>
        <th>Class</th>
        <th>Contributor</th>
        <th>Status</th>
        <th>Submitted</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody id="queue"></tbody>
  </table>
  </section>

  <script is:inline define:vars={{ API }}>
    const raw = sessionStorage.getItem('admin_session');
    let session = null;
    try { session = raw ? JSON.parse(raw) : null; } catch { session = null; }
    if (!session || !session.token) location.href = '/login';

    function authHeader() {
      return { 'content-type': 'application/json', authorization: 'Bearer ' + session.token };
    }
    function showMessage(text) {
      const box = document.getElementById('review-msg');
      box.textContent = text;
      box.style.display = text ? 'block' : 'none';
    }
    function replaceWithMessage(tbody, message) {
      const row = document.createElement('tr');
      const cell = document.createElement('td');
      cell.colSpan = 7;
      cell.textContent = message;
      row.append(cell);
      tbody.replaceChildren(row);
    }
    function appendTextCell(row, value, tagName) {
      const cell = document.createElement('td');
      if (tagName) {
        const content = document.createElement(tagName);
        content.textContent = value;
        cell.append(content);
      } else {
        cell.textContent = value;
      }
      row.append(cell);
    }
    function decisionButton(id, decision, label) {
      const button = document.createElement('button');
      button.textContent = label;
      button.addEventListener('click', function () {
        decide(id, decision);
      });
      return button;
    }
    function renderSubmission(submission) {
      const row = document.createElement('tr');
      appendTextCell(row, submission.id.slice(0, 12), 'code');
      appendTextCell(row, submission.type);
      appendTextCell(row, submission.contributionClass);
      appendTextCell(row, submission.contributorDisplayName ?? '—');
      appendTextCell(row, submission.status);
      appendTextCell(row, submission.submittedAt);
      const actions = document.createElement('td');
      actions.append(
        decisionButton(submission.id, 'approve', 'Approve'),
        document.createTextNode(' '),
        decisionButton(submission.id, 'reject', 'Reject'),
      );
      row.append(actions);
      return row;
    }
    async function loadQueue() {
      const tbody = document.getElementById('queue');
      try {
        const r = await fetch(API + '/api/v1/review/queue', { headers: authHeader() });
        if (r.status === 401 || r.status === 403) {
          showMessage('Staff session required. Sign in with a staff account to review submissions.');
          replaceWithMessage(tbody, 'Queue hidden.');
          return;
        }
        showMessage('');
        const data = r.ok ? await r.json() : { items: [] };
        const items = data.items ?? [];
        if (items.length === 0) {
          replaceWithMessage(tbody, 'No pending submissions.');
          return;
        }
        tbody.replaceChildren(...items.map(renderSubmission));
      } catch {
        replaceWithMessage(tbody, 'Failed to load queue.');
      }
    }
    async function decide(id, decision) {
      try {
        const r = await fetch(API + '/api/v1/review/' + id + '/decide', {
          method: 'POST',
          headers: authHeader(),
          body: JSON.stringify({ decision: decision, notes: '' }),
        });
        if (r.status === 401 || r.status === 403) {
          showMessage('Staff session required. This decision was not recorded.');
          return;
        }
        if (!r.ok) {
          const b = await r.json().catch(() => null);
          showMessage('Decision failed: ' + ((b && b.error) || r.status));
          return;
        }
        showMessage('');
      } catch (err) {
        showMessage('Decision failed: ' + String(err));
        return;
      }
      loadQueue();
    }
    if (session && session.token) loadQueue();
  </script>
</Base>
