---
const { title = 'Citizen Vault' } = Astro.props;
const apiUrl = import.meta.env.PUBLIC_API_URL ?? 'http://localhost:8080';
---
<html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><title>{title}</title><link rel="stylesheet" href="/styles.css"/></head><body><header><a href="/">Citizen Vault</a><nav><a href="/documents">Documents</a><a href="/grants">Grants</a><a href="/verify">Verify</a><a href="/governance">Governance</a><a href="/audit">Audit</a><span id="auth-nav"></span></nav></header><main><slot /></main><footer>Source: https://github.com/basicalex/polis · AGPL-3.0-or-later · v0.1.0-v1</footer><script define:vars={{ apiUrl }}>window.__API_URL=apiUrl;const s=sessionStorage.getItem('vault_session');const n=document.getElementById('auth-nav');if(n)n.innerHTML=s?'<a href="/documents">Documents</a> · <a href="#" onclick="sessionStorage.removeItem(\'vault_session\');location.reload()">Logout</a>':'<a href="/">Login</a>';</script></body></html>
