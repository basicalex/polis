# Polis isolated public-read pilot environment contract.
# Copy to .env.pilot, fill every required value, then chmod 600 .env.pilot.
# A filled file contains credentials and deployment secrets: never commit or share it.
# Empty values are intentional. The pilot Compose file fails closed until they are filled.

# Public TLS identity. DNS must resolve PILOT_HOSTNAME to the pilot host before deploy.
PILOT_HOSTNAME=
PILOT_ACME_EMAIL=

# PostgreSQL. DATABASE_URL must use the same explicit values and hostname `postgres`.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DATABASE_URL=

# Generate at least 32 random bytes, for example: openssl rand -base64 48
INTERNAL_API_TOKEN=

# Explicit comma-separated origins only; wildcard origins are rejected in pilot mode.
# Example shape: https://public-ui.example.org
CORS_ALLOWED_ORIGINS=

# First-party application image names and immutable build metadata.
# Repository shape example: registry.example.org/owner/polis (no trailing slash).
PILOT_IMAGE_REPOSITORY=
PILOT_IMAGE_TAG=
GIT_SHA=
BUILD_TIME=
SOURCE_URL=

# Off-host backup placeholders used by scripts/ops/backup.sh.
# Keep the restic password in a separate root-readable file, not in this env file.
BACKUP_ENABLED=
RESTIC_REPOSITORY=
RESTIC_PASSWORD_FILE=
RESTIC_CHECK_TIMEOUT_SECONDS=
RESTIC_KEEP_DAILY=
RESTIC_KEEP_WEEKLY=
RESTIC_KEEP_MONTHLY=

# Disposable restore-drill placeholders used by scripts/ops/restore-verify.sh.
RESTIC_SNAPSHOT=
SOURCE_DATABASE_URL=
PRODUCTION_DATABASE_URL=
RESTORE_TARGET_DATABASE_URL=
RESTORE_TARGET_IS_DISPOSABLE=
RESTORE_DRILL_CONFIRMATION=
