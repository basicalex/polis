# This BFF-only edge does not cover separately hosted Astro applications;
# they must set their own browser security policy.
{
	# Both variables are required deployment inputs; do not supply fallback identities.
	email {$PILOT_ACME_EMAIL}
	servers {
		timeouts {
			read_body 15s
			read_header 15s
			write 30s
			idle 5m
		}
	}
}

{$PILOT_HOSTNAME} {
	# Caddy's automatic HTTPS redirects HTTP to this HTTPS site.
	request_body {
		max_size 1MB
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Content-Security-Policy "frame-ancestors 'none'"
		Referrer-Policy "no-referrer"
		Permissions-Policy "accelerometer=(), camera=(), geolocation=(), microphone=(), payment=(), usb=()"
	}

	reverse_proxy platform-api:8080 {
		transport http {
			dial_timeout 5s
			read_timeout 30s
			write_timeout 30s
			response_header_timeout 30s
		}
	}
}
