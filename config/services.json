{
  "schemaVersion": 1,
  "services": [
    {
      "name": "platform-api",
      "path": "services/platform-api",
      "workspace": "@polis/platform-api",
      "runtime": "node-24",
      "defaultPort": 8080,
      "role": "Public BFF for governance, proof, assistant, citizen, signing, contribution, rewards, and complaint routes.",
      "healthRoute": "/readyz",
      "dev": {
        "launch": true,
        "order": 17
      },
      "devPortEnv": "PLATFORM_API_PORT",
      "internalUrlEnv": null
    },
    {
      "name": "governance-graph-api",
      "path": "services/governance-graph-api",
      "workspace": "@polis/governance-graph-api",
      "runtime": "node-24",
      "defaultPort": 8100,
      "role": "Postgres-backed civic graph and governance read API.",
      "healthRoute": "/readyz",
      "dev": {
        "launch": true,
        "order": 1
      },
      "devPortEnv": "GOVERNANCE_GRAPH_API_PORT",
      "internalUrlEnv": "GRAPH_INTERNAL_URL"
    },
    {
      "name": "polis-bridge-service",
      "path": "services/polis-bridge-service",
      "workspace": "@polis/polis-bridge-service",
      "runtime": "node-24",
      "defaultPort": 8200,
      "role": "Local Polis issue and conversation bridge with a provider seam.",
      "healthRoute": "/readyz",
      "dev": {
        "launch": true,
        "order": 3
      },
      "devPortEnv": "POLIS_BRIDGE_SERVICE_PORT",
      "internalUrlEnv": "POLIS_INTERNAL_URL"
    },
    {
      "name": "paperless-adapter",
      "path": "services/paperless-adapter",
      "workspace": "@polis/paperless-adapter",
      "runtime": "node-24",
      "defaultPort": 8300,
      "role": "Document intake and archive adapter for stub or Paperless backends.",
