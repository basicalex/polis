    {
      "name": "contribution-service",
      "path": "services/contribution-service",
      "workspace": "@polis/contribution-service",
      "runtime": "node-24",
      "defaultPort": 8450,
      "role": "Persists evidence-linked claims and review decisions.",
      "healthRoute": "/readyz",
      "dev": {
        "launch": true,
        "order": 14
      },
      "devPortEnv": "CONTRIBUTION_SERVICE_PORT",
      "internalUrlEnv": "CONTRIBUTION_INTERNAL_URL"
    },
    {
      "name": "rewards-service",
      "path": "services/rewards-service",
      "workspace": "@polis/rewards-service",
      "runtime": "node-24",
      "defaultPort": 8460,
      "role": "Runs the local civic rewards prototype.",
      "healthRoute": "/readyz",
      "dev": {
        "launch": true,
        "order": 13
      },
      "devPortEnv": "REWARDS_SERVICE_PORT",
      "internalUrlEnv": "REWARDS_INTERNAL_URL"
    },
    {
      "name": "canonicalization-service",
      "path": "services/canonicalization-service",
      "workspace": "@polis/canonicalization-service",
      "runtime": "node-24",
      "defaultPort": 8500,
      "role": "Creates deterministic SHA-256 document hash bundles.",
      "healthRoute": "/readyz",
      "dev": {
        "launch": true,
        "order": 5
      },
      "devPortEnv": "CANONICALIZATION_SERVICE_PORT",
      "internalUrlEnv": "CANONICALIZATION_INTERNAL_URL"
