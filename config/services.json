    {
      "name": "ai-gateway",
      "path": "services/ai-gateway",
      "workspace": null,
      "runtime": "python-3.12",
      "defaultPort": 8550,
      "role": "FastAPI grounded-RAG assistant with stub and OpenAI-compatible provider modes.",
      "healthRoute": "/readyz",
      "dev": {
        "launch": false,
        "order": null
      },
      "devPortEnv": null,
      "internalUrlEnv": "AI_INTERNAL_URL"
    },
    {
      "name": "audit-service",
      "path": "services/audit-service",
      "workspace": "@polis/audit-service",
      "runtime": "node-24",
      "defaultPort": 8600,
