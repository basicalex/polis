      "workspace": "@polis/vc-issuer-service",
      "runtime": "node-24",
      "defaultPort": 8950,
      "role": "Provides the verifiable credential issuer service shell.",
      "healthRoute": "/readyz",
      "dev": {
        "launch": true,
        "order": 12
      },
      "devPortEnv": "VC_ISSUER_SERVICE_PORT",
