      "dev": {
        "launch": true,
        "order": 4
      },
      "devPortEnv": "PAPERLESS_ADAPTER_PORT",
      "internalUrlEnv": "PAPERLESS_INTERNAL_URL"
    },
    {
      "name": "document-ingestion-gateway",
      "path": "services/document-ingestion-gateway",
      "workspace": "@polis/document-ingestion-gateway",
      "runtime": "node-24",
      "defaultPort": 8400,
      "role": "Orchestrates document intake, canonicalization, and proof registration.",
