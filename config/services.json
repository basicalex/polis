      "runtime": "node-24",
      "defaultPort": 8700,
      "role": "Stores proof manifests and serves verification, status, and issuer reads.",
      "healthRoute": "/readyz",
      "dev": {
        "launch": true,
        "order": 8
      },
      "devPortEnv": "PROOF_SERVICE_PORT",
      "internalUrlEnv": "PROOF_INTERNAL_URL"
    },
    {
      "name": "citizen-vault-service",
      "path": "services/citizen-vault-service",
      "workspace": "@polis/citizen-vault-service",
      "runtime": "node-24",
      "defaultPort": 8750,
      "role": "Provides the citizen document vault service shell.",
      "healthRoute": "/readyz",
      "dev": {
        "launch": true,
        "order": 11
      },
      "devPortEnv": "CITIZEN_VAULT_SERVICE_PORT",
      "internalUrlEnv": "VAULT_INTERNAL_URL"
