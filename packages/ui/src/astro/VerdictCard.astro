---
import TrustIcon, { type IconName } from '../icons/TrustIcon.astro';
import ProofTruthNote from './ProofTruthNote.astro';
import { t, type Locale, type MessageKey } from '../messages/index.ts';
import type { CheckStatus, VerdictTone, VerificationVerdict } from '@polis/domain';

interface Props {
  verdict: VerificationVerdict;
  proofHref?: string;
  locale?: Locale;
}

const { verdict, proofHref, locale = 'en' } = Astro.props as Props;

const toneIcons: Record<VerdictTone, IconName> = {
  valid: 'check',
  warning: 'alert',
  invalid: 'cross',
  unknown: 'question',
  restricted: 'lock',
};

const checkTone: Record<CheckStatus, VerdictTone> = {
  pass: 'valid',
  fail: 'invalid',
  indeterminate: 'warning',
  not_present: 'unknown',
  not_checked: 'unknown',
};
---

<article class="verdict-card" data-tone={verdict.tone}>
  <h2 class="verdict-headline">
    <span class="trust-badge" data-tone={verdict.tone} role="status">
      <TrustIcon name={toneIcons[verdict.tone]} />
      {t(verdict.headlineKey as MessageKey, locale)}
    </span>
  </h2>
  {verdict.explanationKeys.map((key) => <p>{t(key as MessageKey, locale)}</p>)}
  <ul class="check-list">
    {
      verdict.checks.map((check) => (
        <li class="check-row">
          <span class="trust-badge" data-tone={checkTone[check.status]}>
            <TrustIcon name={toneIcons[checkTone[check.status]]} />
            {t(`status.${check.status}` as MessageKey, locale)}
          </span>
          <span class="check-mechanism">{t(`mechanism.${check.mechanism}` as MessageKey, locale)}</span>
          <span>
            {t(check.labelKey as MessageKey, locale)}
            {check.detail && <span class="check-detail"> {check.detail}</span>}
          </span>
        </li>
      ))
    }
  </ul>
  {proofHref && <a href={proofHref}>{t('verifier.view_proof', locale)}</a>}
  <ProofTruthNote compact locale={locale} />
</article>
